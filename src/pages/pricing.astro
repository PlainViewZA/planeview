<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.pf-btn');
  const pricingStack = document.querySelector('.pricing-stack');
  const comboSection = document.querySelector<HTMLElement>('.combo-section');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const filter = btn.dataset.filter ?? 'all';

      // Handle pricing stack blocks
      document.querySelectorAll<HTMLElement>('.p-block').forEach(block => {
        if (filter === 'all' || block.dataset.section === filter) {
          block.style.display = '';
        } else {
          block.style.display = 'none';
        }
      });

      // Handle combo section
      if (comboSection) {
        comboSection.style.display = (filter === 'all' || filter === 'combo') ? '' : 'none';
      }

      // Hide stack border when only combo is shown
      if (pricingStack instanceof HTMLElement) {
        pricingStack.style.display = filter === 'combo' ? 'none' : '';
      }
    });
  });
</script>