---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import PostGrid from '../../components/insights/PostGrid.astro';

const posts = await getCollection('insights');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalPosts = posts.length;
---

<MainLayout
  title="Insights | Plane View Collective"
  description="A showcase of campaigns, content pieces, and marketing insights from Plane View Collective."
>
  <div class="insights-page">

    <div class="insights-container">

      <!-- Top bar -->
      <nav class="topbar" aria-label="Page navigation">
        <a href="/" class="back-btn" aria-label="Back to home">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M9 2L4 7L9 12" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Back to home</span>
        </a>
        <span class="archive-label" aria-hidden="true">Insights archive</span>
      </nav>

      <!-- Hero -->
      <header class="hero">
        <p class="kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          Plane View Collective
        </p>

        <h1>
          Campaigns, content,<br />
          and strategic thinking.
        </h1>

        <p class="intro">
          Selected creative and marketing work from Plane View Collective —
          structured as campaign case studies, not just social posts.
        </p>

        <div class="meta-strip" role="list" aria-label="Insight categories">
          <span role="listitem">{totalPosts} Case {totalPosts === 1 ? 'Study' : 'Studies'}</span>
          <span class="strip-div" aria-hidden="true"></span>
          <span role="listitem">Social Campaigns</span>
          <span class="strip-div" aria-hidden="true"></span>
          <span role="listitem">Brand Strategy</span>
          <span class="strip-div" aria-hidden="true"></span>
          <span role="listitem">Digital Content</span>
        </div>
      </header>

      <!-- Section label -->
      <div class="section-label" aria-hidden="true">
        <span class="section-label-text">Selected case studies</span>
        <span class="section-label-line"></span>
      </div>

      <!-- Grid -->
      <PostGrid posts={posts} />

    </div>

    <!-- Ambient glow — purely decorative -->
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>

  </div>
</MainLayout>

<style>
  /* ── Tokens ── */
  :root {
    --c-bg:        #080808;
    --c-surface:   #111111;
    --c-ink:       #f5f5f0;
    --c-ink-soft:  #b8b8b0;
    --c-ink-muted: rgba(245,245,240,0.38);
    --c-border:    rgba(255,255,255,0.08);
    --c-orange:    #f97316;
    --c-oglow:     rgba(249,115,22,0.18);
    --ease:        cubic-bezier(0.22,1,0.36,1);
    --dur:         0.26s;
    --radius:      1.5rem;
  }

  /* ── Shell ── */
  .insights-page {
    position: relative;
    background: var(--c-bg);
    min-height: 100vh;
    overflow-x: hidden;
    color: var(--c-ink);
  }

  .insights-container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem 8rem;
  }

  /* ── Glows ── */
  .glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(110px);
    z-index: 0;
  }

  .glow-a {
    width: 55vw; height: 55vw;
    max-width: 700px; max-height: 700px;
    top: -12%; left: -12%;
    background: radial-gradient(circle, rgba(249,115,22,0.09) 0%, transparent 70%);
  }

  .glow-b {
    width: 40vw; height: 40vw;
    max-width: 500px; max-height: 500px;
    top: 4%; right: -10%;
    background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%);
  }

  /* ── Top bar ── */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    margin-bottom: 5rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem 0.55rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--c-border);
    background: rgba(255,255,255,0.04);
    color: var(--c-ink-soft);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
    transition: background var(--dur) var(--ease),
                color var(--dur) var(--ease),
                border-color var(--dur) var(--ease),
                transform var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease);
  }

  .back-btn:hover {
    background: var(--c-orange);
    color: #fff;
    border-color: var(--c-orange);
    transform: translateX(-2px);
    box-shadow: 0 8px 28px var(--c-oglow);
  }

  .back-btn svg { transition: transform var(--dur) var(--ease); }
  .back-btn:hover svg { transform: translateX(-2px); }

  .archive-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }

  /* ── Hero ── */
  .hero {
    max-width: 900px;
    margin-bottom: 4.5rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-orange);
  }

  .kicker-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--c-orange);
    box-shadow: 0 0 10px var(--c-orange);
    flex-shrink: 0;
  }

  .hero h1 {
    font-size: clamp(2.8rem, 5.8vw, 6rem);
    line-height: 0.93;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--c-ink);
    margin: 0 0 1.75rem;
  }

  .intro {
    max-width: 580px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--c-ink-soft);
    margin: 0 0 2.5rem;
  }

  /* ── Meta strip ── */
  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }

  .meta-strip span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  .strip-div {
    width: 1px; height: 1rem;
    background: var(--c-border);
    flex-shrink: 0;
  }

  /* ── Section label ── */
  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-label-text {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .section-label-line {
    height: 1px;
    flex: 1;
    background: linear-gradient(to right, var(--c-border), transparent);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .insights-container { padding: 0 1.25rem 6rem; }

    .topbar {
      padding-top: 1.75rem;
      margin-bottom: 3.5rem;
    }

    .archive-label { display: none; }

    .hero { margin-bottom: 3.5rem; }

    .hero h1 {
      font-size: clamp(2.5rem, 12vw, 3.8rem);
      line-height: 0.95;
    }

    .intro { font-size: 0.97rem; }

    .strip-div { display: none; }

    .meta-strip { gap: 0.5rem; }
  }

  @media (max-width: 480px) {
    .topbar { margin-bottom: 2.75rem; }
  }
</style>