---
import MainLayout from '../../layouts/MainLayout.astro';
import Navigation from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// ============================================================
//  EDIT THIS SECTION ONLY — everything else stays the same
// ============================================================

const project = {
  metaTitle: "Unexpected Opportunities Case Study | Plane View Collective",
  metaDescription: "How we built a complete digital presence for a Cape Town community movement — brand identity, website design, and content strategy.",

  tags: ["Web Design", "Branding", "Content Strategy"],
  title: "Unexpected Opportunities",
  tagline: "Building a digital home for a Cape Town community movement built on dignity, care, and showing up — brand identity, website, and content strategy from the ground up.",

  client: "Unexpected Opportunities",
  industry: "Non-Profit / Community",
  location: "Cape Town, SA",
  services: ["Brand Identity", "Website Design", "Content Strategy"],
  year: "2026",

  heroImage: "/UnexpectedOpportunities/up.webp",
  heroImageAlt: "Unexpected Opportunities website mockup",

  challengeHeading: "A movement with heart but no digital home",
  challenge: [
    "Unexpected Opportunities had been showing up for their community long before they had a website. Food support, youth mentorship, community storytelling — the work was real, the care was genuine, and the trust had been earned on the ground. But none of that was visible online. There was no digital presence that could carry the warmth of the mission, explain the programs clearly, or give donors and volunteers a way to find and trust them.",
    "The risk wasn't just invisibility — it was that a generic charity website would flatten everything that made this movement different. They didn't need a polished donor funnel. They needed something that felt like them: human, honest, and close to the people they serve.",
  ],

  approachHeading: "Dignity first. Design second.",
  approach: [
    "We started by listening — which felt right for a client whose entire philosophy is built on listening first. The brand had to communicate warmth and trust before anything else. That meant the visual identity needed to feel grounded, not corporate; the typography had to be readable and calm; and the copy had to sound like a neighbour, not a press release.",
    "The website was structured around three questions a first-time visitor would ask: What do you do? Why should I trust you? How do I get involved? Every section — from the mission statement to the program pages to the stories — was written and designed to answer those questions in the order someone would actually ask them.",
    "We treated the Stories section as a core product of the site, not an afterthought — because for a movement like this, lived experience is the evidence.",
  ],

  deliverables: [
    {
      number: "01",
      service: "Brand Identity",
      heading: "A visual identity built around warmth and trust",
      description: "We developed a brand system that balanced warmth with credibility — grounded tones, clean typography, and a mark that felt human without being naive. The identity was designed to work across digital, print, and social from day one.",
    },
    {
      number: "02",
      service: "Website Design & Build",
      heading: "A site that invites people in, clearly and quickly",
      description: "The website was built to explain the mission, showcase the programs, and give people a clear path to donate or get involved. Clean layout, strong visual hierarchy, and a Stories section treated as a first-class feature — because real stories are the most powerful trust signal a community organisation has.",
    },
    {
      number: "03",
      service: "Content Strategy",
      heading: "Storytelling as a strategic asset",
      description: "Every page was written to feel close rather than distant. The stories framework was built so the team could add and publish new community stories without needing a developer — keeping the content engine running long after launch.",
    },
  ],

  resultHeading: "A community movement, now visible",
  result: [
    "Unexpected Opportunities now has a digital presence that carries the same warmth and honesty as the work they do on the ground. A donor landing on the site for the first time understands the mission within seconds and has a clear, frictionless path to contribute.",
    "The site gave the team more than a website — it gave them a frame for how to talk about their work consistently, a content engine in the Stories section, and a brand they can grow into as the movement expands.",
  ],
  stats: [
    { figure: "3",   label: "Core programs clearly communicated for the first time" },
    { figure: "15+", label: "Local partnerships supported by the new digital presence" },
    { figure: "0→1", label: "From no brand identity to a complete movement presence" },
  ],

  quote: "Plane View understood immediately that we didn't want something that looked like a charity. They built something that feels like us — honest, warm, and built for the people we serve.",
  quoteAuthor: "Unexpected Opportunities",
};
// ============================================================
---

<MainLayout title={project.metaTitle} description={project.metaDescription}>
  <Navigation />

  <!-- ═══════════════════════════════════════════
       1. HERO — Case Study Intro
  ═══════════════════════════════════════════ -->
  <section class="cs-hero">
    <div class="container">

      <div class="cs-hero-inner">
        <div class="cs-hero-left">
          <div class="cs-tags">
            {project.tags.map((tag) => (
              <span class="cs-tag">{tag}</span>
            ))}
          </div>
          <h1 class="cs-hero-title">{project.title}</h1>
          <p class="cs-hero-tagline">{project.tagline}</p>
        </div>

        <div class="cs-hero-meta">
          <div class="meta-item">
            <span class="meta-label">Client</span>
            <span class="meta-value">{project.client}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Industry</span>
            <span class="meta-value">{project.industry}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">{project.location}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Services</span>
            {project.services.map((s) => (
              <span class="meta-value">{s}</span>
            ))}
          </div>
          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{project.year}</span>
          </div>
        </div>
      </div>

      <!-- Hero cover -->
      <div class="cs-hero-cover">
        {project.heroImage ? (
          <img src={project.heroImage} alt={project.heroImageAlt} />
        ) : (
          <div class="cover-placeholder" aria-label={project.heroImageAlt}>
            <span class="cover-hint">Hero Image — {project.client}</span>
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       2. BRAND IDENTITY
  ═══════════════════════════════════════════ -->
  <section class="brand-section">

    <div class="container">
      <div class="section-label-block">
        <span class="eyebrow">Brand Identity</span>
        <h2 class="section-heading">The {project.client} Identity</h2>
        <p class="section-subheading">A visual system built on warmth, trust, and community dignity.</p>
      </div>
    </div>

    <!-- Brand Board -->
    <div class="brand-board">
      <div class="brand-board-left">
        <div class="logo-on-light">
          <div class="logo-placeholder">
            <div class="logo-icon-placeholder">UO</div>
            <span class="logo-wordmark">UNEXPECTED<br>OPPORTUNITIES</span>
          </div>
          <span class="logo-variant-label">Primary — Light Background</span>
        </div>
        <div class="logo-on-dark">
          <div class="logo-placeholder">
            <div class="logo-icon-placeholder reversed">UO</div>
            <span class="logo-wordmark reversed">UNEXPECTED<br>OPPORTUNITIES</span>
          </div>
          <span class="logo-variant-label light">Primary — Dark Background</span>
        </div>
        <div class="logo-on-brand">
          <div class="logo-placeholder">
            <div class="logo-icon-placeholder brand">UO</div>
            <span class="logo-wordmark brand">UNEXPECTED<br>OPPORTUNITIES</span>
          </div>
          <span class="logo-variant-label light">Primary — Brand Colour</span>
        </div>
      </div>

      <div class="brand-board-right">
        <!-- Brand colours from guide: White, Dim Grey, Black, Carrot Orange, Sandy Brown -->
        <div class="colour-column" style="background:#ffffff;">
          <div class="colour-info dark">
            <span class="colour-name">White</span>
            <span class="colour-hex">#ffffff</span>
            <span class="colour-role">Background</span>
          </div>
        </div>
        <div class="colour-column" style="background:#696969;">
          <div class="colour-info light">
            <span class="colour-name">Dim Grey</span>
            <span class="colour-hex">#696969</span>
            <span class="colour-role">Body Text</span>
          </div>
        </div>
        <div class="colour-column" style="background:#1a1a1a;">
          <div class="colour-info light">
            <span class="colour-name">Black</span>
            <span class="colour-hex">#1a1a1a</span>
            <span class="colour-role">Primary</span>
          </div>
        </div>
        <div class="colour-column" style="background:#e9732a;">
          <div class="colour-info light">
            <span class="colour-name">Carrot Orange</span>
            <span class="colour-hex">#e9732a</span>
            <span class="colour-role">Accent</span>
          </div>
        </div>
        <div class="colour-column" style="background:#f4a460;">
          <div class="colour-info dark">
            <span class="colour-name">Sandy Brown</span>
            <span class="colour-hex">#f4a460</span>
            <span class="colour-role">Secondary</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Typography Strip -->
    <div class="type-strip">
      <div class="container">
        <div class="type-grid">

          <div class="type-block">
            <span class="type-label">Display — Myanmar</span>
            <div class="type-specimen-display">Aa</div>
            <div class="type-weights">
              <span style="font-weight:400;">Regular</span>
              <span style="font-weight:700;">Bold</span>
            </div>
            <p class="type-usage">Used for headlines, pull quotes, and all display text.</p>
          </div>

          <div class="type-divider"></div>

          <div class="type-block">
            <span class="type-label">Body — Bahnschrift</span>
            <div class="type-specimen-body">Aa</div>
            <div class="type-weights">
              <span style="font-weight:400;">Regular</span>
              <span style="font-weight:600;">SemiBold</span>
            </div>
            <p class="type-usage">Used for body copy, captions, and UI labels.</p>
          </div>

          <div class="type-divider"></div>

          <div class="type-block">
            <span class="type-label">In Use</span>
            <p class="specimen-headline">Showing up for community.</p>
            <p class="specimen-body">Serving Cape Town's most vulnerable residents through food support, youth mentorship, and community storytelling — because dignity is not a privilege.</p>
          </div>

        </div>
      </div>
    </div>

    <!-- Brand Values -->
    <div class="brand-values-strip">
      <div class="container">
        <div class="values-grid">
          <div class="value-pill">Human</div>
          <div class="value-pill">Grounded</div>
          <div class="value-pill">Warm</div>
          <div class="value-pill">Community-first</div>
          <div class="value-pill">Honest</div>
          <div class="value-pill accent">Dignity &amp; Care</div>
          <div class="value-pill accent">Radical Welcome</div>
          <div class="value-pill accent">Lived Experience</div>
        </div>
      </div>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════
       3. MOCKUPS — Visual Application
  ═══════════════════════════════════════════ -->
  <section class="mockups-section">
    <div class="container">

      <div class="section-label-block">
        <span class="eyebrow">Application</span>
        <h2 class="section-heading">The Work in Context</h2>
        <p class="section-subheading">Brand applied across digital and community touchpoints.</p>
      </div>

      <!-- Feature desktop -->
      <div class="mockup-feature">
        <div class="mockup-frame mockup-frame--desktop">
          <div class="mockup-browser-bar">
            <div class="browser-dots"><span></span><span></span><span></span></div>
            <div class="browser-url">unexpectedopportunities.netlify.app</div>
          </div>
          <div class="mockup-screen">
               <img src="/UnexpectedOpportunities/up.webp" alt="Homepage" />
          </div>
        </div>
        <p class="mockup-caption">Homepage Design</p>
      </div>

    <!-- Three-col collateral -->
<div class="mockup-grid mockup-grid--3col">

  <div class="mockup-item">
    <div class="mockup-frame mockup-frame--card">
      <img src="/UnexpectedOpportunities/Business_Card.png" alt="Business Card" class="card-image" />
    </div>
    <p class="mockup-caption">Business Card</p>
  </div>

  <div class="mockup-item">
    <div class="mockup-frame mockup-frame--card">
      <img src="/UnexpectedOpportunities/socialmedia.webp" alt="Social Media Post" class="card-image" />
    </div>
    <p class="mockup-caption">Social Media</p>
  </div>

  <div class="mockup-item">
    <div class="mockup-frame mockup-frame--card">
      <img src="/UnexpectedOpportunities/socialmedia02.webp" alt="Social Media Post" class="card-image" />
    </div>
    <p class="mockup-caption">Social Media</p>
  </div>

</div>


    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       4. CASE STUDY — The Story
  ═══════════════════════════════════════════ -->
  <section class="story-section">
    <div class="container story-container">

      <nav class="story-sidenav" aria-label="Case study navigation">
        <a href="#challenge" class="cs-nav-link">Challenge</a>
        <a href="#approach"  class="cs-nav-link">Approach</a>
        <a href="#execution" class="cs-nav-link">Execution</a>
        <a href="#result"    class="cs-nav-link">Result</a>
      </nav>

      <div class="story-body">

        <!-- Challenge -->
        <article id="challenge" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">01</span>
            <span class="chapter-title">The Challenge</span>
          </div>
          <h3 class="chapter-heading">{project.challengeHeading}</h3>
          <div class="chapter-content">
            {project.challenge.map((para) => <p>{para}</p>)}
          </div>
        </article>

        <!-- Approach -->
        <article id="approach" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">02</span>
            <span class="chapter-title">The Approach</span>
          </div>
          <h3 class="chapter-heading">{project.approachHeading}</h3>
          <div class="chapter-content">
            {project.approach.map((para) => <p>{para}</p>)}
            <div class="approach-pillars">
              <div class="pillar">
                <span class="pillar-label">Brand Direction</span>
                <p>Warmth without naivety. Grounded in the community it serves, never corporate or distant.</p>
              </div>
              <div class="pillar">
                <span class="pillar-label">Content Strategy</span>
                <p>Stories as evidence. Lived experience treated as the most powerful trust signal the organisation has.</p>
              </div>
              <div class="pillar">
                <span class="pillar-label">Digital Strategy</span>
                <p>Answer three questions in order: What do you do? Why trust you? How do I get involved?</p>
              </div>
            </div>
          </div>
        </article>

        <!-- Execution -->
        <article id="execution" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">03</span>
            <span class="chapter-title">The Execution</span>
          </div>
          <h3 class="chapter-heading">
            Built to feel like them.<br>Every touchpoint considered.
          </h3>
          <div class="chapter-content">
            <p>
              We delivered a complete brand system and digital presence in a single focused engagement — identity, digital, and collateral working together so the movement has a coherent voice wherever it shows up.
            </p>
            <div class="execution-deliverables">
              {project.deliverables.map((d) => (
                <div class="deliverable-row">
                  <div class="deliverable-icon">—</div>
                  <div class="deliverable-detail">
                    <span class="deliverable-name">{d.number} — {d.service}</span>
                    <span class="deliverable-heading">{d.heading}</span>
                    <p>{d.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>

        <!-- Result -->
        <article id="result" class="story-chapter story-chapter--last">
          <div class="chapter-marker">
            <span class="chapter-number">04</span>
            <span class="chapter-title">The Result</span>
          </div>
          <h3 class="chapter-heading">{project.resultHeading}</h3>
          <div class="chapter-content">
            {project.result.map((para) => <p>{para}</p>)}
          </div>

          <div class="result-stats">
            {project.stats.map((s) => (
              <div class="stat-card">
                <span class="stat-figure">{s.figure}</span>
                <span class="stat-desc">{s.label}</span>
              </div>
            ))}
          </div>

          {project.quote && (
            <blockquote class="story-quote">
              <p class="story-quote-text">"{project.quote}"</p>
              <footer>
                <span class="story-quote-author">— {project.quoteAuthor}</span>
              </footer>
            </blockquote>
          )}

        </article>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       5. NEXT PROJECT CTA
  ═══════════════════════════════════════════ -->
  <section class="next-project">
    <div class="container">
      <div class="next-project-inner">
        <span class="eyebrow">Next Project</span>
        <a href="/work/chemcrete" class="next-project-link">
          <span class="next-project-name">Chemcrete</span>
          <span class="next-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  /* ── Shared Utilities ── */
  /*
    Brand colours (from brand guide):
    #ffffff   White        — Background
    #696969   Dim Grey     — Body text
    #1a1a1a   Black        — Primary / headings
    #e9732a   Carrot Orange — Accent
    #f4a460   Sandy Brown  — Secondary warm
  */

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    display: inline-block;
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #e9732a;
    margin-bottom: 0.75rem;
  }

  .section-label-block {
    max-width: 640px;
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }

  .section-subheading {
    font-family: 'Open Sans', sans-serif;
    font-size: 1.0625rem;
    color: #696969;
    margin: 0;
    line-height: 1.6;
  }

  /* ════════════════════════════════════════
     1. HERO
  ════════════════════════════════════════ */
  .cs-hero {
    background: #f2ede6;
    padding: 7rem 0 0;
    overflow: hidden;
  }

  .cs-hero-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
    padding-bottom: 4rem;
  }

  .cs-hero-left { display: flex; flex-direction: column; }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1.25rem;
  }

  .cs-tag {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 14px;
    border-radius: 9999px;
    border: 1.5px solid rgba(233, 115, 42, 0.4);
    color: #e9732a;
  }

  .cs-hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    line-height: 0.95;
    margin: 0.5rem 0 1.5rem;
  }

  .cs-hero-tagline {
    font-family: 'Open Sans', sans-serif;
    font-size: 1.125rem;
    color: #696969;
    line-height: 1.7;
    max-width: 480px;
    margin: 0;
  }

  .cs-hero-meta {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 1.25rem;
    border: none;
    padding-left: 2.5rem;
  }

  .meta-item { display: flex; flex-direction: column; gap: 0.375rem; }

  .meta-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e9732a;
  }

  .meta-value {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.9375rem;
    color: #1a1a1a;
    font-weight: 500;
    line-height: 1.5;
  }

  /* Hero cover — no fixed aspect ratio, wraps the image naturally */
  .cs-hero-cover {
    width: 100%;
    overflow: hidden;
    border: none;
  }

  .cs-hero-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Clean placeholder — no decorative chrome */
  .cover-placeholder {
    width: 100%;
    min-height: 360px;
    background: #e8e3db;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cover-hint {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.25);
  }

  /* ════════════════════════════════════════
     2. BRAND IDENTITY
  ════════════════════════════════════════ */
  .brand-section {
    background: #f9f8f5;
    padding: 6rem 0 0;
    overflow: hidden;
  }

  .brand-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 480px;
    border: none;
    margin-top: 1rem;
  }

  .brand-board-left {
    display: grid;
    grid-template-rows: 1fr 1fr 1fr;
    border: none;
  }

  .logo-on-light,
  .logo-on-dark,
  .logo-on-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2.5rem;
    border: none;
  }

  .logo-on-light { background: #ffffff; }
  .logo-on-dark  { background: #1a1a1a; }
  .logo-on-brand { background: #e9732a; }

  .logo-placeholder { display: flex; align-items: center; gap: 0.75rem; }

  .logo-icon-placeholder {
    width: 52px;
    height: 52px;
    border: 2px solid #1a1a1a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    flex-shrink: 0;
  }

  .logo-icon-placeholder.reversed { border-color: #ffffff; color: #ffffff; }
  .logo-icon-placeholder.brand    { border-color: #ffffff; color: #ffffff; }

  .logo-wordmark {
    font-family: 'Playfair Display', serif;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .logo-wordmark.reversed { color: #ffffff; }
  .logo-wordmark.brand    { color: #ffffff; }

  .logo-variant-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #696969;
  }

  .logo-variant-label.light { color: rgba(255,255,255,0.5); }

  .brand-board-right { display: grid; grid-template-columns: repeat(5, 1fr); }

  .colour-column {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem 1rem;
    min-height: 480px;
    border: none;
  }

  .colour-info { display: flex; flex-direction: column; gap: 3px; }

  .colour-name { font-family: 'Playfair Display', serif; font-size: 0.8125rem; font-weight: 700; line-height: 1.2; }
