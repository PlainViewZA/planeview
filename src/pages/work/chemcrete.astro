---
import MainLayout from '../../layouts/MainLayout.astro';

// ============================================================
//  EDIT THIS SECTION ONLY — everything else stays the same
// ============================================================

const project = {
  metaTitle: "Chemcrete Case Study | Plane View Collective",
  metaDescription:
    "How we built a complete digital presence for a 35 year old Cape Town concrete specialist through brand identity, website design, and digital strategy.",

  tags: ["Web Design", "Branding", "Digital Strategy"],
  title: "Chemcrete",
  tagline:
    "Creating a strong digital foundation for a 35 year old concrete specialist through a complete brand identity, website, and clear market positioning.",

  client: "Chemcrete",
  industry: "Construction & Civil Engineering",
  location: "Cape Town, South Africa",
  services: ["Brand Identity", "Website Design", "Digital Strategy"],
  year: "2024",

  heroImage: "/chemcrete/Section.webp",
  heroImageAlt: "Chemcrete website mockup",

  challengeHeading: "A 35-year legacy, invisible online.",
  challenge: [
    "Chemcrete has been supplying the Cape Town construction and civil engineering industry with SABS compliant concrete products for over three decades. Their reputation on site is solid and trusted across the Western Cape, but online they were completely invisible.",
    "They had no website, no clear brand, and no way for potential clients to verify who they were or what they offered. In an industry built on trust and credibility, this was holding them back more than they realised.",
  ],

  approachHeading: "Industrial strength. Refined presentation.",
  approach: [
    "We started by understanding the business from the inside out. Through conversations with the team and key stakeholders, we explored how Chemcrete sees itself and how clients describe it. Two qualities stood out immediately: reliability and simplicity.",
    "Instead of changing who they are, the goal was to express it properly for the first time. The visual direction took inspiration from industrial environments, using honest materials, strong structure, and confident typography while avoiding the usual construction clichés.",
    "The website was designed to help contractors and engineers quickly understand the product range, trust the business, and take action without friction.",
  ],

  deliverables: [
    {
      number: "01",
      service: "Brand Identity",
      heading: "A visual identity built on strength and trust",
      description:
        "We created a brand system that feels established and dependable. This included a logo suite, colour palette, typography, and clear brand guidelines designed to communicate confidence and credibility.",
    },
    {
      number: "02",
      service: "Website Design & Build",
      heading: "A site built for credibility and product clarity",
      description:
        "The site was built to make it easy for contractors and engineers to explore products, confirm the company’s legitimacy, and get in touch without hesitation.",
    },
    {
      number: "03",
      service: "Collateral & Application",
      heading: "A brand that carries across every touchpoint",
      description:
        "We extended the identity across both physical and digital touchpoints, including business cards, signage, and branded materials to ensure consistency in every interaction.",
    },
  ],

  resultHeading: "A 35-year business, finally positioned to grow.",
  result: [
    "Chemcrete now has a digital presence that finally reflects the quality and experience they have built over 35 years. Potential clients can easily find them, understand what they offer, and reach out within moments.",
    "The new identity sets them apart clearly from competitors. The deep red colour palette and strong typography communicate authority and experience without needing to say it directly.",
  ],

  stats: [
    { figure: "35+", label: "Years of expertise, now properly represented" },
    { figure: "0→1", label: "From no digital presence to a complete brand system" },
    { figure: "Full", label: "End-to-end: identity, digital, collateral" },
  ],

  quote:
    "Contractors were Googling competitors and making decisions before they ever picked up the phone.",
  quoteAuthor: "Project Insight",
};
// ============================================================
---

<MainLayout title={project.metaTitle} description={project.metaDescription}>
  <!-- ═══════════════════════════════════════════
       1. HERO — Case Study Intro
  ═══════════════════════════════════════════ -->
  <section class="cs-hero">
    <div class="container">
      <div class="cs-hero-inner">
        <div class="cs-hero-left">
          <div class="cs-tags">
            {project.tags.map((tag) => (
              <span class="cs-tag">{tag}</span>
            ))}
          </div>

          <p class="cs-kicker">Case Study</p>
          <h1 class="cs-hero-title">{project.title}</h1>
          <p class="cs-hero-tagline">{project.tagline}</p>
        </div>

        <aside class="cs-hero-meta" aria-label="Project details">
          <div class="meta-item">
            <span class="meta-label">Client</span>
            <span class="meta-value">{project.client}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Industry</span>
            <span class="meta-value">{project.industry}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">{project.location}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Services</span>
            <span class="meta-value">{project.services.join(" / ")}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{project.year}</span>
          </div>
        </aside>
      </div>

      <div class="cs-hero-cover">
        {project.heroImage ? (
          <img
            src={project.heroImage}
            alt={project.heroImageAlt}
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="cover-placeholder" aria-label={project.heroImageAlt}>
            <span class="cover-hint">Hero Image — {project.client}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       2. BRAND IDENTITY — Logo · Colour · Type
  ═══════════════════════════════════════════ -->
  <section class="brand-section">
    <div class="container">
      <div class="section-label-block">
        <span class="eyebrow">Brand Identity</span>
        <h2 class="section-heading">The Chemcrete Identity</h2>
        <p class="section-subheading">
          A visual system built on industrial strength and material honesty.
        </p>
      </div>
    </div>

    <div class="brand-board">
      <div class="brand-board-left">
        <div class="logo-on-light">
          <div class="logo-placeholder logo-primary">
            <div class="logo-mark">
              <div class="logo-icon-placeholder">C</div>
            </div>
            <span class="logo-wordmark">CHEMCRETE</span>
          </div>
          <span class="logo-variant-label">Primary — Light Background</span>
        </div>

        <div class="logo-on-dark">
          <div class="logo-placeholder logo-reversed">
            <div class="logo-mark">
              <div class="logo-icon-placeholder reversed">C</div>
            </div>
            <span class="logo-wordmark reversed">CHEMCRETE</span>
          </div>
          <span class="logo-variant-label light">Primary — Dark Background</span>
        </div>

        <div class="logo-on-brand">
          <div class="logo-placeholder logo-brand">
            <div class="logo-mark">
              <div class="logo-icon-placeholder brand">C</div>
            </div>
            <span class="logo-wordmark brand">CHEMCRETE</span>
          </div>
          <span class="logo-variant-label light">Primary — Brand Colour</span>
        </div>
      </div>

      <div class="brand-board-right">
        <div class="colour-column" style="background:#ffffff; border: 1px solid #e0dbd1;">
          <div class="colour-info dark">
            <span class="colour-name">White</span>
            <span class="colour-hex">#ffffff</span>
            <span class="colour-role">Background</span>
          </div>
        </div>

        <div class="colour-column" style="background:#e3ddd3;">
          <div class="colour-info dark">
            <span class="colour-name">Aesthetic White</span>
            <span class="colour-hex">#e3ddd3</span>
            <span class="colour-role">Secondary BG</span>
          </div>
        </div>

        <div class="colour-column" style="background:#636363;">
          <div class="colour-info light">
            <span class="colour-name">Granite Gray</span>
            <span class="colour-hex">#636363</span>
            <span class="colour-role">Body Text</span>
          </div>
        </div>

        <div class="colour-column" style="background:#7c0000;">
          <div class="colour-info light">
            <span class="colour-name">Dark Red</span>
            <span class="colour-hex">#7c0000</span>
            <span class="colour-role">Secondary</span>
          </div>
        </div>

        <div class="colour-column" style="background:#480000;">
          <div class="colour-info light">
            <span class="colour-name">Oxblood</span>
            <span class="colour-hex">#480000</span>
            <span class="colour-role">Primary</span>
          </div>
        </div>
      </div>
    </div>

    <div class="type-strip">
      <div class="container">
        <div class="type-grid">
          <div class="type-block type-display">
            <span class="type-label">Display — Oswald</span>
            <div class="type-specimen-display">Aa</div>

            <div class="type-weights">
              <span style="font-family:'Oswald',sans-serif; font-weight:400;">Regular</span>
              <span style="font-family:'Oswald',sans-serif; font-weight:600;">SemiBold</span>
              <span style="font-family:'Oswald',sans-serif; font-weight:700;">Bold</span>
            </div>

            <p class="type-usage">
              Used for headlines, section titles, and all display text.
            </p>
          </div>

          <div class="type-divider" aria-hidden="true"></div>

          <div class="type-block type-body">
            <span class="type-label">Body — Open Sans</span>
            <div class="type-specimen-body">Aa</div>

            <div class="type-weights">
              <span style="font-family:'Open Sans',sans-serif; font-weight:400;">Regular</span>
              <span style="font-family:'Open Sans',sans-serif; font-weight:500;">Medium</span>
              <span style="font-family:'Open Sans',sans-serif; font-weight:600;">SemiBold</span>
            </div>

            <p class="type-usage">
              Used for body copy, descriptions, and UI labels.
            </p>
          </div>

          <div class="type-divider" aria-hidden="true"></div>

          <div class="type-block type-specimen-live">
            <span class="type-label">In Use</span>
            <p class="specimen-headline">Top of the range concrete products.</p>
            <p class="specimen-body">
              Serving the construction and civil industries across South Africa
              with SABS-compliant materials and a focus on quality, affordability,
              and customer satisfaction.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="brand-values-strip">
      <div class="container">
        <div class="values-grid">
          <div class="value-pill">Industrial</div>
          <div class="value-pill">Robust</div>
          <div class="value-pill">Functional</div>
          <div class="value-pill">Established</div>
          <div class="value-pill">Material-focused</div>
          <div class="value-pill accent">Integrity &amp; Honesty</div>
          <div class="value-pill accent">Quality Excellence</div>
          <div class="value-pill accent">Customer Satisfaction</div>
        </div>
      </div>
    </div>
  </section>

<!-- ═══════════════════════════════════════════
     3. PREMIUM VISUAL SHOWCASE — Supporting Applications
     Desktop cleaned into equal cards.
═══════════════════════════════════════════ -->
<section class="visual-showcase" aria-labelledby="showcase-title">
  <div class="container">
    <div class="section-label-block showcase-header">
      <span class="eyebrow">Application</span>
      <h2 id="showcase-title" class="section-heading">The Work in Context</h2>
      <p class="section-subheading">
        Brand applied across physical and digital touchpoints with a cleaner,
        more editorial presentation.
      </p>
    </div>

    <div class="showcase-grid showcase-grid--balanced">
      <figure class="showcase-item">
        <div class="media-frame">
          <img
            src="/chemcrete/card.webp"
            alt="Chemcrete business card design"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="showcase-caption">Business Card</figcaption>
      </figure>

      <figure class="showcase-item">
        <div class="media-frame">
          <img
            src="/chemcrete/chemcretesocialmedia.webp"
            alt="Chemcrete social media graphics"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="showcase-caption">Social Media</figcaption>
      </figure>

      <figure class="showcase-item">
        <div class="media-frame">
          <img
            src="/chemcrete/signage.webp"
            alt="Chemcrete construction site signage"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="showcase-caption">Construction Signage</figcaption>
      </figure>
    </div>
  </div>
</section>
  <!-- ═══════════════════════════════════════════
       4. CASE STUDY — The Story
  ═══════════════════════════════════════════ -->
  <section class="story-section">
    <div class="container story-container">
      <nav class="story-sidenav" aria-label="Case study navigation">
        <a href="#challenge" class="cs-nav-link">Challenge</a>
        <a href="#approach" class="cs-nav-link">Approach</a>
        <a href="#execution" class="cs-nav-link">Execution</a>
        <a href="#result" class="cs-nav-link">Result</a>
      </nav>

      <div class="story-body">
        <article id="challenge" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">01</span>
            <span class="chapter-title">The Challenge</span>
          </div>

          <h3 class="chapter-heading">{project.challengeHeading}</h3>

          <div class="chapter-content">
            {project.challenge.map((para) => <p>{para}</p>)}
          </div>
        </article>

        <article id="approach" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">02</span>
            <span class="chapter-title">The Approach</span>
          </div>

          <h3 class="chapter-heading">{project.approachHeading}</h3>

          <div class="chapter-content">
            {project.approach.map((para) => <p>{para}</p>)}

            <div class="approach-pillars">
              <div class="pillar">
                <span class="pillar-label">Brand Direction</span>
                <p>
                  Honest and industrial. Strong, but still approachable. Built to
                  last, not just to follow trends.
                </p>
              </div>

              <div class="pillar">
                <span class="pillar-label">Colour Strategy</span>
                <p>
                  A deep oxblood tone leads the palette, giving the brand a sense
                  of authority and experience while standing apart from the typical
                  orange and yellow seen across competitors.
                </p>
              </div>

              <div class="pillar">
                <span class="pillar-label">Digital Strategy</span>
                <p>
                  A clean, fast website designed around trust, clear product
                  information, and making it simple for contractors and specifiers
                  to get in touch.
                </p>
              </div>
            </div>
          </div>
        </article>

        <article id="execution" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">03</span>
            <span class="chapter-title">The Execution</span>
          </div>

          <h3 class="chapter-heading">
            Built from the ground up.<br />
            Every detail carefully considered.
          </h3>

          <div class="chapter-content">
            <p>
              We delivered a complete brand system and digital presence through one
              focused project. The work covered identity, digital, and physical
              touchpoints, creating a consistent and professional presence wherever
              clients interact with Chemcrete.
            </p>

            <div class="execution-deliverables">
              {project.deliverables.map((d) => (
                <div class="deliverable-row">
                  <div class="deliverable-icon" aria-hidden="true">—</div>
                  <div class="deliverable-detail">
                    <span class="deliverable-name">{d.number} — {d.service}</span>
                    <span class="deliverable-heading">{d.heading}</span>
                    <p>{d.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>

        <article id="result" class="story-chapter story-chapter--last">
          <div class="chapter-marker">
            <span class="chapter-number">04</span>
            <span class="chapter-title">The Result</span>
          </div>

          <h3 class="chapter-heading">{project.resultHeading}</h3>

          <div class="chapter-content">
            {project.result.map((para) => <p>{para}</p>)}
          </div>

          <div class="result-stats">
            {project.stats.map((s) => (
              <div class="stat-card">
                <span class="stat-figure">{s.figure}</span>
                <span class="stat-desc">{s.label}</span>
              </div>
            ))}
          </div>

          {project.quote && (
            <blockquote class="story-quote">
              <p class="story-quote-text">“{project.quote}”</p>
              <footer>
                <span class="story-quote-author">— {project.quoteAuthor}</span>
              </footer>
            </blockquote>
          )}
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       5. NEXT PROJECT CTA
  ═══════════════════════════════════════════ -->
  <section class="next-project">
    <div class="container">
      <div class="next-project-inner">
        <span class="eyebrow">Next Project</span>
        <a href="/work/unexpected-opportunities" class="next-project-link">
          <span class="next-project-name">Unexpected Opportunities</span>
          <span class="next-arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :root {
    --chem-white: #ffffff;
    --chem-cream: #f9f8f5;
    --chem-stone: #e3ddd3;
    --chem-grey: #636363;
    --chem-text: #1a1a1a;
    --chem-text-soft: #3f3f3f;
    --chem-red: #7c0000;
    --chem-red-deep: #480000;
    --chem-line: rgba(0, 0, 0, 0.08);
    --chem-line-strong: rgba(0, 0, 0, 0.12);
    --chem-shadow: 0 24px 80px rgba(72, 0, 0, 0.08);
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container-wide {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    display: inline-block;
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--chem-red);
    margin: 0 0 0.75rem;
  }

  .section-label-block {
    max-width: 680px;
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--chem-text);
    margin: 0 0 0.8rem;
    line-height: 1;
  }

  .section-subheading {
    font-family: 'Open Sans', sans-serif;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    color: var(--chem-text-soft);
    margin: 0;
    line-height: 1.7;
  }

  img {
    max-width: 100%;
  }

  /* ════════════════════════════════════════
     1. HERO
  ════════════════════════════════════════ */
  .cs-hero {
    position: relative;
    background:
      radial-gradient(circle at 10% 0%, rgba(124, 0, 0, 0.1), transparent 32rem),
      linear-gradient(180deg, #ffffff 0%, #f9f8f5 72%, #f4f0ea 100%);
    padding: clamp(6rem, 9vw, 8.5rem) 0 0;
    overflow: hidden;
  }

  .cs-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.55;
    background-image:
      linear-gradient(rgba(72, 0, 0, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(72, 0, 0, 0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .cs-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 4.75rem);
  }

  .cs-hero-left {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .cs-tag {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.42rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgba(124, 0, 0, 0.22);
    color: var(--chem-red-deep);
    background: rgba(124, 0, 0, 0.055);
  }

  .cs-kicker {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.46);
    margin: 0 0 0.75rem;
  }

  .cs-hero-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(4rem, 10vw, 8.5rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    color: var(--chem-text);
    line-height: 0.88;
    margin: 0.25rem 0 1.5rem;
  }

  .cs-hero-tagline {
    font-family: 'Open Sans', sans-serif;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--chem-text-soft);
    line-height: 1.75;
    max-width: 700px;
    margin: 0;
  }

  .cs-hero-meta {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 1.35rem 0 1.35rem 2rem;
    border-left: 1px solid rgba(72, 0, 0, 0.14);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .meta-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--chem-red);
  }

  .meta-value {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.9375rem;
    color: var(--chem-text);
    font-weight: 600;
    line-height: 1.55;
  }

  .cs-hero-cover {
    position: relative;
    z-index: 1;
    width: 100%;
    background: var(--chem-stone);
    border: 1px solid var(--chem-line);
    border-bottom: none;
    border-radius: 1.5rem 1.5rem 0 0;
    aspect-ratio: 16 / 7;
    min-height: 280px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--chem-shadow);
  }

  .cs-hero-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .cover-placeholder {
    width: 100%;
    min-height: 280px;
    display: grid;
    place-items: center;
  }

  .cover-hint {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    color: var(--chem-grey);
    letter-spacing: 0.06em;
  }

  /* ════════════════════════════════════════
     2. BRAND IDENTITY
  ════════════════════════════════════════ */
  .brand-section {
    background: var(--chem-cream);
    padding: clamp(4.5rem, 8vw, 6.5rem) 0 0;
    overflow: hidden;
  }

  .brand-board {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    min-height: 520px;
    border-top: 1px solid var(--chem-line);
    margin-top: 1rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  .brand-board-left {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    border-right: 1px solid var(--chem-line);
  }

  .logo-on-light,
  .logo-on-dark,
  .logo-on-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.95rem;
    padding: 2.5rem;
