---
// BrandLines.astro — decorative canvas layer
// Uses CSS variable colours so it is always theme-safe.
// Sits behind all content (z-index: 0).
---

<div class="brand-lines" aria-hidden="true">
  <canvas id="brand-lines-canvas"></canvas>
</div>

<style>
.brand-lines {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

#brand-lines-canvas {
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  opacity: var(--floating-canvas-opacity, 0.45);
  mix-blend-mode: var(--floating-canvas-blend, screen);
}

  @media (max-width: 768px) {
    #brand-lines-canvas { opacity: 0.35; }
  }
  @media (max-width: 480px) {
    #brand-lines-canvas { opacity: 0.25; }
  }
</style>

<script>
  // Read colours from CSS variables so they always match the theme.
  function getLineColours(): { primary: string; secondary: string } {
    const style = getComputedStyle(document.documentElement);
    return {
      primary:   style.getPropertyValue('--brand-line-color').trim()   || 'rgba(47,111,237,0.5)',
      secondary: style.getPropertyValue('--brand-line-secondary').trim() || 'rgba(255,106,0,0.28)',
    };
  }

  // Line definitions — colour is resolved at render time, not hardcoded here.
  const LINE_CONFIGS = [
    { colorKey: 'primary',   opacity: 1, dashArray: [6, 14], waveAmp: 40 },
    { colorKey: 'secondary', opacity: 1, dashArray: [4, 16], waveAmp: 50 },
    { colorKey: 'primary',   opacity: 1, dashArray: [6, 14], waveAmp: 35 },
    { colorKey: 'secondary', opacity: 1, dashArray: [4, 16], waveAmp: 45 },
    { colorKey: 'primary',   opacity: 1, dashArray: [6, 14], waveAmp: 30 },
  ] as const;

  const SECTION_SELECTOR = [
    'main > section',
    'main > div',
    'main > article',
    '[data-section]',
    'body > section',
    'body > div > section',
  ].join(',');

  const MIN_GAP    = 40;

  function getNavHeight(): number {
    return (
      parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 85
    );
  }

  function getSectionGaps(): { y: number; size: number }[] {
    const navH     = getNavHeight();
    const vh       = window.innerHeight;
    const sections = Array.from(document.querySelectorAll(SECTION_SELECTOR));
    if (!sections.length) return [];

    const bands = sections
      .map(el => { const r = el.getBoundingClientRect(); return { top: r.top, bottom: r.bottom }; })
      .filter(r => r.bottom > navH && r.top < vh)
      .sort((a, b) => a.top - b.top);

    if (!bands.length) return [];

    // Merge overlapping bands
    const merged: { top: number; bottom: number }[] = [];
    for (const band of bands) {
      if (merged.length && band.top <= merged[merged.length - 1].bottom) {
        merged[merged.length - 1].bottom = Math.max(merged[merged.length - 1].bottom, band.bottom);
      } else {
        merged.push({ ...band });
      }
    }

    const gaps: { y: number; size: number }[] = [];
    let cursor = navH;
    for (const band of merged) {
      const gapSize = band.top - cursor;
      if (gapSize >= MIN_GAP) gaps.push({ y: cursor + gapSize / 2, size: gapSize });
      cursor = band.bottom;
    }
    const trailing = vh - cursor;
    if (trailing >= MIN_GAP) gaps.push({ y: cursor + trailing / 2, size: trailing });
    return gaps;
  }

  function getEvenPositions(count: number): number[] {
    const navH   = getNavHeight();
    const usable = window.innerHeight - navH;
    return Array.from({ length: count }, (_, i) => navH + (usable / (count + 1)) * (i + 1));
  }

  function drawWave(
    ctx: CanvasRenderingContext2D,
    y: number,
    width: number,
    amp: number,
    color: string,
    opacity: number,
    dashArray: readonly number[]
  ) {
    ctx.save();
    ctx.globalAlpha = opacity;
    ctx.strokeStyle  = color;
    ctx.lineWidth    = 0.6;
    ctx.setLineDash(dashArray as number[]);
    ctx.beginPath();
    ctx.moveTo(0, y);
    ctx.quadraticCurveTo(width * 0.25, y - amp, width * 0.5, y);
    ctx.quadraticCurveTo(width * 0.75, y + amp, width, y);
    ctx.stroke();
    ctx.restore();
  }

  function render() {
    const canvas = document.getElementById('brand-lines-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const W   = window.innerWidth;
    const H   = window.innerHeight;
    const dpr = window.devicePixelRatio || 1;

    canvas.setAttribute('width',  String(Math.round(W * dpr)));
    canvas.setAttribute('height', String(Math.round(H * dpr)));

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, W, H);

    // Resolve theme colours fresh each frame so toggling works instantly
    const colours = getLineColours();
    const gaps    = getSectionGaps();

    let yPositions: number[];
    if (gaps.length >= LINE_CONFIGS.length) {
      yPositions = gaps.slice(0, LINE_CONFIGS.length).map(g => g.y);
    } else if (gaps.length > 0) {
      yPositions = LINE_CONFIGS.map((_, i) => {
        const gap    = gaps[i % gaps.length];
        const offset = i < gaps.length ? 0 : ((i % 3) - 1) * (gap.size * 0.2);
        return gap.y + offset;
      });
    } else {
      yPositions = getEvenPositions(LINE_CONFIGS.length);
    }

    yPositions.forEach((y, i) => {
      const cfg   = LINE_CONFIGS[i];
      const color = colours[cfg.colorKey as keyof typeof colours];
      drawWave(ctx, y, W, cfg.waveAmp, color, cfg.opacity, cfg.dashArray);
    });
  }

  let rafId = 0;
  function scheduleRender() {
    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(render);
  }

  const ro = new ResizeObserver(scheduleRender);
  ro.observe(document.body);
  window.addEventListener('scroll', scheduleRender, { passive: true });
  window.addEventListener('resize', scheduleRender, { passive: true });

  // Re-render when the theme attribute changes so colour tokens refresh
  const themeObserver = new MutationObserver(scheduleRender);
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', render);
  } else {
    render();
  }
  window.addEventListener('load', render);
</script>