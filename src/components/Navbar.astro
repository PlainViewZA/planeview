---
const navItems = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/FAQ', label: 'FAQs' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/contact', label: 'Contact' },
];
---

<!-- Fixed Navigation -->
<nav class="nav">
  <div class="container">
    <div class="nav-wrapper">
      <a href="/" class="logo">
        <div class="logo-icon">
          <img src="/logo/navbar_logo_dark.webp" alt="Plane View Collective" width="180" height="32" />
        </div>
      </a>

      <button class="mobile-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="burger" aria-hidden="true">
          <span class="bar bar1"></span>
          <span class="bar bar2"></span>
          <span class="bar bar3"></span>
        </span>
        <span class="sr-only">Toggle menu</span>
      </button>

      <div class="nav-menu">
        <ul class="nav-links">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="nav-link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="/contact" class="btn btn-primary mobile-nav-cta">
          Get in Touch
          <span class="arrow">→</span>
        </a>
      </div>

      <div class="nav-cta-wrapper">
        <a href="/contact" class="btn btn-primary nav-cta">
          Get in Touch
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<div class="nav-spacer" aria-hidden="true"></div>

<script>
  // Store cleanup functions so we can tear down on next navigation
  let navCleanup: (() => void) | null = null;

  function initNav() {
    // Run previous cleanup before re-initialising
    if (navCleanup) {
      navCleanup();
      navCleanup = null;
    }

    const nav = document.querySelector('.nav');
    const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
    const navMenu = document.querySelector<HTMLElement>('.nav-menu');
    const body = document.body;

    if (!nav) return;

    // ── Scroll handler ──
    const onScroll = () => {
      nav.classList.toggle('scrolled', window.pageYOffset > 50);
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // ── Mobile menu toggle ──
    const onToggleClick = () => {
      const isActive = menuToggle!.classList.toggle('active');
      navMenu?.classList.toggle('active');
      body.classList.toggle('menu-open');
      menuToggle!.setAttribute('aria-expanded', isActive ? 'true' : 'false');
    };
    menuToggle?.addEventListener('click', onToggleClick);

    // ── Close on nav link click ──
    const closeMenu = () => {
      menuToggle?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
      navMenu?.classList.remove('active');
      body.classList.remove('menu-open');
    };

    const navLinks = document.querySelectorAll('.nav-link, .mobile-nav-cta');
    navLinks.forEach(link => link.addEventListener('click', closeMenu));

    // ── Close on outside click ──
    const onOutsideClick = (e: Event) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.nav-wrapper') && navMenu?.classList.contains('active')) {
        closeMenu();
      }
    };
    document.addEventListener('click', onOutsideClick);

    // ── Nav height sync ──
    const updateNavHeight = () => {
      const h = Math.ceil(nav.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--nav-height', h + 'px');
      const spacer = document.querySelector<HTMLElement>('.nav-spacer');
      if (spacer) spacer.style.height = h + 'px';
    };

    const onResize = () => requestAnimationFrame(updateNavHeight);
    window.addEventListener('resize', onResize);
    updateNavHeight();

    // ── Mutation observer for nav height changes ──
    const mutationObserver = new MutationObserver(() => updateNavHeight());
    mutationObserver.observe(nav, { attributes: true, childList: false, subtree: false });

    // ── Cleanup function — called before next initNav run ──
    navCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      menuToggle?.removeEventListener('click', onToggleClick);
      navLinks.forEach(link => link.removeEventListener('click', closeMenu));
      document.removeEventListener('click', onOutsideClick);
      mutationObserver.disconnect();
      // Make sure menu state is reset on navigation
      closeMenu();
    };
  }

  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    --nav-height: 85px;
    background-color: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
    transition: all var(--transition-base);
  }

  .nav.scrolled {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(24px) saturate(200%);
    -webkit-backdrop-filter: blur(24px) saturate(200%);
    box-shadow: 0 4px 24px rgba(17, 17, 17, 0.06);
  }

  .nav-wrapper {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: var(--spacing-md);
    padding-bottom: var(--spacing-md);
    gap: var(--spacing-lg);
  }

  .nav-spacer {
    display: block;
    width: 100%;
    height: 85px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    text-decoration: none;
    color: var(--color-jet-black);
    transition: opacity var(--transition-base);
    z-index: 1001;
    justify-self: start;
  }

  .logo:hover { opacity: 0.7; }

  .logo-icon {
    width: auto;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-icon img {
    max-width: 180px;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 1001;
    width: 44px;
    height: 44px;
    position: relative;
    align-items: center;
    justify-content: center;
    color: var(--color-jet-black);
  }

  .mobile-menu-toggle .burger {
    display: inline-block;
    width: 22px;
    height: 16px;
    position: relative;
  }

  .mobile-menu-toggle .bar {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 230ms cubic-bezier(.4,0,.2,1), opacity 180ms ease;
  }

  .mobile-menu-toggle .bar1 { top: 0; }
  .mobile-menu-toggle .bar2 { top: 7px; }
  .mobile-menu-toggle .bar3 { bottom: 0; }

  .mobile-menu-toggle.active .bar1 { transform: translateY(7px) rotate(45deg); }
  .mobile-menu-toggle.active .bar2 { opacity: 0; transform: scaleX(0); }
  .mobile-menu-toggle.active .bar3 { transform: translateY(-7px) rotate(-45deg); }

  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: var(--spacing-xl);
    justify-self: center;
  }

  .nav-cta-wrapper {
    display: flex;
    justify-self: end;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-jet-black);
    text-decoration: none;
    transition: color var(--transition-base);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-steel-blue);
    transition: width var(--transition-base);
  }

  .nav-link:hover { color: var(--color-steel-blue); }
  .nav-link:hover::after { width: 100%; }

  .nav-cta { white-space: nowrap; }
  .mobile-nav-cta { display: none; }

  @media (max-width: 768px) {
    .nav { --nav-height: 70px; }
    .nav-spacer { height: 70px; }

    .nav-wrapper {
      display: flex;
      justify-content: space-between;
    }

    .mobile-menu-toggle {
      display: flex;
      width: auto;
      height: auto;
      padding: 6px;
    }

    .nav-cta-wrapper { display: none; }

    .nav-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 280px;
      height: 100vh;
      background-color: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      box-shadow: -4px 0 24px rgba(17, 17, 17, 0.1);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: calc(var(--spacing-md) * 2 + 3.5rem) var(--spacing-lg) var(--spacing-xl);
      transition: right var(--transition-slow);
      overflow-y: auto;
    }

    .nav-menu.active {
      right: 0;
      background-color: #ffffff !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      opacity: 1 !important;
      z-index: 1300;
      box-shadow: -8px 0 32px rgba(17, 17, 17, 0.12);
      will-change: transform, opacity;
    }

    .nav-menu.active::before {
      content: '';
      position: absolute;
      inset: 0;
      background: #ffffff !important;
      pointer-events: none;
      z-index: -1;
    }

    .nav-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      width: 100%;
    }

    .nav-links li {
      width: 100%;
      border-bottom: 1px solid rgba(17, 17, 17, 0.1);
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: var(--spacing-md) 0;
      font-size: 1.125rem;
    }

    .nav-link::after { display: none; }

    .mobile-nav-cta {
      display: flex;
      margin-top: var(--spacing-lg);
      width: 100%;
      justify-content: center;
    }

    :global(body.menu-open) {
      overflow: hidden;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .nav-links { gap: var(--spacing-md); }
    .nav-link { font-size: 0.875rem; }
  }
</style>