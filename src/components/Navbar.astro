---
const navItems = [
  { href: '/',         label: 'Home'     },
  { href: '/about',    label: 'About'    },
  { href: '/services', label: 'Services' },
  { href: '/work',     label: 'Work'     },
  { href: '/insights',  label: 'Insights'  },
  { href: '/pricing',  label: 'Pricing'  },
  { href: '/contact',  label: 'Contact'  },
];
---

<!-- Fixed Navigation -->
<nav class="nav" role="navigation" aria-label="Main navigation">
  <div class="nav-pill">

    <!-- Logo -->
    <a href="/" class="logo" aria-label="Plane View Collective — home">
      <img
        src="/logo/navbar_logo_light.webp"
        alt="Plane View Collective"
        width="160"
        height="28"
      />
    </a>

    <!-- Desktop nav links -->
    <ul class="nav-links" role="list">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="nav-link">{item.label}</a>
        </li>
      ))}
    </ul>

    <!-- Desktop CTA -->
    <a href="/contact" class="btn-cta" aria-label="Start a project with Plane View Collective">
      Start a Project <span class="arrow" aria-hidden="true">→</span>
    </a>

    <!-- Mobile burger -->
    <button
      class="burger-btn"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="bar bar1" aria-hidden="true"></span>
      <span class="bar bar2" aria-hidden="true"></span>
      <span class="bar bar3" aria-hidden="true"></span>
    </button>

  </div>
</nav>

<!-- Mobile slide-out drawer -->
<div id="mobile-drawer" class="drawer" role="dialog" aria-modal="true" aria-label="Navigation menu" hidden>
  <ul class="drawer-links" role="list">
    {navItems.map((item) => (
      <li>
        <a href={item.href} class="drawer-link">{item.label}</a>
      </li>
    ))}
  </ul>
  <a href="/contact" class="btn-cta drawer-cta">
    Start a Project <span class="arrow" aria-hidden="true">→</span>
  </a>
</div>

<!-- Overlay -->
<div class="overlay" aria-hidden="true"></div>

<!-- Spacer so page content isn't hidden behind fixed nav -->
<div class="nav-spacer" aria-hidden="true"></div>


<script>
  let cleanup: (() => void) | null = null;

  function initNav() {
    if (cleanup) { cleanup(); cleanup = null; }

    const nav         = document.querySelector<HTMLElement>('.nav');
    const pill        = document.querySelector<HTMLElement>('.nav-pill');
    const burgerBtn   = document.querySelector<HTMLButtonElement>('.burger-btn');
    const drawer      = document.getElementById('mobile-drawer');
    const overlay     = document.querySelector<HTMLElement>('.overlay');
    const spacer      = document.querySelector<HTMLElement>('.nav-spacer');

    if (!nav || !pill) return;

    // ── Scroll: shrink pill on scroll ──
    const onScroll = () => {
      const scrolled = window.pageYOffset > 40;
      pill.classList.toggle('scrolled', scrolled);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ── Nav height → CSS var ──
    const syncHeight = () => {
      const h = Math.ceil(nav.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--nav-height', h + 'px');
      if (spacer) spacer.style.height = h + 'px';
    };
    const onResize = () => requestAnimationFrame(syncHeight);
    window.addEventListener('resize', onResize);
    syncHeight();

    // ── Mobile drawer ──
    const openDrawer = () => {
      drawer?.removeAttribute('hidden');
      overlay?.classList.add('visible');
      burgerBtn?.classList.add('active');
      burgerBtn?.setAttribute('aria-expanded', 'true');
      burgerBtn?.setAttribute('aria-label', 'Close navigation menu');
      document.body.classList.add('menu-open');
      // Focus first link
      drawer?.querySelector<HTMLElement>('.drawer-link')?.focus();
    };

    const closeDrawer = () => {
      drawer?.setAttribute('hidden', '');
      overlay?.classList.remove('visible');
      burgerBtn?.classList.remove('active');
      burgerBtn?.setAttribute('aria-expanded', 'false');
      burgerBtn?.setAttribute('aria-label', 'Open navigation menu');
      document.body.classList.remove('menu-open');
    };

    burgerBtn?.addEventListener('click', () => {
      const isOpen = burgerBtn.getAttribute('aria-expanded') === 'true';
      isOpen ? closeDrawer() : openDrawer();
    });

    // Close on overlay click
    overlay?.addEventListener('click', closeDrawer);

    // Close on drawer link click
    const drawerLinks = drawer?.querySelectorAll('a');
    drawerLinks?.forEach(l => l.addEventListener('click', closeDrawer));

    // Close on Escape
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeDrawer();
    };
    document.addEventListener('keydown', onKeydown);

    // MO for height
    const mo = new MutationObserver(syncHeight);
    mo.observe(nav, { attributes: true });

    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      document.removeEventListener('keydown', onKeydown);
      overlay?.removeEventListener('click', closeDrawer);
      drawerLinks?.forEach(l => l.removeEventListener('click', closeDrawer));
      mo.disconnect();
      closeDrawer();
    };
  }

  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(initNav);
  });
</script>


<style>
  /* ─── NAV SHELL ──────────────────────────────────────────────── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 16px 24px;
    pointer-events: none; /* let clicks through to the pill only */
  }

  /* ─── PILL CONTAINER ─────────────────────────────────────────── */
  .nav-pill {
    pointer-events: all;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg, 2rem);

    max-width: 1200px;
    margin: 0 auto;
    padding: 10px 20px 10px 20px;

    background: rgba(13, 13, 13, 0.82);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 999px;

    transition:
      padding var(--transition-base, 0.25s ease),
      background var(--transition-base, 0.25s ease),
      box-shadow var(--transition-base, 0.25s ease);
  }

  .nav-pill.scrolled {
    padding: 8px 20px;
    background: rgba(13, 13, 13, 0.94);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 255, 255, 0.07);
  }

  /* ─── LOGO ───────────────────────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .logo:hover,
  .logo:focus-visible {
    opacity: 0.65;
  }

  .logo:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .logo img {
    display: block;
    width: 150px;
    height: auto;
    object-fit: contain;
  }

  /* ─── NAV LINKS ──────────────────────────────────────────────── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    color: rgba(240, 240, 240, 0.8);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 2px;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  /* Active state — matches current route */
  .nav-link[aria-current="page"] {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ─── CTA BUTTON ─────────────────────────────────────────────── */
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 9px 20px;
    border-radius: 999px;
    background: var(--color-steel-blue, #4a90d9);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      transform 0.15s ease,
      box-shadow 0.2s ease;
  }

  .btn-cta:hover {
    background: var(--color-steel-blue-hover, #5aa0e8);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(74, 144, 217, 0.35);
  }

  .btn-cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .btn-cta:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .btn-cta .arrow {
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .btn-cta:hover .arrow {
    transform: translateX(3px);
  }

  /* ─── BURGER ─────────────────────────────────────────────────── */
  .burger-btn {
    display: none;
    position: relative;
    z-index: 1301;
    width: 40px;
    height: 40px;
    padding: 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .burger-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .burger-btn:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 2px;
  }

  .bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: #f0f0f0;
    border-radius: 2px;
    transition:
      transform 230ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 180ms ease;
  }

  .burger-btn.active .bar1 {
    transform: translateY(6.5px) rotate(45deg);
  }

  .burger-btn.active .bar2 {
    opacity: 0;
    transform: scaleX(0);
  }

  .burger-btn.active .bar3 {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ─── SPACER ─────────────────────────────────────────────────── */
  .nav-spacer {
    width: 100%;
    height: 88px; /* overridden by JS */
  }

  /* ─── MOBILE DRAWER ──────────────────────────────────────────── */
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1200;
    width: min(300px, 88vw);
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 80px 28px 40px;
    background: #111111;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.5);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* When NOT hidden, animate in */
  .drawer:not([hidden]) {
    transform: translateX(0);
  }

  /* Override the hidden attribute display:none so we can animate */
  .drawer[hidden] {
    display: flex !important;
    transform: translateX(100%);
    pointer-events: none;
  }

  .drawer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .drawer-links li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .drawer-link {
    display: block;
    padding: 16px 0;
    color: rgba(240, 240, 240, 0.85);
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .drawer-link:hover {
    color: #ffffff;
  }

  .drawer-link:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .drawer-cta {
    display: flex;
    justify-content: center;
    margin-top: 28px;
  }

  /* ─── OVERLAY ────────────────────────────────────────────────── */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1100;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .overlay.visible {
    opacity: 1;
    pointer-events: all;
  }

  /* ─── BODY LOCK ──────────────────────────────────────────────── */
  :global(body.menu-open) {
    overflow: hidden;
  }

  /* ─── RESPONSIVE ─────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .nav {
      padding: 12px 16px;
    }

    .nav-links {
      display: none;
    }

    .btn-cta:not(.drawer-cta) {
      display: none;
    }

    .burger-btn {
      display: flex;
    }
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .nav-link {
      font-size: 0.85rem;
      padding: 6px 10px;
    }

    .logo img {
      width: 130px;
    }
  }
</style>