---
import MainLayout from '../../layouts/MainLayout.astro';
import Navigation from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

// ============================================================
//  EDIT THIS SECTION ONLY — everything else stays the same
// ============================================================

const project = {
  metaTitle: "Chemcrete Case Study | Plane View Collective",
  metaDescription: "How we built a complete digital presence for a 35-year-old Cape Town concrete specialist — brand identity, website design, and digital strategy.",

  tags: ["Web Design", "Branding", "Digital Strategy"],
  title: "Chemcrete",
  tagline: "Building a digital foundation for a 35-year-old concrete specialist — complete brand identity, website, and market positioning from the ground up.",

  client: "Chemcrete",
  industry: "Construction & Civil Engineering",
  location: "Cape Town, South Africa",
  services: ["Brand Identity", "Website Design", "Digital Strategy"],
  year: "2024",

  heroImage: "/chemcrete/Section.webp",
  heroImageAlt: "Chemcrete website mockup",

  challengeHeading: "A 35-year legacy, invisible online.",
  challenge: [
    "Chemcrete has been supplying the Cape Town construction and civil engineering sectors with SABS-compliant concrete products for over three decades. The quality of their work speaks for itself on job sites across the Western Cape — but online, they simply didn't exist.",
    "No website. No cohesive brand. No way for potential clients to verify who they were or what they stood for. In an industry where trust and credibility are everything, this was a significant commercial liability.",
  ],

  approachHeading: "Industrial strength. Refined presentation.",
  approach: [
    "We began with a brand audit and stakeholder conversations to understand how Chemcrete sees itself — and how its best clients describe them. Two words emerged consistently: reliable and no-nonsense.",
    "The strategy was not to reinvent the company, but to finally express it properly. The brand direction drew on industrial visual language — honest materials, strong structure, confident typography — while avoiding the clichés of construction marketing.",
    "The website was structured to prioritise credibility, product clarity, and fast decision-making for contractors, specifiers, and civil engineering clients.",
  ],

  deliverables: [
    {
      number: "01",
      service: "Brand Identity",
      heading: "A visual identity built on strength and trust",
      description: "We developed a brand system rooted in industrial confidence — logo suite, colour palette, typography system, and brand guidelines designed to feel established, robust, and credible.",
    },
    {
      number: "02",
      service: "Website Design & Build",
      heading: "A site built for credibility and product clarity",
      description: "The website was designed to help contractors and specifiers understand the product range quickly, verify the company's legitimacy, and make contact with ease.",
    },
    {
      number: "03",
      service: "Collateral & Application",
      heading: "A brand that carries across every touchpoint",
      description: "We extended the system into physical and digital collateral including business cards, signage, and branded applications to ensure consistency wherever Chemcrete appears.",
    },
  ],

  resultHeading: "A 35-year business, finally positioned to grow.",
  result: [
    "Chemcrete now has a digital and brand presence that reflects the quality and experience they've built over three decades. Contractors and civil engineers can find them, understand their offering, and make contact — all within seconds.",
    "The new identity distinguishes them sharply from competitors. The oxblood palette and industrial typographic system communicate authority and longevity without saying a word.",
  ],

  stats: [
    { figure: "35+", label: "Years of expertise, now properly represented" },
    { figure: "0→1", label: "From no digital presence to a complete brand system" },
    { figure: "Full", label: "End-to-end: identity, digital, collateral" },
  ],

  quote: "Contractors were Googling competitors and making decisions before they ever picked up the phone.",
  quoteAuthor: "Project Insight",
};
// ============================================================
---
<MainLayout title={project.metaTitle} description={project.metaDescription}>
  <Navigation />

  <section class="cs-hero">
    <div class="container">
      <div class="cs-hero-inner">
        <div class="cs-hero-left">
          <div class="cs-tags">
            {project.tags.map((tag) => (
              <span class="cs-tag">{tag}</span>
            ))}
          </div>
          <h1 class="cs-hero-title">{project.title}</h1>
          <p class="cs-hero-tagline">{project.tagline}</p>
        </div>

        <div class="cs-hero-meta">
          <div class="meta-item">
            <span class="meta-label">Client</span>
            <span class="meta-value">{project.client}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Industry</span>
            <span class="meta-value">{project.industry}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">{project.location}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Services</span>
            {project.services.map((s) => (
              <span class="meta-value">{s}</span>
            ))}
          </div>
          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{project.year}</span>
          </div>
        </div>
      </div>

      <div class="cs-hero-cover">
        {project.heroImage ? (
          <img src={project.heroImage} alt={project.heroImageAlt} />
        ) : (
          <div class="cover-placeholder" aria-label={project.heroImageAlt}>
            <span class="cover-hint">Hero Image — {project.client}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       2. BRAND IDENTITY — Logo · Colour · Type
  ═══════════════════════════════════════════ -->
  <section class="brand-section">

    <div class="container">
      <div class="section-label-block">
        <span class="eyebrow">Brand Identity</span>
        <h2 class="section-heading">The Chemcrete Identity</h2>
        <p class="section-subheading">A visual system built on industrial strength and material honesty.</p>
      </div>
    </div>

    <!-- Brand Board — Split Panel -->
    <div class="brand-board">

      <!-- Left: Logo showcase -->
      <div class="brand-board-left">
        <div class="logo-on-light">
          <div class="logo-placeholder logo-primary">
            <div class="logo-mark">
              <div class="logo-icon-placeholder">C</div>
            </div>
            <span class="logo-wordmark">CHEMCRETE</span>
          </div>
          <span class="logo-variant-label">Primary — Light Background</span>
        </div>
        <div class="logo-on-dark">
          <div class="logo-placeholder logo-reversed">
            <div class="logo-mark">
              <div class="logo-icon-placeholder reversed">C</div>
            </div>
            <span class="logo-wordmark reversed">CHEMCRETE</span>
          </div>
          <span class="logo-variant-label light">Primary — Dark Background</span>
        </div>
        <div class="logo-on-brand">
          <div class="logo-placeholder logo-brand">
            <div class="logo-mark">
              <div class="logo-icon-placeholder brand">C</div>
            </div>
            <span class="logo-wordmark brand">CHEMCRETE</span>
          </div>
          <span class="logo-variant-label light">Primary — Brand Colour</span>
        </div>
      </div>

      <!-- Right: Colour palette columns -->
      <div class="brand-board-right">
        <div class="colour-column" style="background:#ffffff; border: 1px solid #e0dbd1;">
          <div class="colour-info dark">
            <span class="colour-name">White</span>
            <span class="colour-hex">#ffffff</span>
            <span class="colour-role">Background</span>
          </div>
        </div>
        <div class="colour-column" style="background:#e3ddd3;">
          <div class="colour-info dark">
            <span class="colour-name">Aesthetic White</span>
            <span class="colour-hex">#e3ddd3</span>
            <span class="colour-role">Secondary BG</span>
          </div>
        </div>
        <div class="colour-column" style="background:#636363;">
          <div class="colour-info light">
            <span class="colour-name">Granite Gray</span>
            <span class="colour-hex">#636363</span>
            <span class="colour-role">Body Text</span>
          </div>
        </div>
        <div class="colour-column" style="background:#7c0000;">
          <div class="colour-info light">
            <span class="colour-name">Dark Red</span>
            <span class="colour-hex">#7c0000</span>
            <span class="colour-role">Secondary</span>
          </div>
        </div>
        <div class="colour-column" style="background:#480000;">
          <div class="colour-info light">
            <span class="colour-name">Oxblood</span>
            <span class="colour-hex">#480000</span>
            <span class="colour-role">Primary</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Typography Strip -->
    <div class="type-strip">
      <div class="container">
        <div class="type-grid">

          <div class="type-block type-display">
            <span class="type-label">Display — Oswald</span>
            <div class="type-specimen-display">Aa</div>
            <div class="type-weights">
              <span style="font-family:'Oswald',sans-serif; font-weight:400;">Regular</span>
              <span style="font-family:'Oswald',sans-serif; font-weight:600;">SemiBold</span>
              <span style="font-family:'Oswald',sans-serif; font-weight:700;">Bold</span>
            </div>
            <p class="type-usage">Used for headlines, section titles, and all display text.</p>
          </div>

          <div class="type-divider"></div>

          <div class="type-block type-body">
            <span class="type-label">Body — Open Sans</span>
            <div class="type-specimen-body">Aa</div>
            <div class="type-weights">
              <span style="font-family:'Open Sans',sans-serif; font-weight:400;">Regular</span>
              <span style="font-family:'Open Sans',sans-serif; font-weight:500;">Medium</span>
              <span style="font-family:'Open Sans',sans-serif; font-weight:600;">SemiBold</span>
            </div>
            <p class="type-usage">Used for body copy, descriptions, and UI labels.</p>
          </div>

          <div class="type-divider"></div>

          <div class="type-block type-specimen-live">
            <span class="type-label">In Use</span>
            <p class="specimen-headline">Top of the range concrete products.</p>
            <p class="specimen-body">Serving the construction and civil industries across South Africa with SABS-compliant materials and a focus on quality, affordability, and customer satisfaction.</p>
          </div>

        </div>
      </div>
    </div>

    <!-- Brand Values Strip -->
    <div class="brand-values-strip">
      <div class="container">
        <div class="values-grid">
          <div class="value-pill">Industrial</div>
          <div class="value-pill">Robust</div>
          <div class="value-pill">Functional</div>
          <div class="value-pill">Established</div>
          <div class="value-pill">Material-focused</div>
          <div class="value-pill accent">Integrity &amp; Honesty</div>
          <div class="value-pill accent">Quality Excellence</div>
          <div class="value-pill accent">Customer Satisfaction</div>
        </div>
      </div>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════
       3. MOCKUPS — Visual Application
  ═══════════════════════════════════════════ -->
  <section class="mockups-section">
    <div class="container">

      <div class="section-label-block">
        <span class="eyebrow">Application</span>
        <h2 class="section-heading">The Work in Context</h2>
        <p class="section-subheading">Brand applied across digital and physical touchpoints.</p>
      </div>

      <!-- Primary Desktop Mockup — Full Width -->
      <div class="mockup-feature">
        <div class="mockup-frame mockup-frame--desktop">
          <div class="mockup-browser-bar">
            <div class="browser-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="browser-url">https://chemcrete-v1.netlify.app/</div>
          </div>
          <div class="mockup-screen mockup-screen--16-9">
            <img src="/images/Section.webp" alt="Chemcrete Homepage" />
          </div>
        </div>
        <p class="mockup-caption">Homepage Design</p>
      </div>

      <!-- Three-col: Collateral -->
      <div class="mockup-grid mockup-grid--3col">

        <div class="mockup-item">
          <div class="mockup-frame mockup-frame--card">
            <img src="/chemcrete/card.webp" alt="Business Card" />
          </div>
          <p class="mockup-caption">Business Card</p>
        </div>

        <div class="mockup-item">
          <div class="mockup-frame mockup-frame--card">
            <img src="/chemcrete/chemcretesocialmedia.webp" alt="Social Media Post" />
          </div>
          <p class="mockup-caption">Social Media</p>
        </div>

        <div class="mockup-item">
          <div class="mockup-frame mockup-frame--card">
            <img src="/chemcrete/signage.webp" alt="Construction Signage" />
          </div>
          <p class="mockup-caption">Construction Signage</p>
        </div>

      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       4. CASE STUDY — The Story
  ═══════════════════════════════════════════ -->
  <section class="story-section">

    <div class="container story-container">

      <nav class="story-sidenav" aria-label="Case study navigation">
        <a href="#challenge" class="cs-nav-link">Challenge</a>
        <a href="#approach"  class="cs-nav-link">Approach</a>
        <a href="#execution" class="cs-nav-link">Execution</a>
        <a href="#result"    class="cs-nav-link">Result</a>
      </nav>

      <div class="story-body">

        <!-- Challenge -->
        <article id="challenge" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">01</span>
            <span class="chapter-title">The Challenge</span>
          </div>
          <h3 class="chapter-heading">{project.challengeHeading}</h3>
          <div class="chapter-content">
            {project.challenge.map((para) => <p>{para}</p>)}
          </div>
        </article>

        <!-- Approach -->
        <article id="approach" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">02</span>
            <span class="chapter-title">The Approach</span>
          </div>
          <h3 class="chapter-heading">{project.approachHeading}</h3>
          <div class="chapter-content">
            {project.approach.map((para) => <p>{para}</p>)}
            <div class="approach-pillars">
              <div class="pillar">
                <span class="pillar-label">Brand Direction</span>
                <p>Industrial honesty. Strong but approachable. Built to last, not built to trend.</p>
              </div>
              <div class="pillar">
                <span class="pillar-label">Colour Strategy</span>
                <p>Oxblood as the primary — commanding, established, distinctive in a sea of orange and yellow competitors.</p>
              </div>
              <div class="pillar">
                <span class="pillar-label">Digital Strategy</span>
                <p>A lean, fast website focused on credibility, product clarity, and making it easy for specifiers and contractors to enquire.</p>
              </div>
            </div>
          </div>
        </article>

        <!-- Execution -->
        <article id="execution" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">03</span>
            <span class="chapter-title">The Execution</span>
          </div>
          <h3 class="chapter-heading">
            Built from the ground up.<br />Every touchpoint considered.
          </h3>
          <div class="chapter-content">
            <p>
              We delivered a complete brand system and digital presence in a single focused engagement. The work spanned identity, digital, and physical touchpoints — giving Chemcrete a coherent presence wherever a client might encounter them.
            </p>
            <div class="execution-deliverables">
              {project.deliverables.map((d) => (
                <div class="deliverable-row">
                  <div class="deliverable-icon">—</div>
                  <div class="deliverable-detail">
                    <span class="deliverable-name">{d.number} — {d.service}</span>
                    <span class="deliverable-heading">{d.heading}</span>
                    <p>{d.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>

        <!-- Result -->
        <article id="result" class="story-chapter story-chapter--last">
          <div class="chapter-marker">
            <span class="chapter-number">04</span>
            <span class="chapter-title">The Result</span>
          </div>
          <h3 class="chapter-heading">{project.resultHeading}</h3>
          <div class="chapter-content">
            {project.result.map((para) => <p>{para}</p>)}
          </div>

          <div class="result-stats">
            {project.stats.map((s) => (
              <div class="stat-card">
                <span class="stat-figure">{s.figure}</span>
                <span class="stat-desc">{s.label}</span>
              </div>
            ))}
          </div>

          {project.quote && (
            <blockquote class="story-quote">
              <p class="story-quote-text">"{project.quote}"</p>
              <footer>
                <span class="story-quote-author">— {project.quoteAuthor}</span>
              </footer>
            </blockquote>
          )}
        </article>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       5. NEXT PROJECT CTA
  ═══════════════════════════════════════════ -->
  <section class="next-project">
    <div class="container">
      <div class="next-project-inner">
        <span class="eyebrow">Next Project</span>
        <a href="/work/next-project" class="next-project-link">
          <span class="next-project-name">Project Name</span>
          <span class="next-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<!-- ═══════════════════════════════════════════
     STYLES
═══════════════════════════════════════════ -->
<style>
  /* ── Shared Utilities ── */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    display: inline-block;
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7c0000;
    margin-bottom: 0.75rem;
  }

  .section-label-block {
    max-width: 640px;
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }

  .section-subheading {
    font-family: 'Open Sans', sans-serif;
    font-size: 1.0625rem;
    color: #636363;
    margin: 0;
    line-height: 1.6;
  }

  /* ════════════════════════════════════════
     1. HERO
  ════════════════════════════════════════ */
  .cs-hero {
    background: #f9f8f5;
    padding: 7rem 0 0;
    overflow: hidden;
  }

  .cs-hero-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
    padding-bottom: 4rem;
  }

  .cs-hero-left {
    display: flex;
    flex-direction: column;
  }

  .cs-hero-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1a1a1a;
    line-height: 0.95;
    margin: 0.5rem 0 1.5rem;
  }

  .cs-hero-tagline {
    font-family: 'Open Sans', sans-serif;
    font-size: 1.125rem;
    color: #636363;
    line-height: 1.7;
    max-width: 480px;
    margin: 0;
  }

  .cs-hero-meta {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 1.25rem;
    border-left: 1px solid rgba(0,0,0,0.1);
    padding-left: 2.5rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .meta-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7c0000;
  }

  .meta-value {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.9375rem;
    color: #1a1a1a;
    font-weight: 500;
    line-height: 1.5;
  }

  .cs-hero-cover {
    position: relative;
    width: 100%;
    background: #e3ddd3;
    border-top: 1px solid rgba(0,0,0,0.08);
    aspect-ratio: 16 / 7;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cs-hero-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .cover-hint {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    color: #636363;
    letter-spacing: 0.06em;
  }

  /* ════════════════════════════════════════
     2. BRAND IDENTITY
  ════════════════════════════════════════ */
  .brand-section {
    background: #f9f8f5;
    padding: 6rem 0 0;
    overflow: hidden;
  }

  .brand-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 480px;
    border-top: 1px solid rgba(0,0,0,0.08);
    margin-top: 1rem;
  }

  .brand-board-left {
    display: grid;
    grid-template-rows: 1fr 1fr 1fr;
    border-right: 1px solid rgba(0,0,0,0.08);
  }

  .logo-on-light,
  .logo-on-dark,
  .logo-on-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .logo-on-light { background: #ffffff; }
  .logo-on-dark  { background: #1a1a1a; }
  .logo-on-brand { background: #480000; border-bottom: none; }

  .logo-placeholder {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-icon-placeholder {
    width: 48px;
    height: 48px;
    border: 2px solid #480000;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #480000;
  }

  .logo-icon-placeholder.reversed {
    border-color: #ffffff;
    color: #ffffff;
  }

  .logo-icon-placeholder.brand {
    border-color: #e3ddd3;
    color: #e3ddd3;
  }

  .logo-wordmark {
    font-family: 'Oswald', sans-serif;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #480000;
  }

  .logo-wordmark.reversed { color: #ffffff; }
  .logo-wordmark.brand    { color: #e3ddd3; }

  .logo-variant-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #636363;
  }

  .logo-variant-label.light { color: rgba(255,255,255,0.45); }

  .brand-board-right {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .colour-column {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem 1rem;
    min-height: 480px;
  }

  .colour-column:not(:last-child) {
    border-right: 1px solid rgba(255,255,255,0.12);
  }

  .colour-info { display: flex; flex-direction: column; gap: 3px; }

  .colour-name {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .colour-hex {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  .colour-role {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 400;
    opacity: 0.5;
    margin-top: 2px;
  }

  .colour-info.dark  .colour-name,
