---
import MainLayout from '../../layouts/MainLayout.astro';
import Navigation from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<MainLayout
  title="Chemcrete Case Study | Plane View Collective"
  description="How we built a complete digital presence for a 35-year-old Cape Town concrete specialist — brand identity, website design, and digital strategy."
>
  <Navigation />

  <!-- ── Breadcrumb ── -->
  <div class="breadcrumb-bar">
    <div class="container">
      <a href="/work" class="breadcrumb-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Work
      </a>
    </div>
  </div>

  <!-- ── Hero ── -->
  <section class="cs-hero section">
    <div class="container container-narrow">

      <div class="cs-tags">
        <span class="cs-tag">Web Design</span>
        <span class="cs-tag">Branding</span>
        <span class="cs-tag">Digital Marketing</span>
      </div>

      <h1 class="cs-title">
        Chemcrete — Full digital presence build for a 35-year-old concrete specialist
      </h1>

      <p class="cs-sub">
        A trusted Cape Town concrete business had the reputation but not the visibility. We built the brand identity and digital presence that matched their three decades of expertise.
      </p>

      <dl class="cs-meta">
        <div class="cs-meta-item">
          <dt>Client</dt>
          <dd>Chemcrete</dd>
        </div>
        <div class="cs-meta-item">
          <dt>Industry</dt>
          <dd>Construction</dd>
        </div>
        <div class="cs-meta-item">
          <dt>Location</dt>
          <dd>Cape Town, SA</dd>
        </div>
        <div class="cs-meta-item">
          <dt>Services</dt>
          <dd>Brand &amp; Web</dd>
        </div>
        <div class="cs-meta-item">
          <dt>Year</dt>
          <dd>2026</dd>
        </div>
      </dl>

    </div>
  </section>

  <!-- ── Hero Image ── -->
  <section class="cs-hero-image-section">
    <div class="container">
      <div class="cs-hero-image">
        <!--
          SWAP THIS: Replace the placeholder div below with:
          <img src="/images/chemcrete-mockup.webp" alt="Chemcrete website design mockup" />
        -->
        <div class="cs-hero-placeholder" aria-label="Chemcrete website mockup">
          <div class="placeholder-screen">
            <div class="placeholder-nav">
              <div class="ph-logo"></div>
              <div class="ph-nav-links">
                <span></span><span></span><span></span>
              </div>
            </div>
            <div class="placeholder-hero-block">
              <div class="ph-headline"></div>
              <div class="ph-sub"></div>
              <div class="ph-btn"></div>
            </div>
            <div class="placeholder-grid">
              <div class="ph-card"></div>
              <div class="ph-card"></div>
              <div class="ph-card"></div>
            </div>
          </div>
          <span class="placeholder-label">Chemcrete — Website Mockup</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Body ── -->
  <div class="cs-body">
    <div class="container">
      <div class="cs-content-grid">

        <!-- Main content -->
        <main class="cs-main">

          <!-- Challenge -->
          <section class="cs-section" id="challenge">
            <span class="cs-section-label">The Challenge</span>
            <h2>A trusted business with no digital footprint</h2>
            <p>
              Chemcrete had been delivering specialist concrete solutions in Cape Town for 35 years. Their reputation was built on word of mouth and proven results — but when potential clients searched for them online, they found almost nothing. There was no website that reflected the quality of the work, no brand identity they could put on a vehicle, a uniform, or a proposal, and no digital marketing presence to generate new leads.
            </p>
            <p>
              The business was growing through reputation alone. The challenge was to build a digital presence that finally matched the standard of the work they had been doing for three decades.
            </p>
          </section>

          <!-- Approach -->
          <section class="cs-section" id="approach">
            <span class="cs-section-label">Our Approach</span>
            <h2>Brand first. Then build.</h2>
            <p>
              We started with the brand before touching the website — because a website built on an unclear identity is just noise. We needed Chemcrete to have a visual identity and a voice that communicated expertise, trust, and longevity before any page was designed.
            </p>
            <p>
              The strategic proposal we developed at the outset covered website development, social media content, and digital marketing. Rather than trying to do everything at once, we recommended building the foundation first: a clear brand identity followed by a website designed to convert visitors into enquiries. Everything else would grow from that base.
            </p>
            <p>
              The tone we established was confident and technical without being inaccessible — speaking directly to project managers, developers, and property owners who needed a specialist they could trust.
            </p>
          </section>

          <!-- The Work -->
          <section class="cs-section" id="work">
            <span class="cs-section-label">The Work</span>
            <h2>Brand identity and a site built to convert</h2>

            <div class="cs-deliverable">
              <div class="cs-deliverable-label">01 — Brand Identity</div>
              <h3>A visual system built for longevity</h3>
              <p>
                We developed a complete brand guide for Chemcrete covering colour system, typography, tone of voice, and core brand values. The palette draws on industrial strength — deep, grounded tones that communicate permanence and precision. The typography is structured and legible, suited to both digital and print applications.
              </p>
              <div class="cs-work-visual brand-guide-visual">
                <div class="bg-swatches">
                  <div class="bg-swatch" style="background:#ffffff;" data-label="White"></div>
                  <div class="bg-swatch" style="background:#480000;" data-label="Oxblood"></div>
                  <div class="bg-swatch" style="background:#e3ddd3;" data-label="Aesthetic White"></div>
                  <div class="bg-swatch" style="background:#636363;" data-label="Granite Gray"></div>
                  <div class="bg-swatch" style="background:#7c0000;" data-label="Dark Red"></div>
                </div>
                <div class="bg-type-row">
                  <span class="bg-type-primary">Chemcrete</span>
                  <span class="bg-type-secondary">Concrete Specialists · Est. 1989</span>
                </div>
                <div class="bg-caption">Brand Guide — Colour System &amp; Typography</div>
              </div>
            </div>

            <div class="cs-deliverable">
              <div class="cs-deliverable-label">02 — Website Design</div>
              <h3>Performance-first design, clear hierarchy</h3>
              <p>
                The website was designed to do one job well: turn a visitor who needs concrete solutions into an enquiry. Clean layout, strong visual hierarchy, and CTAs placed where decisions happen. Every section was written and designed to answer the question a prospect has before they ask it.
              </p>
              <div class="cs-work-visual website-visual">
                <div class="wv-browser-bar">
                  <span class="wv-dot" style="background:#ff5f57;"></span>
                  <span class="wv-dot" style="background:#febc2e;"></span>
                  <span class="wv-dot" style="background:#28c840;"></span>
                  <span class="wv-url">chemcrete.co.za</span>
                </div>
                <div class="wv-content">
                  <div class="wv-hero-block">
                    <div class="wv-h1"></div>
                    <div class="wv-h2"></div>
                    <div class="wv-btn-row">
                      <div class="wv-btn-solid"></div>
                      <div class="wv-btn-outline"></div>
                    </div>
                  </div>
                  <div class="wv-services-row">
                    <div class="wv-service-card">
                      <div class="wv-icon"></div>
                      <div class="wv-card-text"></div>
                      <div class="wv-card-text short"></div>
                    </div>
                    <div class="wv-service-card">
                      <div class="wv-icon"></div>
                      <div class="wv-card-text"></div>
                      <div class="wv-card-text short"></div>
                    </div>
                    <div class="wv-service-card">
                      <div class="wv-icon"></div>
                      <div class="wv-card-text"></div>
                      <div class="wv-card-text short"></div>
                    </div>
                  </div>
                </div>
                <div class="wv-caption">Website — Homepage Design</div>
              </div>
            </div>

            <div class="cs-deliverable">
              <div class="cs-deliverable-label">03 — Digital Strategy</div>
              <h3>A roadmap beyond the launch</h3>
              <p>
                Alongside the brand and website build, we developed a strategic proposal covering social media content and digital marketing — laying out how Chemcrete could move from a static online presence to an active channel for generating qualified leads, including content strategy, platform selection, and campaign direction.
              </p>
            </div>
          </section>

          <!-- Result -->
          <section class="cs-section cs-result-section" id="result">
            <span class="cs-section-label">The Result</span>
            <h2>From invisible to established</h2>
            <p>
              Chemcrete went from a trusted but invisible business to a brand with a digital presence that matches their 35-year industry standing. For the first time, a potential client searching for specialist concrete services in Cape Town can find them, understand what they do, and make contact — all from a single, clear brand touchpoint.
            </p>
            <p>
              The brand identity gave the team something they could put on a vehicle wrap, a proposal cover, and a social post with equal confidence. The website gave them a place to send every referral that would explain the business before a call was ever made.
            </p>

            <div class="cs-result-stats">
              <div class="cs-stat">
                <span class="cs-stat-number">35<span class="cs-stat-unit">yrs</span></span>
                <span class="cs-stat-label">of expertise, now visible online</span>
              </div>
              <div class="cs-stat">
                <span class="cs-stat-number">0<span class="cs-stat-unit">→1</span></span>
                <span class="cs-stat-label">from no digital presence to a complete identity</span>
              </div>
              <div class="cs-stat">
                <span class="cs-stat-number">3</span>
                <span class="cs-stat-label">core deliverables shipped: brand, web &amp; strategy</span>
              </div>
            </div>
          </section>

          <!-- Client Quote -->
          <section class="cs-section">
            <blockquote class="cs-quote">
              <p class="cs-quote-text">
                "They understood exactly what we needed — a brand that reflected the quality of our work and a website that actually brings in enquiries. Plane View delivered both."
              </p>
              <footer class="cs-quote-footer">
                <span class="cs-quote-author">Client, Chemcrete</span>
                <span class="cs-quote-note">— Testimonial pending sign-off</span>
              </footer>
            </blockquote>
          </section>

        </main>

        <!-- Sidebar -->
        <aside class="cs-sidebar">
          <div class="cs-sidebar-inner">
            <div class="cs-sidebar-block">
              <h4 class="cs-sidebar-heading">Project Details</h4>
              <ul class="cs-sidebar-list">
                <li>
                  <span class="sidebar-label">Client</span>
                  <span class="sidebar-value">Chemcrete</span>
                </li>
                <li>
                  <span class="sidebar-label">Industry</span>
                  <span class="sidebar-value">Construction &amp; Concrete</span>
                </li>
                <li>
                  <span class="sidebar-label">Location</span>
                  <span class="sidebar-value">Cape Town, South Africa</span>
                </li>
                <li>
                  <span class="sidebar-label">Year</span>
                  <span class="sidebar-value">2026</span>
                </li>
                <li>
                  <span class="sidebar-label">Services</span>
                  <span class="sidebar-value">Brand Identity<br/>Website Design<br/>Digital Strategy</span>
                </li>
              </ul>
            </div>

            <div class="cs-sidebar-block cs-sidebar-nav-block">
              <h4 class="cs-sidebar-heading">On this page</h4>
              <nav aria-label="Case study sections">
                <a href="#challenge" class="cs-nav-link">The Challenge</a>
                <a href="#approach" class="cs-nav-link">Our Approach</a>
                <a href="#work" class="cs-nav-link">The Work</a>
                <a href="#result" class="cs-nav-link">The Result</a>
              </nav>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </div>

  <!-- ── CTA Strip ── -->
  <!--<section class="cs-cta-strip section"> -->
    <!--<div class="container">-->
     <!-- <div class="cs-cta-inner">-->
        <!--<div class="cs-cta-text">-->
          <!--<h2>Want results like this?</h2>-->
         <!-- <p>Let's talk about your project.</p>
        </div>
         <!-- <a href="/contact" class="btn btn-primary btn-lg">-->
         <!-- Get in Touch-->
          <!-- <span class="arrow">→</span>-->
        </a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  /* ── Breadcrumb ── */
  .breadcrumb-bar {
    padding: var(--spacing-md) 0;
    border-bottom: 1px solid rgba(17, 17, 17, 0.08);
  }

  .breadcrumb-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-slate-grey);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .breadcrumb-link:hover { color: var(--color-jet-black); }

  /* ── Hero ── */
  .cs-hero { padding-bottom: var(--spacing-xl); }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: var(--spacing-lg);
  }

  .cs-tag {
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    border: 1.5px solid rgba(47, 111, 237, 0.3);
    color: var(--color-steel-blue);
    letter-spacing: 0.02em;
  }

  .cs-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--spacing-lg);
  }

  .cs-sub {
    font-size: 1.25rem;
    line-height: 1.65;
    color: var(--color-slate-grey);
    max-width: 680px;
    margin-bottom: var(--spacing-xl);
  }

  .cs-meta {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid rgba(17, 17, 17, 0.1);
    border-bottom: 1px solid rgba(17, 17, 17, 0.1);
    padding: var(--spacing-md) 0;
  }

  .cs-meta-item {
    flex: 1 1 120px;
    padding: var(--spacing-sm) var(--spacing-md) var(--spacing-sm) 0;
  }

  .cs-meta-item:not(:last-child) {
    border-right: 1px solid rgba(17, 17, 17, 0.1);
    margin-right: var(--spacing-md);
  }

  .cs-meta-item dt {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-slate-grey);
    margin-bottom: 4px;
  }

  .cs-meta-item dd {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-jet-black);
  }

  /* ── Hero Image ── */
  .cs-hero-image-section { padding-bottom: var(--spacing-3xl); }

  .cs-hero-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #111;
  }

  .cs-hero-image img { width: 100%; display: block; }

  .cs-hero-placeholder {
    background: linear-gradient(135deg, #1a2035 0%, #2a3a52 100%);
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xl);
    padding: var(--spacing-2xl);
  }

  .placeholder-screen {
    width: 100%;
    max-width: 860px;
    background: #f5f5f0;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.5);
  }

  .placeholder-nav {
    background: #1a2035;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ph-logo { width: 100px; height: 10px; background: rgba(200,169,81,0.7); border-radius: 4px; }
  .ph-nav-links { display: flex; gap: 14px; }
  .ph-nav-links span { width: 48px; height: 8px; background: rgba(255,255,255,0.2); border-radius: 3px; display: block; }

  .placeholder-hero-block {
    background: linear-gradient(135deg, #1a2035 0%, #2f4858 100%);
    padding: 40px 24px 48px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ph-headline { width: 70%; height: 18px; background: rgba(255,255,255,0.85); border-radius: 4px; }
  .ph-sub      { width: 50%; height: 12px; background: rgba(255,255,255,0.3);  border-radius: 4px; }
  .ph-btn      { width: 120px; height: 32px; background: #C8A951; border-radius: 20px; margin-top: 8px; }

  .placeholder-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 20px;
    background: #f5f5f0;
  }

  .ph-card { background: #fff; height: 80px; border-radius: 6px; border: 1px solid rgba(0,0,0,0.06); }

  .placeholder-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── Body layout ── */
  .cs-body { padding-bottom: var(--spacing-3xl); }

  .cs-content-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--spacing-3xl);
    align-items: start;
  }

  /* ── Sections ── */
  .cs-section { margin-bottom: var(--spacing-3xl); }
  .cs-section:last-child { margin-bottom: 0; }

  .cs-section-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-steel-blue);
    margin-bottom: var(--spacing-sm);
  }

  .cs-section h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: var(--spacing-md); }

  .cs-section p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #2a2a2a;
    margin-bottom: var(--spacing-md);
    max-width: 70ch;
  }

  .cs-section p:last-child { margin-bottom: 0; }

  /* ── Deliverables ── */
  .cs-deliverable {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid rgba(17,17,17,0.08);
  }

  .cs-deliverable-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-slate-grey);
    margin-bottom: var(--spacing-sm);
  }

  .cs-deliverable h3 { font-size: 1.375rem; margin-bottom: var(--spacing-md); }

  .cs-deliverable p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #2a2a2a;
    margin-bottom: var(--spacing-md);
    max-width: 70ch;
  }

  /* ── Brand guide visual ── */
  .brand-guide-visual {
    margin-top: var(--spacing-xl);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #111827;
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .bg-swatches { display: flex; gap: 8px; flex-wrap: wrap; }

  .bg-swatch {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    position: relative;
    flex-shrink: 0;
  }

  .bg-swatch::after {
    content: attr(data-label);
    position: absolute;
    bottom: -22px;
    left: 0;
    right: 0;
    font-size: 0.6rem;
    color: rgba(255,255,255,0.3);
    text-align: center;
    white-space: nowrap;
  }

  .bg-type-row { margin-top: var(--spacing-md); display: flex; flex-direction: column; gap: 6px; }

  .bg-type-primary {
    font-size: 2rem;
    font-weight: 700;
    color: #C8A951;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .bg-type-secondary {
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bg-caption {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: var(--spacing-md);
    margin-top: var(--spacing-sm);
  }

  /* ── Website visual ── */
  .website-visual {
    margin-top: var(--spacing-xl);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #f0f0ec;
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .wv-browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #e4e4e0;
    border-radius: 8px;
    padding: 8px 12px;
  }

  .wv-dot { width: 10px; height: 10px; border-radius: 50%; display: block; flex-shrink: 0; }

  .wv-url {
    font-size: 0.75rem;
    color: #888;
    margin-left: 8px;
    background: rgba(255,255,255,0.6);
    padding: 3px 12px;
    border-radius: 20px;
    /* FIX: prevent overflow on narrow screens */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 160px;
  }

  .wv-content { background: #1a2035; border-radius: var(--radius-sm); overflow: hidden; }

  .wv-hero-block {
    padding: 28px 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: linear-gradient(135deg, #1a2035 0%, #2f4858 100%);
  }

  .wv-h1 { width: 65%; height: 14px; background: rgba(255,255,255,0.9); border-radius: 3px; }
  .wv-h2 { width: 45%; height: 10px; background: rgba(255,255,255,0.35); border-radius: 3px; }
  .wv-btn-row { display: flex; gap: 8px; margin-top: 6px; }
  .wv-btn-solid { width: 100px; height: 28px; background: #C8A951; border-radius: 20px; }
  .wv-btn-outline { width: 80px; height: 28px; border: 1.5px solid rgba(255,255,255,0.3); border-radius: 20px; }

  .wv-services-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 16px;
    background: #f5f5f0;
  }

  .wv-service-card {
    background: #fff;
    border-radius: 6px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid rgba(0,0,0,0.05);
  }

  .wv-icon { width: 28px; height: 28px; background: rgba(47,111,237,0.12); border-radius: 6px; }
  .wv-card-text { width: 80%; height: 8px; background: #e0e0da; border-radius: 3px; }
  .wv-card-text.short { width: 55%; height: 7px; }

  .wv-caption {
    font-size: 0.75rem;
    font-weight: 500;
    color: #999;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Result stats ── */
  .cs-result-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-top: var(--spacing-2xl);
    padding: var(--spacing-xl);
    background: rgba(47, 111, 237, 0.04);
    border-radius: var(--radius-md);
    border: 1px solid rgba(47, 111, 237, 0.1);
  }

