---
const navItems = [
  { href: '/',         label: 'Home'     },
  { href: '/about',    label: 'About'    },
  { href: '/services', label: 'Services' },
  { href: '/work',     label: 'Work'     },
  { href: '/pricing',  label: 'Pricing'  },
  { href: '/contact',  label: 'Contact'  },
];
---

<!-- Fixed Navigation -->
<nav class="nav" role="navigation" aria-label="Main navigation">
  <div class="nav-pill">

    <!-- Logo -->
    <a href="/" class="logo" aria-label="Plane View Collective — home">
      <img
        src="/logo/navbar_logo_light.webp"
        alt="Plane View Collective"
        width="160"
        height="28"
      />
    </a>

    <!-- Desktop nav links -->
    <ul class="nav-links" role="list">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="nav-link">{item.label}</a>
        </li>
      ))}
    </ul>



  
<!-- Mobile menu button -->
<button
  class="burger-btn"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-drawer"
>
  <span class="burger-label">Menu</span>
</button>

  </div>
</nav>

<!-- Mobile slide-out drawer -->
<aside
  id="mobile-drawer"
  class="drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  aria-hidden="true"
>
  <div class="drawer-inner">

<div class="drawer-top">
  <p class="drawer-eyebrow">Inspire</p>

  <button
    class="drawer-close"
    type="button"
    aria-label="Close navigation menu"
  >
    Close
  </button>
</div>
    <ul class="drawer-links" role="list">
      {navItems.map((item, index) => (
        <li style={`--i: ${index}`}>
          <a href={item.href} class="drawer-link">{item.label}</a>
        </li>
      ))}
    </ul>

 
</aside>

<!-- Overlay -->
<div class="overlay" aria-hidden="true"></div>

<!-- Spacer so page content isn't hidden behind fixed nav -->
<div class="nav-spacer" aria-hidden="true"></div>


<script>
 let cleanup: (() => void) | null = null;

  function initNav() {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }

    const nav = document.querySelector<HTMLElement>('.nav');
    const pill = document.querySelector<HTMLElement>('.nav-pill');
    const burgerBtn = document.querySelector<HTMLButtonElement>('.burger-btn');
    const drawer = document.getElementById('mobile-drawer');
    const overlay = document.querySelector<HTMLElement>('.overlay');
    const spacer = document.querySelector<HTMLElement>('.nav-spacer');
    const drawerClose = document.querySelector<HTMLButtonElement>('.drawer-close');

    if (!nav || !pill) return;

    // ── Scroll: shrink pill on scroll ──
    const onScroll = () => {
      const scrolled = window.pageYOffset > 40;
      pill.classList.toggle('scrolled', scrolled);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ── Nav height → CSS var ──
    const syncHeight = () => {
      const h = Math.ceil(nav.getBoundingClientRect().height);
      document.documentElement.style.setProperty('--nav-height', h + 'px');

      if (spacer) {
        spacer.style.height = h + 'px';
      }
    };

    const onResize = () => requestAnimationFrame(syncHeight);

    window.addEventListener('resize', onResize);
    syncHeight();

    // ── Mobile drawer ──
    const openDrawer = () => {
      drawer?.classList.add('is-open');
      drawer?.setAttribute('aria-hidden', 'false');

      overlay?.classList.add('visible');

      burgerBtn?.classList.add('active');
      burgerBtn?.setAttribute('aria-expanded', 'true');
      burgerBtn?.setAttribute('aria-label', 'Close navigation menu');

    

      document.body.classList.add('menu-open');

      window.setTimeout(() => {
        drawer?.querySelector<HTMLElement>('.drawer-link')?.focus();
      }, 120);
    };

    const closeDrawer = () => {
      drawer?.classList.remove('is-open');
      drawer?.setAttribute('aria-hidden', 'true');

      overlay?.classList.remove('visible');

      burgerBtn?.classList.remove('active');
      burgerBtn?.setAttribute('aria-expanded', 'false');
      burgerBtn?.setAttribute('aria-label', 'Open navigation menu');

   

      document.body.classList.remove('menu-open');
    };

    const toggleDrawer = () => {
      const isOpen = burgerBtn?.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    };

    burgerBtn?.addEventListener('click', toggleDrawer);
    drawerClose?.addEventListener('click', closeDrawer);

    // Close on overlay click
    overlay?.addEventListener('click', closeDrawer);
    

    // Close on drawer link click
    const drawerLinks = drawer?.querySelectorAll('a');

    drawerLinks?.forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    // Close on Escape
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeDrawer();
      }
    };

    document.addEventListener('keydown', onKeydown);

    // Close drawer if resizing back to desktop
    const onDesktopResize = () => {
      if (window.innerWidth > 900) {
        closeDrawer();
      }
    };

    window.addEventListener('resize', onDesktopResize);

    // Watch for nav height changes
    const mo = new MutationObserver(syncHeight);
    mo.observe(nav, {
      attributes: true,
      childList: true,
      subtree: true,
    });

    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      window.removeEventListener('resize', onDesktopResize);
      document.removeEventListener('keydown', onKeydown);

      burgerBtn?.removeEventListener('click', toggleDrawer);
      overlay?.removeEventListener('click', closeDrawer);

      drawerLinks?.forEach((link) => {
        link.removeEventListener('click', closeDrawer);
      });

      mo.disconnect();
      closeDrawer();
    };
  }

  document.addEventListener('astro:page-load', () => {
    requestAnimationFrame(initNav);
  });
</script>

<style>
  /* ─── NAV SHELL ──────────────────────────────────────────────── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 16px 24px;
    pointer-events: none;
  }


/* ─── PILL CONTAINER ─────────────────────────────────────────── */
.nav-pill {
  pointer-events: all;
  display: grid;
  grid-template-columns: 160px 1fr 160px;
  align-items: center;
  gap: var(--spacing-lg, 2rem);

  max-width: 1200px;
  margin: 0 auto;
  padding: 10px 20px;

  background: rgba(13, 13, 13, 0.82);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 999px;

  transition:
    padding var(--transition-base, 0.25s ease),
    background var(--transition-base, 0.25s ease),
    box-shadow var(--transition-base, 0.25s ease),
    border-color var(--transition-base, 0.25s ease);
}

  .nav-pill.scrolled {
    padding: 8px 20px;
    background: rgba(13, 13, 13, 0.94);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 255, 255, 0.07);
  }

  /* ─── LOGO ───────────────────────────────────────────────────── */
.logo {
  display: flex;
  align-items: center;
  justify-self: start;
  flex-shrink: 0;
  text-decoration: none;
  opacity: 1;
  transition: opacity 0.2s ease;
}

  .logo:hover,
  .logo:focus-visible {
    opacity: 0.65;
  }

  .logo:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .logo img {
    display: block;
    width: 150px;
    height: auto;
    object-fit: contain;
  }

  /* ─── NAV LINKS ──────────────────────────────────────────────── */
.nav-links {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  list-style: none;
  margin: 0;
  padding: 0;

  grid-column: 2;
}

  .nav-link {
    position: relative;
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    color: rgba(240, 240, 240, 0.8);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 2px;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  .nav-link[aria-current="page"] {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ─── CTA BUTTON ─────────────────────────────────────────────── */
  .btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    padding: 9px 20px;
    border-radius: 999px;
    background: var(--color-steel-blue, #4a90d9);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      transform 0.15s ease,
      box-shadow 0.2s ease;
  }

  .btn-cta:hover {
    background: var(--color-steel-blue-hover, #5aa0e8);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(74, 144, 217, 0.35);
  }

  .btn-cta:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .btn-cta:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .btn-cta .arrow {
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .btn-cta:hover .arrow {
    transform: translateX(3px);
  }

  /* ─── MOBILE MENU BUTTON ─────────────────────────────────────── */
  .burger-btn {
    display: none;
    position: relative;
    z-index: 1001;

    align-items: center;
    justify-content: center;

    height: 40px;
    padding: 0 16px;

    background: transparent;
    border: 0;
    border-radius: 999px;

    color: #ffffff;
    cursor: pointer;

    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .burger-btn:hover {
    opacity: 0.68;
  }

  .burger-btn:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 4px;
  }

  .burger-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ─── SPACER ─────────────────────────────────────────────────── */
  .nav-spacer {
    width: 100%;
    height: 88px;
  }

  /* ─── MOBILE DROPDOWN DRAWER ─────────────────────────────────── */
  .drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1200;

    width: 100%;

    /* Safari + mobile browser viewport fallback stack */
    height: 100vh;
    height: 100svh;
    height: 100dvh;

    display: flex;
    flex-direction: column;

    background:
      radial-gradient(circle at top right, rgba(230, 126, 34, 0.16), transparent 34%),
      radial-gradient(circle at bottom left, rgba(74, 144, 217, 0.13), transparent 38%),
      rgba(10, 10, 10, 0.96);

    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);

    border-left: 0;
    box-shadow: 0 18px 70px rgba(0, 0, 0, 0.62);

    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;

    transform: translateY(-105%);
    opacity: 0;
    pointer-events: none;

    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 260ms ease;
  }

  .drawer.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .drawer-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;

    max-width: 1200px;
    width: 100%;
    margin: 0 auto;

    /* iPhone notch + Safari safe-area support */
    padding:
      calc(110px + env(safe-area-inset-top))
      max(32px, env(safe-area-inset-right))
      calc(48px + env(safe-area-inset-bottom))
      max(32px, env(safe-area-inset-left));
  }

  .drawer-top {
    position: sticky;
    top: 0;
    z-index: 2;

    margin-bottom: 34px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    background: transparent;
  }

  .drawer-eyebrow {
    margin: 0;
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .drawer-close {
    appearance: none;
    -webkit-appearance: none;

    border: 0;
    background: transparent;
    color: #ffffff;
    padding: 0;

    cursor: pointer;

    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    opacity: 0.75;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .drawer-close:hover {
    opacity: 1;
    transform: translateX(-2px);
  }

  .drawer-close:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .drawer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .drawer-links li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    transform: translateY(-18px);
    opacity: 0;

    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 320ms ease;

    transition-delay: calc(var(--i) * 45ms);
  }

  .drawer.is-open .drawer-links li {
    transform: translateY(0);
    opacity: 1;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 0;

    color: rgba(245, 245, 245, 0.9);
    font-size: clamp(1.55rem, 6.5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
    text-decoration: none;

    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .drawer-link::after {
    content: "→";
    color: rgba(230, 126, 34, 0.75);
    font-size: 0.55em;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .drawer-link:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  .drawer-link:hover::after {
    opacity: 1;
    transform: translateX(0);
  }

  .drawer-link:focus-visible {
    outline: 2px solid var(--color-steel-blue, #4a90d9);
    outline-offset: 6px;
    border-radius: 8px;
    color: #ffffff;
  }

  .drawer-bottom {
    margin-top: 32px;
    display: grid;
    gap: 18px;
  }

  .drawer-cta {
    width: 100%;
    justify-content: center;
    padding: 13px 20px;
  }

  .drawer-note {
    max-width: 320px;
    margin: 0;
    color: rgba(255, 255, 255, 0.52);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  /* ─── OVERLAY ────────────────────────────────────────────────── */
  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1100;

    background: rgba(0, 0, 0, 0.58);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);

    opacity: 0;
    pointer-events: none;

    transition: opacity 300ms ease;
  }

  .overlay.visible {
    opacity: 1;
    pointer-events: all;
  }

  /* Fallback for browsers that do not support backdrop-filter */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .drawer {
      background: rgba(10, 10, 10, 0.98);
    }

    .overlay {
      background: rgba(0, 0, 0, 0.72);
    }
  }

  /* ─── BODY LOCK ──────────────────────────────────────────────── */
  :global(body.menu-open) {
    overflow: hidden;
    width: 100%;
    overscroll-behavior: none;
    touch-action: none;
  }

  @supports selector(html:has(body.menu-open)) {
    :global(html:has(body.menu-open)) {
      overflow: hidden;
      overscroll-behavior: none;
    }
  }

  /* ─── RESPONSIVE ─────────────────────────────────────────────── */
@media (max-width: 900px) {
  .nav {
    padding: 12px 16px;
  }

  .nav-pill {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-lg, 2rem);
  }

  .nav-links {
    display: none;
  }

  .btn-cta:not(.drawer-cta) {
    display: none;
  }

  .burger-btn {
    display: flex;
  }
}
  @media (max-width: 520px) {
    .nav {
      padding: 12px 14px;
    }

    .nav-pill {
      padding: 10px 16px;
    }

    .logo img {
      width: 138px;
    }

    .drawer-inner {
      padding:
        calc(92px + env(safe-area-inset-top))
        24px
        calc(100px + env(safe-area-inset-bottom))
        24px;
    }

    .drawer-top {
      margin-bottom: 32px;
    }

    .drawer-link {
      font-size: clamp(1.65rem, 10vw, 3rem);
      padding: 16px 0;
    }

    .drawer-note {
      max-width: 100%;
    }
  }

  @media (max-width: 380px) {
    .logo img {
      width: 124px;
    }

    .burger-btn {
      padding: 0 10px;
    }

    .drawer-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .drawer-link {
      font-size: clamp(1.45rem, 9vw, 2.55rem);
      padding: 14px 0;
    }
  }

  @media (min-width: 901px) and (max-width: 1100px) {
    .nav-link {
      font-size: 0.85rem;
      padding: 6px 10px;
    }

    .logo img {
      width: 130px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer-links li,
    .drawer-link,
    .overlay,
    .btn-cta,
    .nav-pill,
    .burger-btn,
    .drawer-close {
      transition: none;
    }
  }
</style>