---
const { post } = Astro.props;

const slug   = post.data.slug;
const href   = `/insights/${slug}/`;

const images    = Array.isArray(post.data.images) ? post.data.images : [];
const heroEntry = images.find(img => img.hero) ?? images[0];
const image     = heroEntry?.src ?? null;

const date  = post.data.date?.toLocaleDateString('en-ZA', {
  year: 'numeric',
  month: 'short',
}) ?? null;
---

<a href={href} class="insight-card" aria-label={`View case study: ${post.data.title}`}>

  {image ? (
    <img
      class="card-img"
      src={image}
      alt={post.data.alt ?? post.data.title}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class="card-fallback" aria-hidden="true"></div>
  )}

  <div class="card-overlay">
    <div class="card-meta">
      {post.data.category && <span class="meta-tag">{post.data.category}</span>}
      {post.data.platform && <span class="meta-tag">{post.data.platform}</span>}
      {date && <span class="meta-date">{date}</span>}
    </div>

    <div class="card-body">
      <h2>{post.data.title}</h2>
      {post.data.excerpt && <p>{post.data.excerpt}</p>}
      <div class="card-cta" aria-hidden="true">
        <span>View case study</span>
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor"
            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>

</a>

<style>
  /* The card fills whatever cell PostGrid gives it.
     PostGrid cells are position:relative — the card
     must NOT set position:absolute itself. */
  .insight-card {
    display: block;
    position: relative;   /* establishes stacking context for overlay/image */
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .insight-card:hover {
    transform: scale(1.013);
  }

  /* Image fills the card */
  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .insight-card:hover .card-img {
    transform: scale(1.04);
  }

  /* Fallback surface when no image */
  .card-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 40%, rgba(249, 115, 22, 0.12) 0%, transparent 60%),
      #141414;
  }

  /* Gradient overlay */
  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.1rem 1.25rem 1.35rem;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.0)  0%,
      rgba(0, 0, 0, 0.1)  30%,
      rgba(0, 0, 0, 0.6)  72%,
      rgba(0, 0, 0, 0.82) 100%
    );
  }

  /* Meta row */
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .meta-tag {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(6px);
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    line-height: 1;
  }

  .meta-date {
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.48);
    margin-left: auto;
    letter-spacing: 0.03em;
  }

  /* Card body */
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .insight-card h2 {
    font-size: clamp(0.95rem, 1.8vw, 1.3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-weight: 700;
    margin: 0;
    color: #fff;
  }

  .insight-card p {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA */
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-top: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #f97316;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .insight-card:hover .card-cta {
    opacity: 1;
    transform: translateY(0);
  }

  .card-cta svg {
    transition: transform 0.2s ease;
  }

  .insight-card:hover .card-cta svg {
    transform: translateX(3px);
  }

  /* ── Mobile (≤640px) ── */
  @media (max-width: 640px) {
    .card-overlay {
      padding: 0.9rem 1rem 1.1rem;
    }

    .insight-card h2 {
      font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    }

    .insight-card p {
      font-size: 0.75rem;
      -webkit-line-clamp: 1;
    }

    .card-cta {
      font-size: 0.62rem;
    }

    @media (max-width: 640px) {
  .insight-card {
    height: 100%;
    min-height: inherit;
  }

  .insight-card:hover {
    transform: none;
  }

  .insight-card:hover .card-img {
    transform: none;
  }

  .card-overlay {
    padding: 0.9rem 1rem 1.1rem;
  }

  .insight-card h2 {
    font-size: clamp(0.95rem, 5vw, 1.25rem);
  }

  .insight-card p {
    font-size: 0.75rem;
    -webkit-line-clamp: 1;
  }

  .card-cta {
    opacity: 1;
    transform: none;
    font-size: 0.62rem;
  }

  }
}
</style>