---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import PostGrid from '../../components/insights/PostGrid.astro';


const posts = await getCollection('insights');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const totalPosts = posts.length;
---

<MainLayout
  title="Insights | Plane View Collective"
  description="A showcase of campaigns, content pieces, and marketing insights from Plane View Collective."
>
  <div class="insights-page">

  

    <div class="insights-container">

      <!-- Top bar -->
      <nav class="topbar" aria-label="Page navigation">
        <a href="/" class="back-btn" aria-label="Back to home">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path
              d="M9 2L4 7L9 12"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>Back to home</span>
        </a>

        <span class="archive-label" aria-hidden="true">Insights archive</span>
      </nav>

      <!-- Hero -->
      <header class="hero">
        <p class="kicker">
          <span class="kicker-dot" aria-hidden="true"></span>
          Plane View Collective
        </p>

        <h1>
          Campaigns, content,<br />
          and strategic thinking.
        </h1>

        <p class="intro">
          Selected creative and marketing work from Plane View Collective —
          structured as campaign case studies, not just social posts.
        </p>

        <div class="meta-strip" role="list" aria-label="Insight categories">
          <span role="listitem">{totalPosts} Case {totalPosts === 1 ? 'Study' : 'Studies'}</span>
          <span class="strip-div" aria-hidden="true"></span>
          <span role="listitem">Social Campaigns</span>
          <span class="strip-div" aria-hidden="true"></span>
          <span role="listitem">Brand Strategy</span>
          <span class="strip-div" aria-hidden="true"></span>
          <span role="listitem">Digital Content</span>
        </div>
      </header>

      <!-- Section label -->
      <div class="section-label" aria-hidden="true">
        <span class="section-label-text">Selected case studies</span>
        <span class="section-label-line"></span>
      </div>

      <!-- Grid -->
      <PostGrid posts={posts} />

      <!-- Coming Soon Box -->
      <section class="coming-soon-box" aria-labelledby="coming-soon-title">
        <div class="coming-soon-content">
          <p class="coming-soon-kicker">More on the way</p>

          <h2 id="coming-soon-title">
            More content coming soon.
          </h2>

          <p>
            We’re building out more campaign breakdowns, design notes, and digital strategy
            insights from our work with small businesses.
          </p>
        </div>

        <a href="/contact" class="coming-soon-link">
          Start a project
          <span aria-hidden="true">→</span>
        </a>
      </section>

    </div>

    <!-- Ambient glow — purely decorative -->
    <div class="glow glow-a" aria-hidden="true"></div>
    <div class="glow glow-b" aria-hidden="true"></div>

  </div>
</MainLayout>

<style>
  /* ── Tokens ── */
  :root {
    --c-bg:        #080808;
    --c-surface:   #111111;
    --c-ink:       #f5f5f0;
    --c-ink-soft:  #b8b8b0;
    --c-ink-muted: rgba(245,245,240,0.38);
    --c-border:    rgba(255,255,255,0.08);
    --c-orange:    #f97316;
    --c-oglow:     rgba(249,115,22,0.18);
    --ease:        cubic-bezier(0.22,1,0.36,1);
    --dur:         0.26s;
    --radius:      1.5rem;
  }

  /* ── Shell ── */
 .insights-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--c-ink);

  /* Let MainLayout BrandLines + FloatingCanvas show through */
  background:
    linear-gradient(
      180deg,
      rgba(8, 8, 8, 0.92) 0%,
      rgba(8, 8, 8, 0.88) 45%,
      rgba(8, 8, 8, 0.94) 100%
    );
}

  .insights-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .insights-background :global(*) {
    pointer-events: none;
  }

  .insights-container {
    position: relative;
    z-index: 2;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem 8rem;
  }

  /* ── Glows ── */
  .glow {
    position: absolute;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(110px);
    z-index: 1;
  }

  .glow-a {
    width: 55vw;
    height: 55vw;
    max-width: 700px;
    max-height: 700px;
    top: -12%;
    left: -12%;
    background: radial-gradient(circle, rgba(249,115,22,0.09) 0%, transparent 70%);
  }

  .glow-b {
    width: 40vw;
    height: 40vw;
    max-width: 500px;
    max-height: 500px;
    top: 4%;
    right: -10%;
    background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%);
  }

  /* ── Top bar ── */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    margin-bottom: 5rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem 0.55rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--c-border);
    background: rgba(255,255,255,0.04);
    color: var(--c-ink-soft);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    backdrop-filter: blur(8px);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .back-btn:hover {
    background: var(--c-orange);
    color: #fff;
    border-color: var(--c-orange);
    transform: translateX(-2px);
    box-shadow: 0 8px 28px var(--c-oglow);
  }

  .back-btn svg {
    transition: transform var(--dur) var(--ease);
  }

  .back-btn:hover svg {
    transform: translateX(-2px);
  }

  .archive-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }

  /* ── Hero ── */
  .hero {
    max-width: 900px;
    margin-bottom: 4.5rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.75rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-orange);
  }

  .kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-orange);
    box-shadow: 0 0 10px var(--c-orange);
    flex-shrink: 0;
  }

  .hero h1 {
    font-size: clamp(2.8rem, 5.8vw, 6rem);
    line-height: 0.93;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: var(--c-ink);
    margin: 0 0 1.75rem;
  }

  .intro {
    max-width: 580px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--c-ink-soft);
    margin: 0 0 2.5rem;
  }

  /* ── Meta strip ── */
  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }

  .meta-strip span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }

  .strip-div {
    width: 1px;
    height: 1rem;
    background: var(--c-border);
    flex-shrink: 0;
  }

  /* ── Section label ── */
  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-label-text {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .section-label-line {
    height: 1px;
    flex: 1;
    background: linear-gradient(to right, var(--c-border), transparent);
  }

  /* ── Coming Soon Box ── */
  .coming-soon-box {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 4.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius);
    border: 1px solid var(--c-border);
    background:
      linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)),
      rgba(255,255,255,0.035);
    box-shadow: 0 24px 70px rgba(0,0,0,0.28);
    backdrop-filter: blur(16px);
    overflow: hidden;
  }

  .coming-soon-box::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top right, rgba(249,115,22,0.14), transparent 35%),
      radial-gradient(circle at bottom left, rgba(255,255,255,0.05), transparent 38%);
    pointer-events: none;
  }

  .coming-soon-box > * {
    position: relative;
    z-index: 1;
  }

  .coming-soon-content {
    max-width: 680px;
  }

  .coming-soon-kicker {
    margin: 0 0 0.75rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-orange);
  }

  .coming-soon-box h2 {
    margin: 0 0 0.75rem;
    color: var(--c-ink);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .coming-soon-box p {
    max-width: 620px;
    margin: 0;
    color: var(--c-ink-soft);
    line-height: 1.75;
  }

  .coming-soon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    flex-shrink: 0;
    padding: 0.85rem 1.15rem;
    border-radius: 999px;
    border: 1px solid rgba(249,115,22,0.45);
    background: rgba(249,115,22,0.12);
    color: var(--c-orange);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .coming-soon-link:hover {
    background: var(--c-orange);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 12px 34px var(--c-oglow);
  }

  .coming-soon-link span {
    transition: transform var(--dur) var(--ease);
  }

  .coming-soon-link:hover span {
    transform: translateX(3px);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .insights-container {
      padding: 0 1.25rem 6rem;
    }

    .topbar {
      padding-top: 1.75rem;
      margin-bottom: 3.5rem;
    }

    .archive-label {
      display: none;
    }

    .hero {
      margin-bottom: 3.5rem;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 12vw, 3.8rem);
      line-height: 0.95;
    }

    .intro {
      font-size: 0.97rem;
    }

    .strip-div {
      display: none;
    }

    .meta-strip {
      gap: 0.5rem;
    }

    .coming-soon-box {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 3rem;
    }

    .coming-soon-link {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .topbar {
      margin-bottom: 2.75rem;
    }

    .insights-container {
      padding-inline: 1rem;
    }

    .coming-soon-box {
      border-radius: 1rem;
    }
  }
</style>