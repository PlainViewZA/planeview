---
import MainLayout from '../layouts/MainLayout.astro';

---

<MainLayout
  title="Pricing | Plane View Collective"
  description="Clear, flexible pricing for website design, social media management, paid ads, SEO and more. Based in Cape Town, serving South Africa and beyond."
>
 

  <!-- Hero -->
  <section class="section page-hero">
    <div class="container container-narrow">
      <h1>Clear pricing.<br />Flexible scope.</h1>
      <p class="intro-text">
        Every project starts with a custom proposal, but these are our typical starting points to guide your expectations. All prices in ZAR.
      </p>
    </div>
  </section>

  <!-- Filter Bar -->
  <section class="filter-section">
    <div class="container">
      <div class="price-filter">
        <button class="pf-btn active" data-filter="all">All Services</button>
        <button class="pf-btn" data-filter="websites">Websites</button>
        <button class="pf-btn" data-filter="social">Social Media</button>
        <button class="pf-btn" data-filter="ads">Paid Ads</button>
        <button class="pf-btn" data-filter="seo">SEO</button>
        <button class="pf-btn" data-filter="quick">Quick Wins</button>
        <button class="pf-btn" data-filter="combo">Combo Deal</button>
      </div>
    </div>
  </section>

  <!-- Pricing Sections -->
  <div class="pricing-wrapper">
    <div class="container">
      <div class="pricing-stack">

        <!-- 01 Websites -->
        <article class="p-block" data-section="websites">
          <div class="p-block-header">
            <div>
              <span class="p-label">01 — Websites</span>
              <h2 class="p-title">Website Design & Development</h2>
              <p class="p-desc">
                Fast, clean, mobile-ready websites built to convert visitors into enquiries.
              </p>
            </div>
            <span class="p-type">Starting from</span>
          </div>

          <div class="p-rows">
            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Starter</span>
                <span class="p-row-sub">Best for small businesses getting online for the first time</span>
                <span class="p-row-includes">Typically up to 5 pages · Mobile-ready · Contact form · Basic SEO</span>
                <a href="/contact?package=website-starter" class="p-row-cta">Get a Quote →</a>
              </div>
              <span class="p-row-price">From R4,500</span>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Growth</span>
                <span class="p-row-sub">For businesses ready to scale their online presence</span>
                <span class="p-row-includes">Typically up to 10 pages · Blog setup · Enhanced layout · 2 revision rounds</span>
                <a href="/contact?package=website-growth" class="p-row-cta">Get a Quote →</a>
              </div>
              <span class="p-row-price">From R8,500</span>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Professional</span>
                <span class="p-row-sub">Full-featured site with performance and SEO built in</span>
                <span class="p-row-includes">Typically up to 15 pages · Speed optimisation · Full on-page SEO</span>
                <a href="/contact?package=website-professional" class="p-row-cta">Get a Quote →</a>
              </div>
              <span class="p-row-price">From R12,000</span>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Online Store — Starter</span>
                <span class="p-row-sub">Start selling online fast</span>
                <span class="p-row-includes">Typically up to 20 products · Payment integration · Mobile checkout</span>
                <a href="/contact?package=store-starter" class="p-row-cta">Get a Quote →</a>
              </div>
              <span class="p-row-price">From R14,500</span>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Online Store — Growth</span>
                <span class="p-row-sub">Larger catalogue with full e-commerce features</span>
                <span class="p-row-includes">Typically up to 40 products · Coupons · Shipping rules · Full setup</span>
                <a href="/contact?package=store-growth" class="p-row-cta">Get a Quote →</a>
              </div>
              <span class="p-row-price">From R18,000</span>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Custom Solution</span>
                <span class="p-row-sub">For advanced functionality, integrations, or larger digital builds</span>
                <span class="p-row-includes">Custom features · API integrations · Automation · Scalable architecture</span>
                <a href="/contact?package=custom-web" class="p-row-cta">Request a Custom Quote →</a>
              </div>
              <span class="p-row-price">From R25,000+</span>
            </div>
          </div>

          <div class="p-note">
            <strong>Flexible by design.</strong> Final pricing depends on project scope, features, integrations, and complexity. These packages are starting points and can scale based on your needs.
          </div>

          <div class="p-sub-block">
            <div class="p-sub-header">
              <span class="p-label">Maintenance Plans</span>
              <span class="p-type">Monthly from</span>
            </div>

            <div class="p-rows">
              <div class="p-row">
                <div class="p-row-info">
                  <span class="p-row-name">Basic Care</span>
                  <span class="p-row-includes">CMS updates · Backups · Security monitoring · Minor edits</span>
                  <a href="/contact?package=maintenance-basic" class="p-row-cta">Get a Quote →</a>
                </div>
                <div class="p-row-price">From R750 <span class="p-per">/ month</span></div>
              </div>

              <div class="p-row">
                <div class="p-row-info">
                  <span class="p-row-name">Growth Care</span>
                  <span class="p-row-includes">Everything in Basic + up to 1 hour of changes per month + monthly report</span>
                  <a href="/contact?package=maintenance-growth" class="p-row-cta">Get a Quote →</a>
                </div>
                <div class="p-row-price">From R1,500 <span class="p-per">/ month</span></div>
              </div>
            </div>
          </div>
        </article>

        <!-- 02 Social -->
        <article class="p-block" data-section="social">
          <div class="p-block-header">
            <div>
              <span class="p-label">02 — Social Media</span>
              <h2 class="p-title">Social Media Management</h2>
              <p class="p-desc">
                Content, visuals, and captions — done for you every month, with strategy behind every post.
              </p>
            </div>
            <span class="p-type">Monthly from</span>
          </div>

          <div class="p-rows">
            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Starter</span>
                <span class="p-row-sub">Ideal for businesses that need consistent, professional presence</span>
                <span class="p-row-includes">6–8 posts · Branded visuals · Caption writing · Hashtag strategy</span>
                <a href="/contact?package=social-starter" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R4,500 <span class="p-per">/ month</span></div>
            </div>

            <div class="p-row p-row--featured">
              <div class="p-row-info">
                <span class="p-row-name">Growth <span class="p-badge">Most Popular</span></span>
                <span class="p-row-sub">The sweet spot for businesses ready to grow consistently</span>
                <span class="p-row-includes">10–12 posts · Custom design + brand alignment · Caption strategy + CTAs · Basic engagement · Monthly report</span>
                <a href="/contact?package=social-growth" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R7,500 <span class="p-per">/ month</span></div>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Authority</span>
                <span class="p-row-sub">Full management for brands that want stronger positioning and deeper support</span>
                <span class="p-row-includes">14–16 posts · Content calendar · Full engagement · Stories (2–4/week) · Report + strategy call</span>
                <a href="/contact?package=social-authority" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R11,000 <span class="p-per">/ month</span></div>
            </div>
          </div>

          <div class="p-note">
            Pricing may vary based on content volume, number of platforms, campaign support, and approval workflow.
          </div>
        </article>

        <!-- 03 Ads -->
        <article class="p-block" data-section="ads">
          <div class="p-block-header">
            <div>
              <span class="p-label">03 — Paid Ads</span>
              <h2 class="p-title">Paid Ads Management</h2>
              <p class="p-desc">
                We run and optimise your campaigns. Ad spend is paid directly to the platform and is not included in our fee.
              </p>
            </div>
            <span class="p-type">Monthly from</span>
          </div>

          <div class="p-rows">
            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Meta Ads</span>
                <span class="p-row-sub">Facebook & Instagram · Ad spend billed separately by Meta</span>
                <a href="/contact?package=ads-meta" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R2,500 <span class="p-per">/ month</span></div>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Google Ads</span>
                <span class="p-row-sub">Ad spend billed separately by Google</span>
                <a href="/contact?package=ads-google" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R3,500 <span class="p-per">/ month</span></div>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">LinkedIn Ads</span>
                <span class="p-row-sub">Ad spend billed separately by LinkedIn</span>
                <a href="/contact?package=ads-linkedin" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R3,000 <span class="p-per">/ month</span></div>
            </div>
          </div>

          <div class="p-note">
            <strong>What is ad spend?</strong> It’s the budget you pay directly to Facebook, Google, or LinkedIn to show your ads. We usually recommend a minimum of R3,000–R5,000/month in ad spend for meaningful results.
          </div>
        </article>

        <!-- 04 SEO -->
        <article class="p-block" data-section="seo">
          <div class="p-block-header">
            <div>
              <span class="p-label">04 — SEO</span>
              <h2 class="p-title">SEO & Search Visibility</h2>
              <p class="p-desc">
                Monthly work to help your business get found on Google and build long-term organic growth.
              </p>
            </div>
            <span class="p-type">Monthly from</span>
          </div>

          <div class="p-rows">
            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Local SEO</span>
                <span class="p-row-sub">Ideal for businesses serving a specific city or region</span>
                <span class="p-row-includes">On-page optimisation · Local citations · Google Business setup</span>
                <a href="/contact?package=seo-local" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R5,000 <span class="p-per">/ month</span></div>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Growth SEO</span>
                <span class="p-row-sub">For businesses competing nationally or aiming for stronger reach</span>
                <span class="p-row-includes">Everything in Local + backlink building + content + reporting</span>
                <a href="/contact?package=seo-growth" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R9,500 <span class="p-per">/ month</span></div>
            </div>

            <div class="p-row">
              <div class="p-row-info">
                <span class="p-row-name">Advanced SEO</span>
                <span class="p-row-sub">Full-scale strategy for competitive markets and long-term growth</span>
                <span class="p-row-includes">Full strategy + monthly content creation + advanced reporting</span>
                <a href="/contact?package=seo-advanced" class="p-row-cta">Get a Quote →</a>
              </div>
              <div class="p-row-price">From R13,000 <span class="p-per">/ month</span></div>
            </div>
          </div>

          <div class="p-note">
            <strong>SEO takes time.</strong> Most businesses start seeing meaningful movement in 3–6 months. Scope can vary depending on competition, goals, and content requirements.
          </div>
        </article>

        <!-- 05 Quick Wins -->
        <article class="p-block" data-section="quick">
          <div class="p-block-header">
            <div>
              <span class="p-label">05 — Quick Wins</span>
              <h2 class="p-title">Standalone Services</h2>
              <p class="p-desc">
                Fast turnaround on focused deliverables.
              </p>
            </div>
            <span class="p-type">Starting from</span>
          </div>

          <div class="p-addon-grid">
            <div class="p-addon">
              <div>
                <span class="p-addon-name">Landing Page</span>
                <span class="p-addon-sub">Standard single-page build</span>
              </div>
              <span class="p-addon-price">From R2,000</span>
            </div>

            <div class="p-addon">
              <div>
                <span class="p-addon-name">Landing Page — Premium</span>
                <span class="p-addon-sub">Conversion-focused with copy</span>
              </div>
              <span class="p-addon-price">From R3,500</span>
            </div>

            <div class="p-addon">
              <div>
                <span class="p-addon-name">Email Marketing Setup</span>
                <span class="p-addon-sub">Once-off campaign setup</span>
              </div>
              <span class="p-addon-price">From R2,000</span>
            </div>

            <div class="p-addon">
              <div>
                <span class="p-addon-name">Monthly Email Campaign</span>
                <span class="p-addon-sub">Per campaign, per month</span>
              </div>
              <span class="p-addon-price">From R2,500</span>
            </div>

            <div class="p-addon">
              <div>
                <span class="p-addon-name">Extra Revision Round</span>
                <span class="p-addon-sub">Per round, any project</span>
              </div>
              <span class="p-addon-price">R500</span>
            </div>

            <div class="p-addon">
              <div>
                <span class="p-addon-name">Rush Delivery</span>
                <span class="p-addon-sub">Under 5 working days</span>
              </div>
              <span class="p-addon-price">+20%</span>
            </div>
          </div>

          <div class="p-note">
            Standalone pricing reflects typical starting points. Final pricing may vary depending on turnaround time, scope, and content requirements.
          </div>

          <a href="/contact?package=standalone" class="p-addon-cta">Enquire about standalone services →</a>
        </article>

      </div>
    </div>
  </div>

  <!-- Combo -->
  <section class="combo-section" data-section="combo">
    <div class="container">
      <div class="combo-inner">
        <div class="combo-left">
          <span class="combo-eyebrow">Best Value</span>
          <h2 class="combo-title">Combination Package</h2>
          <p class="combo-desc">
            Pair any website package with a social media management plan and receive R6,300 worth of launch essentials included at no extra cost.
          </p>

          <div class="combo-free-list">
            <div class="combo-free-item">
              <span class="combo-free-name">Logo Design</span>
              <span class="combo-free-val">R2,000</span>
            </div>
            <div class="combo-free-item">
              <span class="combo-free-name">Brand Style Guide</span>
              <span class="combo-free-val">R3,500</span>
            </div>
            <div class="combo-free-item">
              <span class="combo-free-name">Copywriting (up to 1 page)</span>
              <span class="combo-free-val">R800</span>
            </div>
          </div>

          <a href="/contact?package=combo" class="btn btn-primary btn-lg" style="margin-top:var(--spacing-xl);">
            Claim This Package
            <span class="arrow">→</span>
          </a>
        </div>

        <div class="combo-right">
          <div class="combo-value-card">
            <span class="combo-value-label">Included Value</span>
            <span class="combo-value-number">R6,300</span>
            <span class="combo-value-sub">
              Included at no extra cost when you combine any website package with a social media management plan.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- How it works -->
<section class="section process-section">
  <div class="container container-narrow">
    <div class="section-header">
      <h2>How it works</h2>
      <p class="lead">Simple process, clear expectations on both sides.</p>
    </div>

    <div class="process-panel">
      <div class="how-steps">
        <div class="how-step">
          <span class="how-num">01</span>
          <h4>We talk</h4>
          <p>Tell us what you need. No forms, no automated quotes, just a real conversation about your business.</p>
        </div>

        <div class="how-step">
          <span class="how-num">02</span>
          <h4>We propose</h4>
          <p>You get a clear, itemised proposal with exact pricing based on your scope, priorities, and requirements.</p>
        </div>

        <div class="how-step">
          <span class="how-num">03</span>
          <h4>We start</h4>
          <p>50% deposit to begin, balance on delivery. Larger projects can use milestone payments.</p>
        </div>

        <div class="how-step">
          <span class="how-num">04</span>
          <h4>You own it</h4>
          <p>Once paid, everything is yours. Files, code, and accounts are all transferred to you on final payment.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section final-note">
  <div class="container container-narrow">
    <div class="final-note-card">
      <p class="final-note-text">
        Pricing shown reflects typical starting points. Final quotes are tailored based on your business needs, features, integrations, timelines, and project complexity.
      </p>
    </div>
  </div>
</section>


</MainLayout>

<style>
  /* ── Filter ── */
  .filter-section {
    padding: var(--spacing-md) 0 var(--spacing-xl);
  }

  .price-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pf-btn {
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: var(--font-primary);
    border-radius: var(--radius-full);
    border: 1.5px solid var(--border-subtle);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .pf-btn:hover,
  .pf-btn.active {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--bg-primary);
  }

  /* ── Pricing Stack ── */
  .pricing-wrapper {
    padding-bottom: 0;
  }

  .pricing-stack {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1px;
  }

  /* ── Price Block ── */
  .p-block {
    background: var(--bg-card);
    padding: var(--spacing-2xl);
  }

  .p-block-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    flex-wrap: wrap;
  }

  .p-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel-blue);
    margin-bottom: 0.5rem;
  }

  .p-title {
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .p-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: 520px;
  }

  .p-type {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface-hover);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Price Rows ── */
  .p-rows {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .p-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--spacing-lg);
    align-items: center;
    padding: var(--spacing-md) var(--spacing-lg);
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--transition-base);
  }

  .p-row:last-child { border-bottom: none; }
  .p-row:hover { background: var(--surface-hover); }

  .p-row--featured {
    background: rgba(47, 111, 237, 0.06);
    border-left: 3px solid var(--color-steel-blue);
  }

  .p-row--featured:hover { background: rgba(47, 111, 237, 0.10); }

  .p-row-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .p-row-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .p-row-sub {
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .p-row-includes {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-top: 4px;
    line-height: 1.5;
  }

  .p-row-price {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-align: right;
    white-space: nowrap;
  }

  .p-per {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    display: block;
    margin-top: 1px;
  }

  .p-badge {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--color-steel-blue);
    color: var(--color-pure-white);
  }

  .p-row-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--spacing-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-steel-blue);
    text-decoration: none;
    transition: gap var(--transition-base);
  }

  .p-row-cta:hover { gap: 10px; color: var(--color-steel-blue); }

  .p-note {
    margin-top: var(--spacing-md);
    padding: var(--spacing-sm) var(--spacing-md);
    background: rgba(47, 111, 237, 0.06);
    border-left: 3px solid var(--color-steel-blue);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .p-note strong { color: var(--text-primary); }

  /* ── Sub block (maintenance) ── */
  .p-sub-block { margin-top: var(--spacing-xl); }

  .p-sub-header {
    display: flex;
