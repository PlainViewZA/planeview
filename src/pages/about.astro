---
import MainLayout from '../layouts/MainLayout.astro';


const nameMeaning = [
  {
    title: 'Plane View',
    description:
      'Seeing the business from above before making decisions. Strategy first, then creative direction.'
  },
  {
    title: 'Collective',
    description:
      'Different skills working together across design, websites, content, marketing, and digital systems.'
  }
];

const beliefs = [
  {
    number: '01',
    title: 'Clarity is strategy',
    description:
      'If people do not understand what you do, they will not know why they should choose you. We simplify the message before we amplify it.'
  },
  {
    number: '02',
    title: 'Creativity must serve a purpose',
    description:
      'Design should do more than look good. Every visual, word, and interaction should support the business goal.'
  },
  {
    number: '03',
    title: 'People connect with people',
    description:
      'We create work that feels human, honest, and easy to engage with.'
  },
  {
    number: '04',
    title: 'Execution matters',
    description:
      'Ideas only become valuable when they are planned, built, launched, and improved properly.'
  }
];

const collective = [
  {
    name: 'Aidan',
    role: 'Websites & Digital Systems',
    description:
      'Focuses on website structure, implementation, digital workflows, deployment, and making ideas work technically.'
  },
  {
    name: 'Euan',
    role: 'Design, Video & Content',
    description:
      'Supports social media content, visual design, video editing, creative production, and day-to-day content execution.'
  },

];

const reasons = [
  'Small business focused',
  'Strategy before visuals',
  'Creative and technical thinking',
  'Clear communication',
  'Flexible digital support',
  'Built for long-term growth'
];

const faqs = [
  {
    question: 'Do you only work with businesses in Cape Town?',
    answer:
      'We are Cape Town based, but we can support businesses beyond Cape Town depending on the project and communication requirements.'
  },
  {
    question: 'Do you only do marketing?',
    answer:
      'No. Plane View Collective combines marketing, websites, design, content, and digital systems so businesses can build a stronger overall presence.'
  },
  {
    question: 'Can you help if my brand is still early?',
    answer:
      'Yes. We can help with brand clarity, messaging, website structure, social media direction, and the digital foundations needed to look more credible.'
  },
  {
    question: 'What makes Plane View different?',
    answer:
      'We approach projects from both a creative and technical perspective. The goal is not just to make things look good, but to make the brand easier to understand and easier to choose.'
  },
  {
    question: 'How do we start working together?',
    answer:
      'You can start by contacting us with what you need help with. From there, we can understand the project, recommend the next step, and guide you through the process.'
  }
];
---

<MainLayout
  title="About | Plane View Collective"
  description="Plane View Collective is a Cape Town based marketing, website, content, and digital systems studio helping small businesses become clearer, more credible, and easier to choose."
>



    <!-- HERO -->
    <section class="section about-hero">
      <div class="container">
        <div class="about-hero-grid">
          <div class="about-hero-copy" data-reveal>
            <p class="eyebrow">About Plane View Collective</p>

            <h1>A collective helping small businesses turn ideas into stronger digital experiences..</h1>

            <p class="hero-lead">
              Plane View Collective is a Cape Town-based studio working across websites, brand direction, content, marketing, and digital systems. We help growing businesses present themselves with more confidence, consistency, and purpose.
            </p>

            <div class="hero-actions">
              <a href="/contact" class="btn btn-primary btn-lg">
                Start a Project <span class="arrow">→</span>
              </a>
              <a href="/work" class="btn btn-secondary btn-lg btn-orange-hover">
                View Our Work
              </a>
            </div>
          </div>

          <div class="about-hero-card  spotlight-card" data-reveal>
            <p class="card-kicker">Our focus</p>
            <h2>Clarity from above.</h2>
            <p>
              We step back, understand the full picture, then create the strategy, visuals, content, and digital structure your business needs to move forward.
            </p>

            <div class="focus-list">
              <span>Strategy</span>
              <span>Websites</span>
              <span>Content</span>
              <span>Marketing</span>
              <span>Digital Systems</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ORIGIN STORY -->
    <section class="section section-surface origin-section">
      <div class="container">
        <div class="split-header" data-reveal>
          <div>
            <p class="eyebrow">Why we exist</p>
            <h2>Good businesses should not look unfinished online.</h2>
          </div>

          <div class="origin-copy">
            <p>
            We started Plane View because many small businesses have real skill, strong ideas, and valuable services, but their online presence does not always reflect that. Our job is to close that gap through better messaging, stronger visuals, functional websites, and practical digital support.
            </p>
        
          </div>
        </div>
      </div>
    </section>

    <!-- NAME MEANING -->
    <section class="section meaning-section">
      <div class="container">
        <div class="section-header" data-reveal>
          <p class="eyebrow">The meaning behind the name</p>
          <h2>Plane View is about perspective. Collective is about collaboration.</h2>
          <p>
            The name reminds us to zoom out before creating. Strong digital work does not come from guessing. It comes from understanding the full picture, then bringing the right skills together to execute properly.
        </div>

        <div class="meaning-grid">
          {nameMeaning.map((item) => (
            <div class="meaning-card spotlight-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PERSONALITY / TONE -->
    <section class="section high-contrast tone-section">
      <div class="container">
        <div class="tone-grid ">
          <div data-reveal>
            <p class="eyebrow">Who we are</p>
            <h2>Practical, human, and intentional.</h2>
            <p class="lead">
              We are not trying to make brands sound bigger than they are. We help them communicate better, look more professional, and show up with confidence while still feeling real.
            </p>
          </div>

          <div class="tone-list " data-reveal>
            <div class="tone-item  spotlight-card">
              <strong>Conversational</strong>
              <span>not corporate for the sake of sounding impressive</span>
            </div>
            <div class="tone-item  spotlight-card">
              <strong>Clear</strong>
              <span>not filled with unnecessary jargon</span>
            </div>
            <div class="tone-item  spotlight-card">
              <strong>Warm</strong>
              <span>not robotic or disconnected</span>
            </div>
            <div class="tone-item  spotlight-card">
              <strong>Honest</strong>
              <span>not over-polished or fake</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BELIEFS -->
    <section class="section beliefs-section">
      <div class="container">
        <div class="section-header" data-reveal>
          <p class="eyebrow">What we believe</p>
          <h2>Our values shape how we think, create, and deliver.</h2>
          <p>
            These are not just words for the website. They guide how we approach client work, communication, and execution.
          </p>
        </div>

        <div class="belief-grid">
          {beliefs.map((belief) => (
            <div class="belief-card  spotlight-card" data-reveal>
              <span>{belief.number}</span>
              <h3>{belief.title}</h3>
              <p>{belief.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

<!-- MEET THE COLLECTIVE -->
<section class="section section-surface collective-section">
  <div class="container">
    <div class="split-header" data-reveal>
      <div>
        <p class="eyebrow">Meet the collective</p>
        <h2>A multidisciplinary team built around practical digital execution.</h2>
      </div>
    </div>
 <div class="collective-grid">
      {collective.map((member) => (
        <article class="member-card  spotlight-card" data-reveal>
          <div class="member-avatar" aria-hidden="true">
            <span>{member.name.charAt(0)}</span>
          </div>
          <div class="member-content">
            <h3>{member.name}</h3>
            <p class="member-role">{member.role}</p>
            <p>{member.description}</p>
          </div>
        </article>
      ))}
  </div>
</div>  <!-- ← this closing tag was missing -->
</section>

    <!-- WHY WORK WITH US -->
    <section class="section why-section">
      <div class="container">
        <div class="why-grid ">
          <div class="why-copy " data-reveal>
            <p class="eyebrow">Why work with us?</p>
            <h2>We help close the gap between what your business offers and how it appears online.</h2>
            <p>
              Many small businesses already have the skill, service, or product. What they need is a stronger way to present it. We help shape the message, improve the visuals, build the website, and create the systems that make the business easier to trust and easier to choose.
            </p>
            <a href="/services" class="btn btn-secondary">
              Explore Services
            </a>
          </div>

          <div class="reason-list" data-reveal>
            {reasons.map((reason) => (
              <div class="reason-item  spotlight-card">
                <span>✓</span>
                <p>{reason}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

  
<!-- FAQ -->
<section class="section section-surface faq-section">
  <div class="container container-narrow">
    <div class="section-header" data-reveal>
      <p class="eyebrow">Questions people ask</p>
      <h2>Before we work together, here is what you may want to know.</h2>
    </div>

    <div class="faq-list " data-reveal>
      {faqs.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            {item.question}
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>

          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>


    <!-- FINAL CTA -->
    <section class="section final-cta-section">
      <div class="container">
        <div class="final-cta" data-reveal>
          <p class="eyebrow">Ready to build with clarity?</p>
          <h2>Let’s make your online presence match the quality of your business.</h2>
          <p>
           Tell us what you are working on and we will help you map the most practical next step..
          </p>

          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary btn-lg">
              Start a Project <span class="arrow">→</span>
            </a>
            <a href="/pricing" class="btn btn-outline btn-lg">
              View Pricing
            </a>
          </div>
        </div>
      </div>
    </section>



</MainLayout>

<style>
  /* =============================================
     SHARED
     ============================================= */

  .section-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto var(--spacing-2xl);
  }

  .section-header p {
    margin-left: auto;
    margin-right: auto;
    color: var(--text-secondary);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-steel-blue);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    max-width: 100%;
  }

  .eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--color-steel-blue);
    border-radius: var(--radius-full);
  }

  .lead {
    color: inherit;
    opacity: 0.78;
    font-size: clamp(1.125rem, 2vw, 1.3rem);
    line-height: 1.7;
    max-width: 700px;
  }

  .section-surface {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .split-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: var(--spacing-2xl);
    align-items: start;
    margin-bottom: var(--spacing-2xl);
  }

  .split-header h2 {
    margin: 0;
  }

  .split-header > p,
  .origin-copy p {
    color: var(--text-secondary);
    max-width: 100%;
  }

  /* =============================================
     HERO
     ============================================= */

  .about-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--spacing-3xl) + 1rem);
  }

  .about-hero::before {
    content: '';
    position: absolute;
    inset: 12% auto auto -10%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(47, 111, 237, 0.22), transparent 65%);
    pointer-events: none;
  }

  .about-hero::after {
    content: '';
    position: absolute;
    inset: auto -12% 8% auto;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(255, 106, 0, 0.16), transparent 68%);
    pointer-events: none;
  }

  .about-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.75fr);
    gap: var(--spacing-3xl);
    align-items: center;
  }

  .about-hero-copy h1 {
    max-width: 900px;
    margin-bottom: var(--spacing-lg);
  }

  .hero-lead {
    color: var(--text-secondary);
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.7;
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    margin-top: var(--spacing-xl);
  }

  .about-hero-card {
    overflow: hidden;
    padding: var(--spacing-xl);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(47, 111, 237, 0.13), transparent 45%),
      var(--bg-card);
    box-shadow: var(--shadow-lift);
  }

  .card-kicker {
    color: var(--color-signal-orange);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-sm);
  }

  .about-hero-card p {
    color: var(--text-secondary);
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--spacing-xl);
  }

  .focus-list span {
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    background: var(--surface-hover);
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* =============================================
     ORIGIN
     ============================================= */

  .origin-section .split-header {
    margin-bottom: 0;
  }

  .origin-copy {
    display: grid;
    gap: var(--spacing-md);
    align-self: start;
    padding-top: 3.1rem;
  }

  .origin-copy p {
    margin: 0;
  }

  /* =============================================
     NAME MEANING
     ============================================= */

  .meaning-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-xl);
  }

  .meaning-card {
    min-height: 260px;
    padding: var(--spacing-xl);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    background: var(--bg-card);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .meaning-card h3 {
    color: var(--color-steel-blue);
  }

  .meaning-card p {
    color: var(--text-secondary);
    max-width: 100%;
  }

  /* =============================================
     TONE
     ============================================= */

  .tone-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1fr);
    gap: var(--spacing-3xl);
    align-items: start;
  }

  .tone-section .eyebrow,
  .tone-section h2,
  .tone-section h3,
  .tone-section p {
    color: inherit;
  }

  .tone-list {
    display: grid;
    gap: var(--spacing-md);
  }

  .tone-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    padding: var(--spacing-md);
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, currentColor 5%, transparent);
  }

  .tone-item strong {
    color: inherit;
    font-size: 1.125rem;
  }

  .tone-item span {
    color: inherit;
    opacity: 0.7;
    font-size: 0.9375rem;
  }

  /* =============================================
     BELIEFS
     ============================================= */

  .belief-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .belief-card {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-lg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .belief-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-medium);
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-card);
  }

  .belief-card span {
    color: var(--color-signal-orange);
    font-weight: 800;
    margin-bottom: var(--spacing-xl);
  }

  .belief-card h3 {
    font-size: 1.35rem;
  }

  .belief-card p {
    color: var(--text-secondary);
    max-width: 100%;
    margin-bottom: 0;
  }

  /* =============================================
     COLLECTIVE
     ============================================= */

  .collective-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-lg);
    align-items: stretch;
  }

  .member-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    min-height: 340px;
    padding: var(--spacing-xl);
    border: 1px solid var(--border-subtle);
    border-radius: 22px;
    background: var(--bg-card);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .member-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-medium);
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-card);
  }

  .member-avatar {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-medium);
    border-radius: 16px;
    background:
      radial-gradient(circle at 30% 30%, rgba(47, 111, 237, 0.35), transparent 45%),
      var(--surface-hover);
  }

  .member-avatar span {
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .member-card h3 {
    margin-bottom: 0.25rem;
    font-size: clamp(1.35rem, 2vw, 1.65rem);
  }

  .member-role {
    color: var(--color-steel-blue);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
    margin-bottom: var(--spacing-md);
  }

  .member-card p:not(.member-role) {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    max-width: 100%;
    margin-bottom: 0;
  }

  /* =============================================
     WHY
     ============================================= */

  .why-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(320px, 1fr);
    gap: var(--spacing-3xl);
    align-items: center;
  }

  .why-copy p {
    color: var(--text-secondary);
  }

  .why-copy .btn {
    margin-top: var(--spacing-md);
  }

  .reason-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
  }

  .reason-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }

  .reason-item span {
    width: 28px;
    height: 28px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: var(--radius-full);
    background: rgba(47, 111, 237, 0.14);
    color: var(--color-steel-blue);
    font-weight: 800;
  }

  .reason-item p {
    margin: 0;
    color: var(--text-primary);
    font-weight: 600;
  }

  /* =============================================
     FAQ
     ============================================= */

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
  }

  .faq-item {
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background: var(--surface-hover);
  }

  .faq-item[open] .faq-question {
    background: rgba(47, 111, 237, 0.08);
    color: var(--color-steel-blue);
  }

  .faq-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid var(--border-medium);
    color: var(--text-primary);
    transition: all var(--transition-base);
  }

  .faq-item[open] .faq-icon {
    background: var(--color-steel-blue);
    border-color: var(--color-steel-blue);
    color: var(--color-pure-white);
    transform: rotate(45deg);
  }

  .icon-minus {
    display: none;
  }

  .faq-answer {
    padding: 0 var(--spacing-xl) var(--spacing-xl);
    animation: faq-open 0.2s ease;
  }

  .faq-answer p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0;
    max-width: 68ch;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =============================================
     FINAL CTA
     ============================================= */

  .final-cta-section {
    padding-top: var(--spacing-2xl);
  }

  .final-cta {
    position: relative;
    overflow: hidden;
    padding: var(--spacing-3xl);
    border: 1px solid var(--border-subtle);
    border-radius: 32px;
    background:
