---
import MainLayout from '../layouts/MainLayout.astro';




// ============================================================
//  EDIT THIS SECTION ONLY — everything else stays the same
// ============================================================


const page = {
  metaTitle: "FAQ | Plane View Collective",
  metaDescription: "Answers to the questions we get asked most — about our process, pricing, timelines, and how we work.",
  heading: "Frequently Asked Questions",
  subheading: "Everything you need to know before we get started.",
};

const categories = [
  {
    id: "working-with-us",
    label: "Working With Us",
    faqs: [
      {
        question: "How do we get started?",
        answer: "Reach out via our contact page or email us directly at info@planeview.co.za. We'll set up a short discovery call to understand your project, then come back with a proposal and clear pricing.",
      },
      {
        question: "Do you work with clients outside Cape Town?",
        answer: "Yes. We're based in Cape Town but work with clients across South Africa and internationally. Most of our process is remote-friendly with discovery calls, feedback rounds, and final delivery all happen digitally.",
      },
      {
        question: "Will we have a single point of contact?",
        answer: "Yes. You'll work directly with the people doing the work, not an account manager relaying messages. Clear communication is one of the things we're most deliberate about.",
      },
      {
        question: "Can you work with our existing brand?",
        answer: "Absolutely. Not every project starts from scratch. If you have an existing brand you're happy with, we can work within it for websites, campaigns, or content. We'll flag it honestly if we think something needs fixing.",
      },
    ],
  },
  {
    id: "pricing",
    label: "Pricing & Timelines",
    faqs: [
      {
        question: "How much does a project cost?",
        answer: "It depends on scope. Brand identity projects typically start from R15,000. Websites from R25,000. Ongoing marketing retainers are scoped monthly. We'll always give you a clear, itemised proposal before anything is agreed.",
      },
      {
        question: "Do you require a deposit?",
        answer: "Yes. We require a 50% deposit to begin work, with the balance due on delivery. For larger projects we can structure milestone-based payments and this will be outlined in your proposal.",
      },
      {
        question: "How long does a project take?",
        answer: "Brand identity: 3–5 weeks. Websites: 4–8 weeks depending on scope. Timelines depend on how quickly feedback is turned around on your side too. We'll agree on clear deadlines at the start and hold both sides to them.",
      },
    ],
  },
  {
    id: "seo-results",
    label: "SEO & Results",
    faqs: [
      {
        question: "How long does it take to see results from digital marketing?",
        answer: "Paid advertising: 1–4 weeks for initial data and optimisation. Social media growth: 2–3 months for momentum. SEO and organic traffic: 3–6 months minimum. Anyone promising overnight results isn't being straight with you. Good marketing is a compound effect — it builds over time.",
      },
      {
        question: "Do you guarantee results?",
        answer: "No one can guarantee specific rankings or sales numbers and anyone who does is misleading you. What we do guarantee: strategic thinking, consistent execution, and transparent reporting. We focus on the controllable actions that drive real results over time.",
      },
      {
        question: "How do I know if I need a marketing agency?",
        answer: "You probably need one if you're posting inconsistently, your current efforts aren't bringing in leads, you're about to launch something and need it done right, or marketing feels like guesswork rather than strategy. That's usually the sign.",
      },
      {
        question: "How much does it cost to hire a marketing agency in Cape Town?",
        answer: "Marketing agency pricing in Cape Town typically ranges from R8,000 to R50,000+ per month depending on what you need. Brand identity projects start around R15,000. Custom websites from R25,000. Monthly retainers for social media, content, and ads usually sit between R12,000–R30,000. We're always transparent upfront — no hidden fees, no surprises.",
      },
    ],
  },
  {
    id: "deliverables",
    label: "Deliverables & Process",
    faqs: [
      {
        question: "Who owns the work once it's delivered?",
        answer: "It’s all yours. Once the final invoice is settled, you own every bit of it, the logos, the source files, the website code, the ad creatives, the copy of everything. We transfer all rights to you, so you can use, modify, or build on it however you like without any restrictions.",
      },
      {
        question: "Do you offer ongoing support after launch?",
        answer: "Yes. We offer monthly retainers for ongoing marketing, content, and website maintenance. We can also do ad-hoc support on request. Most clients find it useful to have us on a retained basis rather than re-briefing from scratch each time.",
      },
      {
        question: "Do you handle strategy or just execution?",
        answer: "Both. We're not a production house that takes a brief and turns it around. We think about the problem first — who the audience is, what the brand needs to communicate, and what success looks like — then we execute against that thinking.",
      },
    ],
  },
];

// ============================================================
---

<MainLayout title={page.metaTitle} description={page.metaDescription}>

 

  <!-- Hero -->
  <section class="section page-hero">
    <div class="container container-narrow">
      <h1>{page.heading}</h1>
      <p class="intro-text">{page.subheading}</p>
    </div>
  </section>

  <!-- FAQ Body -->
  <section class="section faq-section">
    <div class="container">
      <div class="faq-layout">

        <!-- Sticky category nav -->
        <aside class="faq-nav-col">
          <div class="faq-nav-inner">
            <p class="faq-nav-label">Categories</p>
            <nav aria-label="FAQ categories">
              {categories.map((cat) => (
                <a href={`#${cat.id}`} class="faq-nav-link">{cat.label}</a>
              ))}
            </nav>
        
         
        </aside>

        <!-- FAQ categories -->
        <div class="faq-content-col">
          {categories.map((cat) => (
            <div class="faq-category" id={cat.id}>
              <h2 class="faq-category-heading">{cat.label}</h2>
              <div class="faq-list">
                {cat.faqs.map((faq, i) => (
                  <details class="faq-item" name="faq-group">
                    <summary class="faq-question">
                      <span>{faq.question}</span>
                      <span class="faq-icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path class="icon-plus"  d="M10 4V16M4 10H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                          <path class="icon-minus" d="M4 10H16"          stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </span>
                    </summary>
                    <div class="faq-answer">
                      <p>{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section faq-cta-strip">
    <div class="container">
      <div class="cta-box">
        <div class="skeleton-line"></div>
        <h2>Didn't find your answer?</h2>
        <p>Send us a message and we'll get back to you within 24 hours.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary btn-lg">
            Contact Us
            <span class="arrow">→</span>
          </a>
          <a href="mailto:info@planeview.co.za" class="btn btn-outline btn-lg">
            info@planeview.co.za
          </a>

        </div>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  .intro-text {
    font-size: 1.375rem;
    line-height: 1.6;
    color: rgba(245, 245, 245, 0.72);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Layout */
  .faq-section {
    padding-top: 0;
    background: var(--color-jet-black);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--spacing-3xl);
    align-items: start;
  }

  /* Sidebar nav */
  .faq-nav-col {
    position: sticky;
    top: calc(var(--nav-height, 85px) + var(--spacing-lg));
  }

  .faq-nav-inner {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .faq-nav-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(245, 245, 245, 0.55);
    margin: 0;
  }

  .faq-nav-link {
    display: block;
    padding: 9px 12px;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(245, 245, 245, 0.68);
    text-decoration: none;
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    transition: all var(--transition-fast);
  }

  .faq-nav-link:hover {
    color: var(--color-sunset-orange);
    background: rgba(255, 122, 24, 0.12);
    border-left-color: rgba(255, 122, 24, 0.45);
  }

  .faq-nav-link.active {
    color: var(--color-sunset-orange);
    background: rgba(255, 122, 24, 0.1);
    border-left-color: var(--color-sunset-orange);
  }

  .faq-nav-cta {
    margin-top: var(--spacing-lg);
    padding-top: var(--spacing-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .faq-nav-cta p {
    font-size: 0.875rem;
    color: rgba(245, 245, 245, 0.62);
    margin: 0;
  }

  .faq-nav-cta .btn {
    width: 100%;
    justify-content: center;
    font-size: 0.875rem;
    padding: var(--spacing-sm) var(--spacing-md);
  }

  /* FAQ categories */
  .faq-content-col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3xl);
  }

  .faq-category-heading {
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(245, 245, 245, 0.82);
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-md);
    border-bottom: 2px solid rgba(255, 122, 24, 0.85);
  }

  /* FAQ items */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.025);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
  }

  .faq-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-pure-white);
    cursor: pointer;
    list-style: none;
    transition: background var(--transition-fast), color var(--transition-fast);
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background: rgba(255, 255, 255, 0.045);
  }

  .faq-item[open] .faq-question {
    background: rgba(255, 122, 24, 0.1);
    color: var(--color-sunset-orange);
  }

  /* Icon toggle */
  .faq-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    color: var(--color-pure-white);
    background: rgba(255, 255, 255, 0.04);
    transition: all var(--transition-base);
  }

  .faq-item[open] .faq-icon {
    background: var(--color-sunset-orange);
    border-color: var(--color-sunset-orange);
    color: var(--color-jet-black);
    transform: rotate(45deg);
  }

  .icon-minus {
    display: none;
  }

  /* Answer */
  .faq-answer {
    padding: 0 var(--spacing-xl) var(--spacing-xl);
    animation: faq-open 0.2s ease;
  }

  .faq-answer p {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(245, 245, 245, 0.68);
    margin: 0;
    max-width: 68ch;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* CTA */
  .faq-cta-strip {
    padding-top: 0;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .faq-layout {
      grid-template-columns: 1fr;
    }

    .faq-nav-col {
      position: static;
    }

    .faq-nav-inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--spacing-md);
      row-gap: var(--spacing-md);
    }

    .faq-nav-label {
      width: 100%;
    }

    .faq-nav-cta {
      display: none;
    }

    .faq-nav-link {
      border-left: none;
      border: 1.5px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-full);
      padding: 7px 16px;
      font-size: 0.875rem;
      background: rgba(255, 255, 255, 0.035);
      color: rgba(245, 245, 245, 0.72);
    }

    .faq-nav-link:hover {
      background: rgba(255, 122, 24, 0.12);
      border-color: rgba(255, 122, 24, 0.45);
      color: var(--color-sunset-orange);
    }

    .faq-nav-link.active {
      background: var(--color-sunset-orange);
      border-color: var(--color-sunset-orange);
      color: var(--color-jet-black);
    }
  }

  @media (max-width: 768px) {
    .faq-question {
      padding: var(--spacing-md) var(--spacing-lg);
      font-size: 1rem;
    }

    .faq-answer {
      padding: 0 var(--spacing-lg) var(--spacing-lg);
    }

    .cta-actions {
      flex-direction: column;
    }

    .btn-lg {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  // Active category highlight on scroll
  const categories = document.querySelectorAll<HTMLElement>('.faq-category');
  const navLinks   = document.querySelectorAll<HTMLAnchorElement>('.faq-nav-link');

  if (navLinks.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            navLinks.forEach((link) => {
              link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`);
            });
          }
        });
      },
      { rootMargin: '-15% 0px -75% 0px' }
    );
    categories.forEach((c) => observer.observe(c));
  }
</script>