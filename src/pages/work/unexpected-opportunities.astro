---
import MainLayout from '../../layouts/MainLayout.astro';


const project = {
  metaTitle: "Unexpected Opportunities Case Study | Plane View Collective",
  metaDescription:
    "How we built a complete digital presence for a Cape Town community movement through brand identity, website design, and content strategy",

  tags: ["Web Design", "Branding", "Content Strategy"],
  title: "Unexpected Opportunities",
  tagline:
    "Creating a digital home for a Cape Town community movement built on dignity, care, and showing up, through brand identity, website design, and content strategy.",

  client: "Unexpected Opportunities",
  industry: "Non profit and community",
  location: "Cape Town, South Africa",
  services: ["Brand Identity", "Website Design", "Content Strategy"],
  year: "2026",

  heroImage: "/UnexpectedOpportunities/up.webp",
  heroImageAlt: "Unexpected Opportunities website mockup",

  challengeHeading: "A movement with real impact but no digital presence",
  challenge: [
    "Unexpected Opportunities had already been doing meaningful work in their community long before they had a website. They provided food support, mentored young people, and shared real stories from the community. The work was genuine, the care was visible, and the trust had been built face to face.",
    "But none of that existed online. There was no platform that could reflect their mission, explain what they do clearly, or help donors and volunteers find and trust them.",
    "The challenge was not just about visibility. It was about avoiding something that felt generic. A typical charity website would strip away what made them different. They did not need something overly polished or distant. They needed something that felt real, human, and close to the people they serve.",
  ],

  approachHeading: "Putting dignity first and design second",
  approach: [
    "We began by listening. That aligned naturally with a movement built on understanding people first. The brand needed to communicate warmth and trust immediately.",
    "The visual identity was designed to feel grounded rather than corporate. The typography was chosen for clarity and calmness. The tone of voice was shaped to feel like a real person speaking, not a formal organisation.",
    "The website was structured around the way people actually think when they land on it for the first time. What do you do. Why should I trust you. How can I get involved. Every section was designed to answer these questions clearly and in the right order.",
    "The Stories section became a central part of the experience. It was not treated as an extra feature. For this movement, real stories are the strongest proof of impact.",
  ],

  deliverables: [
    {
      number: "01",
      service: "Brand Identity",
      heading: "A visual identity built on warmth and trust",
      description:
        "We created a brand system that feels human and credible at the same time. It includes grounded colours, clean typography, and a visual identity that works across digital, print, and social platforms from the start.",
    },
    {
      number: "02",
      service: "Website Design & Build",
      heading: "A website that invites people in",
      description:
        "The site was designed to clearly explain the mission, showcase the programs, and make it easy for people to donate or get involved. The layout is clean, the structure is intuitive, and the Stories section plays a central role in building trust.",
    },
    {
      number: "03",
      service: "Content Strategy",
      heading: "Turning storytelling into a long term asset",
      description:
        "Every page was written to feel personal and close. The content system was built so the team can continue sharing stories easily without relying on a developer, allowing the platform to grow over time.",
    },
  ],

  resultHeading: "A community movement, now visible",
  result: [
    "Unexpected Opportunities now has a digital presence that reflects the same warmth and honesty as their work on the ground. Someone visiting the site for the first time can quickly understand the mission and take action without confusion.",
    "The platform does more than present information. It gives the team a consistent way to communicate, a space to share stories, and a foundation they can grow as the movement expands.",
  ],

  stats: [
    { figure: "3", label: "Core programs clearly communicated for the first time" },
    { figure: "15+", label: "Local partnerships supported by the new digital presence" },
    { figure: "0→1", label: "From no brand identity to a complete movement presence" },
  ],

  quote:
    "Plane View understood immediately that we did not want something that looked like a typical charity. They created something that feels like us, honest, warm, and built for the people we serve.",
  quoteAuthor: "Unexpected Opportunities",
};
// ============================================================
---

<MainLayout title={project.metaTitle} description={project.metaDescription}>
  <!-- ═══════════════════════════════════════════
       1. HERO — Case Study Intro
  ═══════════════════════════════════════════ -->
  <section class="cs-hero">
    <div class="container">
      <div class="cs-hero-inner">
        <div class="cs-hero-left">
          <div class="cs-tags">
            {project.tags.map((tag) => (
              <span class="cs-tag">{tag}</span>
            ))}
          </div>

          <p class="cs-kicker">Case Study</p>
          <h1 class="cs-hero-title">{project.title}</h1>
          <p class="cs-hero-tagline">{project.tagline}</p>
        </div>

        <aside class="cs-hero-meta" aria-label="Project details">
          <div class="meta-item">
            <span class="meta-label">Client</span>
            <span class="meta-value">{project.client}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Industry</span>
            <span class="meta-value">{project.industry}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">{project.location}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Services</span>
            <span class="meta-value">{project.services.join(" / ")}</span>
          </div>

          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{project.year}</span>
          </div>
        </aside>
      </div>

      <div class="cs-hero-cover">
        {project.heroImage ? (
          <img
            src={project.heroImage}
            alt={project.heroImageAlt}
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="cover-placeholder" aria-label={project.heroImageAlt}>
            <span class="cover-hint">Hero Image — {project.client}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       2. BRAND IDENTITY
  ═══════════════════════════════════════════ -->
  <section class="brand-section">
    <div class="container">
      <div class="section-label-block">
        <span class="eyebrow">Brand Identity</span>
        <h2 class="section-heading">The {project.client} Identity</h2>
        <p class="section-subheading">
          A visual system built on warmth, trust, and community dignity.
        </p>
      </div>
    </div>

    <div class="brand-board">
      <div class="brand-board-left">
        <div class="logo-on-light">
          <div class="logo-placeholder">
            <div class="logo-icon-placeholder">UO</div>
            <span class="logo-wordmark">UNEXPECTED<br />OPPORTUNITIES</span>
          </div>
          <span class="logo-variant-label">Primary — Light Background</span>
        </div>

        <div class="logo-on-dark">
          <div class="logo-placeholder">
            <div class="logo-icon-placeholder reversed">UO</div>
            <span class="logo-wordmark reversed">UNEXPECTED<br />OPPORTUNITIES</span>
          </div>
          <span class="logo-variant-label light">Primary — Dark Background</span>
        </div>

        <div class="logo-on-brand">
          <div class="logo-placeholder">
            <div class="logo-icon-placeholder brand">UO</div>
            <span class="logo-wordmark brand">UNEXPECTED<br />OPPORTUNITIES</span>
          </div>
          <span class="logo-variant-label light">Primary Brand Colour</span>
        </div>
      </div>

      <div class="brand-board-right">
        <div class="colour-column" style="background:#ffffff;">
          <div class="colour-info dark">
            <span class="colour-name">White</span>
            <span class="colour-hex">#ffffff</span>
            <span class="colour-role">Background</span>
          </div>
        </div>

        <div class="colour-column" style="background:#696969;">
          <div class="colour-info light">
            <span class="colour-name">Dim Grey</span>
            <span class="colour-hex">#696969</span>
            <span class="colour-role">Body Text</span>
          </div>
        </div>

        <div class="colour-column" style="background:#1a1a1a;">
          <div class="colour-info light">
            <span class="colour-name">Black</span>
            <span class="colour-hex">#1a1a1a</span>
            <span class="colour-role">Primary</span>
          </div>
        </div>

        <div class="colour-column" style="background:#e9732a;">
          <div class="colour-info light">
            <span class="colour-name">Carrot Orange</span>
            <span class="colour-hex">#e9732a</span>
            <span class="colour-role">Accent</span>
          </div>
        </div>

        <div class="colour-column" style="background:#f4a460;">
          <div class="colour-info dark">
            <span class="colour-name">Sandy Brown</span>
            <span class="colour-hex">#f4a460</span>
            <span class="colour-role">Secondary</span>
          </div>
        </div>
      </div>
    </div>

    <div class="type-strip">
      <div class="container">
        <div class="type-grid">
          <div class="type-block">
            <span class="type-label">Display — Myanmar</span>
            <div class="type-specimen-display">Aa</div>

            <div class="type-weights">
              <span style="font-weight:400;">Regular</span>
              <span style="font-weight:700;">Bold</span>
            </div>

            <p class="type-usage">
              Used for headlines, pull quotes, and all display text.
            </p>
          </div>

          <div class="type-divider" aria-hidden="true"></div>

          <div class="type-block">
            <span class="type-label">Body — Bahnschrift</span>
            <div class="type-specimen-body">Aa</div>

            <div class="type-weights">
              <span style="font-weight:400;">Regular</span>
              <span style="font-weight:600;">SemiBold</span>
            </div>

            <p class="type-usage">
              Used for body copy, captions, and UI labels.
            </p>
          </div>

          <div class="type-divider" aria-hidden="true"></div>

          <div class="type-block">
            <span class="type-label">In Use</span>
            <p class="specimen-headline">Showing up for community.</p>
            <p class="specimen-body">
              Serving Cape Town’s most vulnerable residents through food support,
              youth mentorship, and community storytelling. Because dignity should
              never feel out of reach.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="brand-values-strip">
      <div class="container">
        <div class="values-grid">
          <div class="value-pill">Human</div>
          <div class="value-pill">Grounded</div>
          <div class="value-pill">Warm</div>
          <div class="value-pill">Community-first</div>
          <div class="value-pill">Honest</div>
          <div class="value-pill accent">Dignity &amp; Care</div>
          <div class="value-pill accent">Radical Welcome</div>
          <div class="value-pill accent">Lived Experience</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       3. PREMIUM VISUAL SHOWCASE — Supporting Applications
       Desktop cleaned into equal cards.
  ═══════════════════════════════════════════ -->
  <section class="visual-showcase" aria-labelledby="showcase-title">
    <div class="container">
      <div class="section-label-block showcase-header">
        <span class="eyebrow">Application</span>
        <h2 id="showcase-title" class="section-heading">The Work in Context</h2>
        <p class="section-subheading">
          The brand applied consistently across digital platforms and real-world
          community touchpoints with a cleaner, more editorial presentation.
        </p>
      </div>

      <div class="showcase-grid showcase-grid--balanced">
        <figure class="showcase-item">
          <div class="media-frame">
            <img
              src="/UnexpectedOpportunities/Business_Card.png"
              alt="Unexpected Opportunities business card design"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="showcase-caption">Business Card</figcaption>
        </figure>

        <figure class="showcase-item">
          <div class="media-frame">
            <img
              src="/UnexpectedOpportunities/socialmedia.webp"
              alt="Unexpected Opportunities social media post"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="showcase-caption">Social Media</figcaption>
        </figure>

        <figure class="showcase-item">
          <div class="media-frame">
            <img
              src="/UnexpectedOpportunities/socialmedia02.webp"
              alt="Unexpected Opportunities social media campaign visual"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="showcase-caption">Campaign Visual</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       4. CASE STUDY — The Story
  ═══════════════════════════════════════════ -->
  <section class="story-section">
    <div class="container story-container">
      <nav class="story-sidenav" aria-label="Case study navigation">
        <a href="#challenge" class="cs-nav-link">Challenge</a>
        <a href="#approach" class="cs-nav-link">Approach</a>
        <a href="#execution" class="cs-nav-link">Execution</a>
        <a href="#result" class="cs-nav-link">Result</a>
      </nav>

      <div class="story-body">
        <article id="challenge" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">01</span>
            <span class="chapter-title">The Challenge</span>
          </div>

          <h3 class="chapter-heading">{project.challengeHeading}</h3>

          <div class="chapter-content">
            {project.challenge.map((para) => <p>{para}</p>)}
          </div>
        </article>

        <article id="approach" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">02</span>
            <span class="chapter-title">The Approach</span>
          </div>

          <h3 class="chapter-heading">{project.approachHeading}</h3>

          <div class="chapter-content">
            {project.approach.map((para) => <p>{para}</p>)}

            <div class="approach-pillars">
              <div class="pillar">
                <span class="pillar-label">Brand Direction</span>
                <p>
                  Warmth without naivety. Grounded in the community it serves,
                  never corporate or distant.
                </p>
              </div>

              <div class="pillar">
                <span class="pillar-label">Content Strategy</span>
                <p>
                  Stories as evidence. Lived experience treated as the most
                  powerful trust signal the organisation has.
                </p>
              </div>

              <div class="pillar">
                <span class="pillar-label">Digital Strategy</span>
                <p>
                  Answer three questions in order: What do you do? Why trust you?
                  How do I get involved?
                </p>
              </div>
            </div>
          </div>
        </article>

        <article id="execution" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">03</span>
            <span class="chapter-title">The Execution</span>
          </div>

          <h3 class="chapter-heading">
            Built to feel like them.<br />Every touchpoint considered.
          </h3>

          <div class="chapter-content">
            <p>
              We delivered a complete brand system and digital presence in a single
              focused engagement — identity, digital, and collateral working
              together so the movement has a coherent voice wherever it shows up.
            </p>

            <div class="execution-deliverables">
              {project.deliverables.map((d) => (
                <div class="deliverable-row">
                  <div class="deliverable-icon" aria-hidden="true">—</div>

                  <div class="deliverable-detail">
                    <span class="deliverable-name">{d.number} — {d.service}</span>
                    <span class="deliverable-heading">{d.heading}</span>
                    <p>{d.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>

        <article id="result" class="story-chapter story-chapter--last">
          <div class="chapter-marker">
            <span class="chapter-number">04</span>
            <span class="chapter-title">The Result</span>
          </div>

          <h3 class="chapter-heading">{project.resultHeading}</h3>

          <div class="chapter-content">
            {project.result.map((para) => <p>{para}</p>)}
          </div>

          <div class="result-stats">
            {project.stats.map((s) => (
              <div class="stat-card">
                <span class="stat-figure">{s.figure}</span>
                <span class="stat-desc">{s.label}</span>
              </div>
            ))}
          </div>

          {project.quote && (
            <blockquote class="story-quote">
              <p class="story-quote-text">“{project.quote}”</p>
              <footer>
                <span class="story-quote-author">— {project.quoteAuthor}</span>
              </footer>
            </blockquote>
          )}
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       5. NEXT PROJECT CTA
  ═══════════════════════════════════════════ -->
  <section class="next-project">
    <div class="container">
      <div class="next-project-inner">
        <span class="eyebrow">Next Project</span>
        <a href="/work/chemcrete" class="next-project-link">
          <span class="next-project-name">Chemcrete</span>
          <span class="next-arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :root {
    --uo-white: #ffffff;
    --uo-cream: #f2ede6;
    --uo-cream-soft: #f9f8f5;
    --uo-muted: #696969;
    --uo-text: #1a1a1a;
    --uo-orange: #e9732a;
    --uo-orange-soft: #f4a460;
    --uo-line: rgba(26, 26, 26, 0.08);
    --uo-line-strong: rgba(26, 26, 26, 0.12);
    --uo-shadow: 0 24px 80px rgba(233, 115, 42, 0.09);
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .container-wide {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    display: inline-block;
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--uo-orange);
    margin: 0 0 0.75rem;
  }

  .section-label-block {
    max-width: 680px;
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--uo-text);
    margin: 0 0 0.8rem;
    line-height: 1;
  }

  .section-subheading {
    font-family: 'Open Sans', sans-serif;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    color: var(--uo-muted);
    margin: 0;
    line-height: 1.7;
  }

  img {
    max-width: 100%;
  }

  /* ════════════════════════════════════════
     1. HERO
  ════════════════════════════════════════ */
  .cs-hero {
    position: relative;
    background:
      radial-gradient(circle at 10% 0%, rgba(233, 115, 42, 0.16), transparent 32rem),
      linear-gradient(180deg, #ffffff 0%, #f2ede6 72%, #eee5dc 100%);
    padding: clamp(6rem, 9vw, 8.5rem) 0 0;
    overflow: hidden;
  }

  .cs-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
    background-image:
      linear-gradient(rgba(26, 26, 26, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(26, 26, 26, 0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .cs-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 4.75rem);
  }

  .cs-hero-left {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .cs-tag {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.42rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgba(233, 115, 42, 0.34);
    color: var(--uo-orange);
    background: rgba(233, 115, 42, 0.07);
  }

  .cs-kicker {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.46);
    margin: 0 0 0.75rem;
  }

  .cs-hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 8.5vw, 7.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    color: var(--uo-text);
    line-height: 0.95;
    margin: 0.25rem 0 1.5rem;
    max-width: 880px;
  }

  .cs-hero-tagline {
    font-family: 'Open Sans', sans-serif;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--uo-muted);
    line-height: 1.75;
    max-width: 720px;
    margin: 0;
  }

  .cs-hero-meta {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 1.35rem 0 1.35rem 2rem;
    border-left: 1px solid rgba(26, 26, 26, 0.12);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .meta-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--uo-orange);
  }

  .meta-value {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.9375rem;
    color: var(--uo-text);
    font-weight: 600;
    line-height: 1.55;
  }

  .cs-hero-cover {
    position: relative;
    z-index: 1;
    width: 100%;
    overflow: hidden;
    border-radius: 1.5rem 1.5rem 0 0;
    border: 1px solid var(--uo-line);
    border-bottom: none;
    background: var(--uo-cream);
    box-shadow: var(--uo-shadow);
  }

  .cs-hero-cover img {
    width: 100%;
    height: auto;
    display: block;
  }

  .cover-placeholder {
    width: 100%;
    min-height: 360px;
    background: #e8e3db;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cover-hint {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.25);
  }

  /* ════════════════════════════════════════
     2. BRAND IDENTITY
  ════════════════════════════════════════ */
  .brand-section {
    background: var(--uo-cream-soft);
    padding: clamp(4.5rem, 8vw, 6.5rem) 0 0;
    overflow: hidden;
  }

  .brand-board {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: stretch;
    min-height: 520px;
    border-top: 1px solid var(--uo-line);
    margin-top: 1rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
  }

  .brand-board-left {
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    min-height: 520px;
    border-right: 1px solid var(--uo-line);
  }

  .logo-on-light,
  .logo-on-dark,
  .logo-on-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.95rem;
    padding: 2.5rem;
  }

  .logo-on-light {
    background: #ffffff;
  }

  .logo-on-dark {
    background: #1a1a1a;
  }

  .logo-on-brand {
    background: var(--uo-orange);
  }

