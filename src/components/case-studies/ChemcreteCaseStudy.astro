---
import MainLayout from '../../layouts/MainLayout.astro';


const { data } = Astro.props;
---

<MainLayout title={data.metaTitle} description={data.metaDescription}>


  <!-- HERO -->
  <section class="cs-hero">
    <div class="container">
      <div class="cs-hero-inner">
        <div class="cs-hero-left">
          <div class="cs-tags">
            {data.tags.map((tag) => (
              <span class="cs-tag">{tag}</span>
            ))}
          </div>

          <h1 class="cs-hero-title">{data.title}</h1>
          <p class="cs-hero-tagline">{data.tagline}</p>
        </div>

        <div class="cs-hero-meta">
          <div class="meta-item">
            <span class="meta-label">Client</span>
            <span class="meta-value">{data.client}</span>
          </div>

          {data.industry && (
            <div class="meta-item">
              <span class="meta-label">Industry</span>
              <span class="meta-value">{data.industry}</span>
            </div>
          )}

          {data.location && (
            <div class="meta-item">
              <span class="meta-label">Location</span>
              <span class="meta-value">{data.location}</span>
            </div>
          )}

          {data.services.length > 0 && (
            <div class="meta-item">
              <span class="meta-label">Services</span>
              {data.services.map((s) => (
                <span class="meta-value">{s}</span>
              ))}
            </div>
          )}

          {data.year && (
            <div class="meta-item">
              <span class="meta-label">Year</span>
              <span class="meta-value">{data.year}</span>
            </div>
          )}
        </div>
      </div>

      <div class="cs-hero-cover">
        {data.heroImage ? (
          <img src={data.heroImage} alt={data.heroImageAlt} />
        ) : (
          <div class="cover-placeholder" aria-label={data.heroImageAlt}>
            <span class="cover-hint">Hero Image — {data.client}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- BRAND IDENTITY -->
  {data.brandIdentity && (
    <section class="brand-section">
      <div class="container">
        <div class="section-label-block">
          <span class="eyebrow">Brand Identity</span>
          <h2 class="section-heading">{data.brandIdentity.sectionTitle}</h2>
          <p class="section-subheading">{data.brandIdentity.sectionSubtitle}</p>
        </div>
      </div>

      <div class="brand-board">
        <div class="brand-board-left">
          {data.brandIdentity.logoVariants.map((logo) => (
            <div class={`logo-on-${logo.theme === 'light' ? 'light' : logo.theme === 'dark' ? 'dark' : 'brand'}`}>
              <div class="logo-placeholder">
                <div class="logo-mark">
                  <div class={`logo-icon-placeholder ${logo.theme === 'dark' ? 'reversed' : logo.theme === 'brand' ? 'brand' : ''}`}>
                    {logo.markText}
                  </div>
                </div>
                <span class={`logo-wordmark ${logo.theme === 'dark' ? 'reversed' : logo.theme === 'brand' ? 'brand' : ''}`}>
                  {logo.wordmark}
                </span>
              </div>
              <span class={`logo-variant-label ${logo.theme === 'light' ? '' : 'light'}`}>
                {logo.label}
              </span>
            </div>
          ))}
        </div>

        <div class="brand-board-right">
          {data.brandIdentity.colours.map((colour, index) => (
            <div
              class="colour-column"
              style={`background:${colour.hex}; ${index === 0 ? 'border: 1px solid #e0dbd1;' : ''}`}
            >
              <div class={`colour-info ${colour.textTheme}`}>
                <span class="colour-name">{colour.name}</span>
                <span class="colour-hex">{colour.hex}</span>
                <span class="colour-role">{colour.role}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="type-strip">
        <div class="container">
          <div class="type-grid">
            <div class="type-block type-display">
              <span class="type-label">{data.brandIdentity.typography.display.label}</span>
              <div class="type-specimen-display">{data.brandIdentity.typography.display.specimen}</div>
              <div class="type-weights">
                {data.brandIdentity.typography.display.weights.map((weight) => (
                  <span>{weight}</span>
                ))}
              </div>
              <p class="type-usage">{data.brandIdentity.typography.display.usage}</p>
            </div>

            <div class="type-divider"></div>

            <div class="type-block type-body">
              <span class="type-label">{data.brandIdentity.typography.body.label}</span>
              <div class="type-specimen-body">{data.brandIdentity.typography.body.specimen}</div>
              <div class="type-weights">
                {data.brandIdentity.typography.body.weights.map((weight) => (
                  <span>{weight}</span>
                ))}
              </div>
              <p class="type-usage">{data.brandIdentity.typography.body.usage}</p>
            </div>

            <div class="type-divider"></div>

            <div class="type-block type-specimen-live">
              <span class="type-label">{data.brandIdentity.typography.inUse.label}</span>
              <p class="specimen-headline">{data.brandIdentity.typography.inUse.headline}</p>
              <p class="specimen-body">{data.brandIdentity.typography.inUse.body}</p>
            </div>
          </div>
        </div>
      </div>

      {data.brandValues.length > 0 && (
        <div class="brand-values-strip">
          <div class="container">
            <div class="values-grid">
              {data.brandValues.map((value, index) => (
                <div class={`value-pill ${index >= 5 ? 'accent' : ''}`}>{value}</div>
              ))}
            </div>
          </div>
        </div>
      )}
    </section>
  )}

  <!-- MOCKUPS -->
  {(data.featuredWebsite || data.applicationImages.length > 0) && (
    <section class="mockups-section">
      <div class="container">
        <div class="section-label-block">
          <span class="eyebrow">Application</span>
          <h2 class="section-heading">The Work in Context</h2>
          <p class="section-subheading">Brand applied across digital and physical touchpoints.</p>
        </div>

        {data.featuredWebsite && (
          <div class="mockup-feature">
            <div class="mockup-frame mockup-frame--desktop">
              <div class="mockup-browser-bar">
                <div class="browser-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="browser-url">{data.featuredWebsite.displayUrl}</div>
              </div>
              <div class="mockup-screen mockup-screen--16-9">
                <img src={data.featuredWebsite.image} alt={data.featuredWebsite.alt} />
              </div>
            </div>
            <p class="mockup-caption">{data.featuredWebsite.caption}</p>
          </div>
        )}

        {data.applicationImages.length > 0 && (
          <div class="mockup-grid mockup-grid--3col">
            {data.applicationImages.map((img) => (
              <div class="mockup-item">
                <div class="mockup-frame mockup-frame--card">
                  <img src={img.src} alt={img.alt} />
                </div>
                <p class="mockup-caption">{img.caption}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- STORY -->
  <section class="story-section">
    <div class="container story-container">
      <nav class="story-sidenav" aria-label="Case study navigation">
        <a href="#challenge" class="cs-nav-link">Challenge</a>
        <a href="#approach" class="cs-nav-link">Approach</a>
        <a href="#execution" class="cs-nav-link">Execution</a>
        <a href="#result" class="cs-nav-link">Result</a>
      </nav>

      <div class="story-body">
        <article id="challenge" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">01</span>
            <span class="chapter-title">The Challenge</span>
          </div>
          <h3 class="chapter-heading">{data.challengeHeading}</h3>
          <div class="chapter-content">
            {data.challenge.map((para) => <p>{para}</p>)}
          </div>
        </article>

        <article id="approach" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">02</span>
            <span class="chapter-title">The Approach</span>
          </div>
          <h3 class="chapter-heading">{data.approachHeading}</h3>
          <div class="chapter-content">
            {data.approach.map((para) => <p>{para}</p>)}

            {data.approachPillars.length > 0 && (
              <div class="approach-pillars">
                {data.approachPillars.map((pillar) => (
                  <div class="pillar">
                    <span class="pillar-label">{pillar.label}</span>
                    <p>{pillar.text}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </article>

        <article id="execution" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">03</span>
            <span class="chapter-title">The Execution</span>
          </div>
          <h3 class="chapter-heading">
            Built from the ground up.<br />Every detail carefully considered.
          </h3>
          <div class="chapter-content">
            <p>
              We delivered a complete brand system and digital presence through one focused project. The work covered identity, digital, and physical touchpoints, creating a consistent and professional presence wherever clients interact with {data.client}.
            </p>

            {data.deliverables.length > 0 && (
              <div class="execution-deliverables">
                {data.deliverables.map((d) => (
                  <div class="deliverable-row">
                    <div class="deliverable-icon">—</div>
                    <div class="deliverable-detail">
                      <span class="deliverable-name">{d.number} — {d.service}</span>
                      <span class="deliverable-heading">{d.heading}</span>
                      <p>{d.description}</p>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </article>

        <article id="result" class="story-chapter story-chapter--last">
          <div class="chapter-marker">
            <span class="chapter-number">04</span>
            <span class="chapter-title">The Result</span>
          </div>
          <h3 class="chapter-heading">{data.resultHeading}</h3>
          <div class="chapter-content">
            {data.result.map((para) => <p>{para}</p>)}
          </div>

          {data.stats.length > 0 && (
            <div class="result-stats">
              {data.stats.map((s) => (
                <div class="stat-card">
                  <span class="stat-figure">{s.figure}</span>
                  <span class="stat-desc">{s.label}</span>
                </div>
              ))}
            </div>
          )}

{data.quote && (
  <blockquote class="story-quote">
    <p class="story-quote-text">"{data.quote}"</p>

    {data.quoteAuthor && (
      <footer>
        <span class="story-quote-author">— {data.quoteAuthor}</span>
      </footer>
    )}
  </blockquote>
)}
        </article>
      </div>
    </div>
  </section>

  <!-- NEXT PROJECT -->
  {data.nextProject && (
    <section class="next-project">
      <div class="container">
        <div class="next-project-inner">
          <span class="eyebrow">Next Project</span>
          <a href={data.nextProject.href} class="next-project-link">
            <span class="next-project-name">{data.nextProject.name}</span>
            <span class="next-arrow">→</span>
          </a>
        </div>
      </div>
    </section>
  )}
</MainLayout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .eyebrow {
    display: inline-block;
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7c0000;
    margin-bottom: 0.75rem;
  }

  .section-label-block {
    max-width: 640px;
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1a1a1a;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }

  .section-subheading {
    font-family: 'Open Sans', sans-serif;
    font-size: 1.0625rem;
    color: #636363;
    margin: 0;
    line-height: 1.6;
  }

  .cs-hero {
    background: #f9f8f5;
    padding: 7rem 0 0;
    overflow: hidden;
  }

  .cs-hero-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: start;
    padding-bottom: 4rem;
  }

  .cs-hero-left {
    display: flex;
    flex-direction: column;
  }

  .cs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 1.25rem;
  }

  .cs-tag {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 14px;
    border-radius: 9999px;
    border: 1.5px solid #7c0000;
    color: #480000;
  }

  .cs-hero-title {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1a1a1a;
    line-height: 0.95;
    margin: 0.5rem 0 1.5rem;
  }

  .cs-hero-tagline {
    font-family: 'Open Sans', sans-serif;
    font-size: 1.125rem;
    color: #636363;
    line-height: 1.7;
    max-width: 480px;
    margin: 0;
  }

  .cs-hero-meta {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 1.25rem;
    border-left: 1px solid rgba(0,0,0,0.1);
    padding-left: 2.5rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .meta-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7c0000;
  }

  .meta-value {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.9375rem;
    color: #1a1a1a;
    font-weight: 500;
    line-height: 1.5;
  }

  .cs-hero-cover {
    position: relative;
    width: 100%;
    background: #e3ddd3;
    border-top: 1px solid rgba(0,0,0,0.08);
    aspect-ratio: 16 / 7;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cs-hero-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .cover-hint {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    color: #636363;
    letter-spacing: 0.06em;
  }

  .brand-section {
    background: #f9f8f5;
    padding: 6rem 0 0;
    overflow: hidden;
  }

  .brand-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 480px;
    border-top: 1px solid rgba(0,0,0,0.08);
    margin-top: 1rem;
  }

  .brand-board-left {
    display: grid;
    grid-template-rows: 1fr 1fr 1fr;
    border-right: 1px solid rgba(0,0,0,0.08);
  }

  .logo-on-light,
  .logo-on-dark,
  .logo-on-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2.5rem;
    border-bottom: 1px solid rgba(0,0,0,0.08);
  }

  .logo-on-light { background: #ffffff; }
  .logo-on-dark  { background: #1a1a1a; }
  .logo-on-brand { background: #480000; border-bottom: none; }

  .logo-placeholder {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-icon-placeholder {
    width: 48px;
    height: 48px;
    border: 2px solid #480000;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Oswald', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #480000;
  }

  .logo-icon-placeholder.reversed {
    border-color: #ffffff;
    color: #ffffff;
  }

  .logo-icon-placeholder.brand {
    border-color: #e3ddd3;
    color: #e3ddd3;
  }

  .logo-wordmark {
    font-family: 'Oswald', sans-serif;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #480000;
    white-space: pre-line;
  }

  .logo-wordmark.reversed { color: #ffffff; }
  .logo-wordmark.brand { color: #e3ddd3; }

  .logo-variant-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #636363;
  }

  .logo-variant-label.light { color: rgba(255,255,255,0.45); }

  .brand-board-right {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .colour-column {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem 1rem;
    min-height: 480px;
  }

  .colour-column:not(:last-child) {
    border-right: 1px solid rgba(255,255,255,0.12);
  }

  .colour-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .colour-name {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .colour-hex {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    opacity: 0.7;
  }

  .colour-role {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 400;
    opacity: 0.5;
    margin-top: 2px;
  }

  .colour-info.dark .colour-name,
  .colour-info.dark .colour-hex,
  .colour-info.dark .colour-role { color: #1a1a1a; }

  .colour-info.light .colour-name,
  .colour-info.light .colour-hex,
  .colour-info.light .colour-role { color: #ffffff; }

  .type-strip {
    background: #ffffff;
    border-top: 1px solid rgba(0,0,0,0.08);
    padding: 4rem 0;
  }

  .type-grid {
    display: grid;
    grid-template-columns: 1fr 1px 1fr 1px 1.4fr;
    gap: 0;
    align-items: start;
  }

  .type-divider {
    background: rgba(0,0,0,0.08);
    height: 100%;
    min-height: 200px;
  }

  .type-block {
    padding: 0 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .type-block:first-child { padding-left: 0; }
  .type-block:last-child { padding-right: 0; }

  .type-label {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7c0000;
  }

  .type-specimen-display {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 700;
    color: #1a1a1a;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .type-specimen-body {
    font-family: 'Open Sans', sans-serif;
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 400;
    color: #1a1a1a;
    line-height: 0.9;
  }

  .type-weights { display: flex; gap: 1.25rem; flex-wrap: wrap; }

  .type-weights span {
    font-size: 0.875rem;
    color: #636363;
  }

  .type-usage {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.875rem;
    color: #636363;
    margin: 0;
    line-height: 1.6;
    max-width: 260px;
  }

  .specimen-headline {
    font-family: 'Oswald', sans-serif;
    font-size: clamp(1.375rem, 2.5vw, 1.875rem);
    font-weight: 700;
    color: #480000;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }

  .specimen-body {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.9375rem;
    color: #636363;
    line-height: 1.7;
    margin: 0;
  }

  .brand-values-strip {
    background: #480000;
    padding: 2rem 0;
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .values-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .value-pill {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 6px 14px;
    border-radius: 9999px;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.7);
    background: transparent;
  }

  .value-pill.accent {
    border-color: rgba(227,221,211,0.35);
    color: #e3ddd3;
    background: rgba(227,221,211,0.08);
  }

  .mockups-section {
    background: #1a1a1a;
    padding: 6rem 0;
  }

  .mockups-section .section-label-block {
    margin-bottom: 4rem;
  }

  .mockups-section .section-heading { color: #ffffff; }
  .mockups-section .section-subheading { color: rgba(255,255,255,0.5); }
  .mockups-section .eyebrow { color: #7c0000; }

  .mockup-feature {
    margin-bottom: 3rem;
  }

  .mockup-grid {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .mockup-grid--3col {
    grid-template-columns: repeat(3, 1fr);
  }

  .mockup-frame {
    background: #242424;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.06);
  }

  .mockup-frame--card {
    background: none;
    border: none;
    border-radius: 0;
    overflow: visible;
  }

  .mockup-frame--card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mockup-browser-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    background: #2e2e2e;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .browser-dots {
    display: flex;
    gap: 5px;
  }

  .browser-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    display: block;
  }

  .browser-url {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.3);
