---
import MainLayout from '../../layouts/MainLayout.astro';


const { data } = Astro.props;
---

<MainLayout title={data.metaTitle} description={data.metaDescription}>
  

  <section class="cs-hero">
    <div class="container">
      <div class="cs-hero-inner">
        <div class="cs-hero-left">
          <div class="cs-tags">
            {data.tags.map((tag) => (
              <span class="cs-tag">{tag}</span>
            ))}
          </div>
          <h1 class="cs-hero-title">{data.title}</h1>
          <p class="cs-hero-tagline">{data.tagline}</p>
        </div>

        <div class="cs-hero-meta">
          <div class="meta-item">
            <span class="meta-label">Client</span>
            <span class="meta-value">{data.client}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Industry</span>
            <span class="meta-value">{data.industry}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">{data.location}</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Services</span>
            {data.services.map((s) => (
              <span class="meta-value">{s}</span>
            ))}
          </div>
          <div class="meta-item">
            <span class="meta-label">Year</span>
            <span class="meta-value">{data.year}</span>
          </div>
        </div>
      </div>

      <div class="cs-hero-cover">
        {data.heroImage ? (
          <img src={data.heroImage} alt={data.heroImageAlt} />
        ) : (
          <div class="cover-placeholder" aria-label={data.heroImageAlt}>
            <span class="cover-hint">Hero Image — {data.client}</span>
          </div>
        )}
      </div>
    </div>
  </section>

  {data.brandIdentity && (
    <section class="brand-section">
      <div class="container">
        <div class="section-label-block">
          <span class="eyebrow">Brand Identity</span>
          <h2 class="section-heading">{data.brandIdentity.sectionTitle}</h2>
          <p class="section-subheading">{data.brandIdentity.sectionSubtitle}</p>
        </div>
      </div>

      <div class="brand-board">
        <div class="brand-board-left">
          {data.brandIdentity.logoVariants.map((logo) => (
            <div class={`logo-on-${logo.theme === 'light' ? 'light' : logo.theme === 'dark' ? 'dark' : 'brand'}`}>
              <div class="logo-placeholder">
                <div class={`logo-icon-placeholder ${logo.theme === 'dark' ? 'reversed' : logo.theme === 'brand' ? 'brand' : ''}`}>
                  {logo.markText}
                </div>
                <span class={`logo-wordmark ${logo.theme === 'dark' ? 'reversed' : logo.theme === 'brand' ? 'brand' : ''}`}>
                  {logo.wordmark}
                </span>
              </div>
              <span class={`logo-variant-label ${logo.theme === 'light' ? '' : 'light'}`}>
                {logo.label}
              </span>
            </div>
          ))}
        </div>

        <div class="brand-board-right">
          {data.brandIdentity.colours.map((colour) => (
            <div class="colour-column" style={`background:${colour.hex};`}>
              <div class={`colour-info ${colour.textTheme}`}>
                <span class="colour-name">{colour.name}</span>
                <span class="colour-hex">{colour.hex}</span>
                <span class="colour-role">{colour.role}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="type-strip">
        <div class="container">
          <div class="type-grid">
            <div class="type-block">
              <span class="type-label">{data.brandIdentity.typography.display.label}</span>
              <div class="type-specimen-display">{data.brandIdentity.typography.display.specimen}</div>
              <div class="type-weights">
                {data.brandIdentity.typography.display.weights.map((weight) => (
                  <span>{weight}</span>
                ))}
              </div>
              <p class="type-usage">{data.brandIdentity.typography.display.usage}</p>
            </div>

            <div class="type-divider"></div>

            <div class="type-block">
              <span class="type-label">{data.brandIdentity.typography.body.label}</span>
              <div class="type-specimen-body">{data.brandIdentity.typography.body.specimen}</div>
              <div class="type-weights">
                {data.brandIdentity.typography.body.weights.map((weight) => (
                  <span>{weight}</span>
                ))}
              </div>
              <p class="type-usage">{data.brandIdentity.typography.body.usage}</p>
            </div>

            <div class="type-divider"></div>

            <div class="type-block">
              <span class="type-label">{data.brandIdentity.typography.inUse.label}</span>
              <p class="specimen-headline">{data.brandIdentity.typography.inUse.headline}</p>
              <p class="specimen-body">{data.brandIdentity.typography.inUse.body}</p>
            </div>
          </div>
        </div>
      </div>

      {data.brandValues.length > 0 && (
        <div class="brand-values-strip">
          <div class="container">
            <div class="values-grid">
              {data.brandValues.map((value, index) => (
                <div class={`value-pill ${index >= 5 ? 'accent' : ''}`}>{value}</div>
              ))}
            </div>
          </div>
        </div>
      )}
    </section>
  )}

  <section class="mockups-section">
    <div class="container">
      <div class="section-label-block">
        <span class="eyebrow">Application</span>
        <h2 class="section-heading">The Work in Context</h2>
        <p class="section-subheading">The brand applied consistently across both digital platforms and real world community touchpoints.</p>
      </div>

      {data.featuredWebsite && (
        <div class="mockup-feature">
          <div class="mockup-frame mockup-frame--desktop">
            <div class="mockup-browser-bar">
              <div class="browser-dots"><span></span><span></span><span></span></div>
              <div class="browser-url">{data.featuredWebsite.displayUrl}</div>
            </div>
            <div class="mockup-screen">
              <img src={data.featuredWebsite.image} alt={data.featuredWebsite.alt} />
            </div>
          </div>
          <p class="mockup-caption">{data.featuredWebsite.caption}</p>
        </div>
      )}

      {data.applicationImages.length > 0 && (
        <div class="mockup-grid mockup-grid--3col">
          {data.applicationImages.map((img) => (
            <div class="mockup-item">
              <div class="mockup-frame mockup-frame--card">
                <img src={img.src} alt={img.alt} class="card-image" />
              </div>
              <p class="mockup-caption">{img.caption}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="story-section">
    <div class="container story-container">
      <nav class="story-sidenav" aria-label="Case study navigation">
        <a href="#challenge" class="cs-nav-link">Challenge</a>
        <a href="#approach" class="cs-nav-link">Approach</a>
        <a href="#execution" class="cs-nav-link">Execution</a>
        <a href="#result" class="cs-nav-link">Result</a>
      </nav>

      <div class="story-body">
        <article id="challenge" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">01</span>
            <span class="chapter-title">The Challenge</span>
          </div>
          <h3 class="chapter-heading">{data.challengeHeading}</h3>
          <div class="chapter-content">
            {data.challenge.map((para) => <p>{para}</p>)}
          </div>
        </article>

        <article id="approach" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">02</span>
            <span class="chapter-title">The Approach</span>
          </div>
          <h3 class="chapter-heading">{data.approachHeading}</h3>
          <div class="chapter-content">
            {data.approach.map((para) => <p>{para}</p>)}
            <div class="approach-pillars">
              {data.approachPillars.map((pillar) => (
                <div class="pillar">
                  <span class="pillar-label">{pillar.label}</span>
                  <p>{pillar.text}</p>
                </div>
              ))}
            </div>
          </div>
        </article>

        <article id="execution" class="story-chapter">
          <div class="chapter-marker">
            <span class="chapter-number">03</span>
            <span class="chapter-title">The Execution</span>
          </div>
          <h3 class="chapter-heading">
            Built to feel like them.<br />Every touchpoint considered.
          </h3>
          <div class="chapter-content">
            <p>
              We delivered a complete brand system and digital presence in a single focused engagement — identity, digital, and collateral working together so the movement has a coherent voice wherever it shows up.
            </p>
            <div class="execution-deliverables">
              {data.deliverables.map((d) => (
                <div class="deliverable-row">
                  <div class="deliverable-icon">—</div>
                  <div class="deliverable-detail">
                    <span class="deliverable-name">{d.number} — {d.service}</span>
                    <span class="deliverable-heading">{d.heading}</span>
                    <p>{d.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>

        <article id="result" class="story-chapter story-chapter--last">
          <div class="chapter-marker">
            <span class="chapter-number">04</span>
            <span class="chapter-title">The Result</span>
          </div>
          <h3 class="chapter-heading">{data.resultHeading}</h3>
          <div class="chapter-content">
            {data.result.map((para) => <p>{para}</p>)}
          </div>

          <div class="result-stats">
            {data.stats.map((s) => (
              <div class="stat-card">
                <span class="stat-figure">{s.figure}</span>
                <span class="stat-desc">{s.label}</span>
              </div>
            ))}
          </div>

          {data.quote && (
            <blockquote class="story-quote">
              <p class="story-quote-text">"{data.quote}"</p>
              <footer>
                <span class="story-quote-author">— {data.quoteAuthor}</span>
              </footer>
            </blockquote>
          )}
        </article>
      </div>
    </div>
  </section>

  {data.nextProject && (
    <section class="next-project">
      <div class="container">
        <div class="next-project-inner">
          <span class="eyebrow">Next Project</span>
          <a href={data.nextProject.href} class="next-project-link">
            <span class="next-project-name">{data.nextProject.name}</span>
            <span class="next-arrow">→</span>
          </a>
        </div>
      </div>
    </section>
  )}

  
</MainLayout>

<style>
.container { max-width: 1280px; margin: 0 auto; padding: 0 2rem; }
.eyebrow { display: inline-block; font-family: 'Open Sans', sans-serif; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #e9732a; margin-bottom: 0.75rem; }
.section-label-block { max-width: 640px; margin-bottom: 3.5rem; }
.section-heading { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; letter-spacing: -0.02em; color: #1a1a1a; margin: 0 0 0.75rem; line-height: 1.1; }
.section-subheading { font-family: 'Open Sans', sans-serif; font-size: 1.0625rem; color: #696969; margin: 0; line-height: 1.7; }

.cs-hero { background: #f2ede6; padding: 7rem 0 0; overflow: hidden; }
.cs-hero-inner { display: grid; grid-template-columns: 1fr 320px; gap: 4rem; align-items: start; padding-bottom: 4rem; }
.cs-hero-left { display: flex; flex-direction: column; }
.cs-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 1.25rem; }
.cs-tag { font-family: 'Open Sans', sans-serif; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.04em; padding: 4px 14px; border-radius: 9999px; border: 1.5px solid rgba(233, 115, 42, 0.4); color: #e9732a; }
.cs-hero-title { font-family: 'Playfair Display', serif; font-size: clamp(3rem, 7vw, 6rem); font-weight: 700; letter-spacing: -0.02em; color: #1a1a1a; line-height: 0.95; margin: 0.5rem 0 1.5rem; }
.cs-hero-tagline { font-family: 'Open Sans', sans-serif; font-size: 1.125rem; color: #696969; line-height: 1.7; max-width: 480px; margin: 0; }
.cs-hero-meta { display: flex; flex-direction: column; gap: 1.75rem; padding-top: 1.25rem; padding-left: 2.5rem; border-left: 1px solid rgba(26, 26, 26, 0.12); }
.meta-item { display: flex; flex-direction: column; gap: 0.375rem; }
.meta-label { font-family: 'Open Sans', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #e9732a; }
.meta-value { font-family: 'Open Sans', sans-serif; font-size: 0.9375rem; color: #1a1a1a; font-weight: 500; line-height: 1.5; }
.cs-hero-cover { width: 100%; overflow: hidden; }
.cs-hero-cover img { width: 100%; height: auto; display: block; }
.cover-placeholder { width: 100%; min-height: 360px; background: #e8e3db; display: flex; align-items: center; justify-content: center; }
.cover-hint { font-family: 'Open Sans', sans-serif; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(0, 0, 0, 0.25); }

.brand-section { background: #f9f8f5; padding: 6rem 0 0; overflow: hidden; }
.brand-section > .container { padding-bottom: 0; }
.brand-board { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; min-height: 480px; }
.brand-board-left { display: grid; grid-template-rows: 1fr 1fr 1fr; min-height: 480px; }
.logo-on-light, .logo-on-dark, .logo-on-brand { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 2.5rem; }
.logo-on-light { background: #ffffff; }
.logo-on-dark  { background: #1a1a1a; }
.logo-on-brand { background: #e9732a; }
.logo-placeholder { display: flex; align-items: center; gap: 0.75rem; }
.logo-icon-placeholder { width: 52px; height: 52px; border: 2px solid #1a1a1a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 700; color: #1a1a1a; flex-shrink: 0; }
.logo-icon-placeholder.reversed { border-color: #ffffff; color: #ffffff; }
.logo-icon-placeholder.brand    { border-color: #ffffff; color: #ffffff; }
.logo-wordmark { font-family: 'Playfair Display', serif; font-size: 0.9375rem; font-weight: 700; letter-spacing: 0.04em; color: #1a1a1a; line-height: 1.3; text-transform: uppercase; white-space: pre-line; }
.logo-wordmark.reversed { color: #ffffff; }
.logo-wordmark.brand    { color: #ffffff; }
.logo-variant-label { font-family: 'Open Sans', sans-serif; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #696969; }
.logo-variant-label.light { color: rgba(255, 255, 255, 0.5); }
.brand-board-right { display: grid; grid-template-columns: repeat(5, 1fr); }
.colour-column { display: flex; flex-direction: column; justify-content: flex-end; padding: 1.25rem 1rem; min-height: 480px; }
.colour-info { display: flex; flex-direction: column; gap: 3px; }
.colour-name { font-family: 'Playfair Display', serif; font-size: 0.8125rem; font-weight: 700; line-height: 1.2; }
.colour-hex  { font-family: 'Open Sans', sans-serif; font-size: 0.75rem; font-weight: 600; opacity: 0.7; }
.colour-role { font-family: 'Open Sans', sans-serif; font-size: 0.6875rem; opacity: 0.5; margin-top: 2px; }
.colour-info.dark  .colour-name, .colour-info.dark  .colour-hex, .colour-info.dark  .colour-role { color: #1a1a1a; }
.colour-info.light .colour-name, .colour-info.light .colour-hex, .colour-info.light .colour-role { color: #ffffff; }

.type-strip { padding: 4rem 0; background: #f9f8f5; }
.type-grid { display: grid; grid-template-columns: 1fr 1px 1fr 1px 1.4fr; gap: 0; align-items: stretch; }
.type-divider { background: rgba(0, 0, 0, 0.06); width: 1px; }
.type-block { padding: 0 2.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
.type-block:first-child { padding-left: 0; }
.type-block:last-child  { padding-right: 0; }
.type-label { font-family: 'Open Sans', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #e9732a; }
.type-specimen-display { font-size: clamp(4rem, 8vw, 7rem); font-weight: 700; color: #1a1a1a; line-height: 0.9; }
.type-specimen-body { font-size: clamp(4rem, 8vw, 7rem); font-weight: 400; color: #1a1a1a; line-height: 0.9; }
.type-weights { display: flex; gap: 1.25rem; flex-wrap: wrap; }
.type-weights span { font-size: 0.875rem; color: #696969; }
.type-usage { font-family: 'Open Sans', sans-serif; font-size: 0.875rem; color: #696969; margin: 0; line-height: 1.6; max-width: 260px; }
.specimen-headline { font-size: clamp(1.375rem, 2.5vw, 1.875rem); font-weight: 700; color: #1a1a1a; line-height: 1.2; margin: 0 0 0.75rem; }
.specimen-body { font-family: 'Open Sans', sans-serif; font-size: 0.9375rem; color: #696969; line-height: 1.7; margin: 0; }

.brand-values-strip { background: #1a1a1a; padding: 2rem 0; }
.values-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
.value-pill { font-family: 'Open Sans', sans-serif; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.04em; padding: 6px 14px; border-radius: 9999px; border: 1px solid rgba(255, 255, 255, 0.2); color: rgba(255, 255, 255, 0.65); background: transparent; }
.value-pill.accent { border-color: rgba(233, 115, 42, 0.5); color: #e9732a; background: rgba(233, 115, 42, 0.08); }

.mockups-section { background: #1a1a1a; padding: 6rem 0; }
.mockups-section .section-label-block { margin-bottom: 4rem; }
.mockups-section .section-heading     { color: #ffffff; }
.mockups-section .section-subheading  { color: rgba(255, 255, 255, 0.5); }
.mockups-section .eyebrow             { color: #e9732a; }
.mockup-feature { margin-bottom: 3rem; }
.mockup-grid { display: grid; gap: 1.5rem; margin-bottom: 3rem; }
.mockup-grid--3col { grid-template-columns: repeat(3, 1fr); }
.mockup-frame { border-radius: 8px; overflow: hidden; background: #242424; }
.mockup-frame--card { background: none; border-radius: 0; overflow: hidden; }
.card-image { display: block; width: 100%; height: auto; }
.mockup-browser-bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1rem; background: #2e2e2e; }
.browser-dots { display: flex; gap: 5px; }
.browser-dots span { width: 10px; height: 10px; border-radius: 50%; background: rgba(255, 255, 255, 0.15); display: block; }
.browser-url { font-family: 'Open Sans', sans-serif; font-size: 0.75rem; color: rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.06); padding: 3px 12px; border-radius: 4px; flex: 1; max-width: 220px; }
.mockup-screen { position: relative; display: block; width: 100%; overflow: hidden; background: #f2ede6; aspect-ratio: 16 / 9; }
.mockup-screen > img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
.mockup-caption { margin-top: 0.875rem; font-family: 'Open Sans', sans-serif; font-size: 0.875rem; color: rgba(255, 255, 255, 0.72); text-align: center; }

.story-section { background: #f9f8f5; padding: 6rem 0 7rem; }
.story-container { display: grid; grid-template-columns: 180px 1fr; gap: 6rem; align-items: start; }
.story-sidenav { position: sticky; top: 5rem; display: flex; flex-direction: column; gap: 0.25rem; padding-top: 0.25rem; }
.cs-nav-link { font-family: 'Open Sans', sans-serif; font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none; color: #696969; padding: 0.5rem 0 0.5rem 1rem; border-left: 2px solid transparent; transition: color 0.2s, border-color 0.2s; }
.cs-nav-link:hover, .cs-nav-link.active { color: #1a1a1a; border-left-color: #e9732a; }
.story-body { display: flex; flex-direction: column; }
.story-chapter { padding: 4rem 0; }
.chapter-marker { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
.chapter-number { font-family: 'Open Sans', sans-serif; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; color: rgba(0, 0, 0, 0.18); }
.chapter-title { font-family: 'Open Sans', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #e9732a; }
.chapter-heading { font-family: 'Playfair Display', serif; font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 700; letter-spacing: -0.01em; color: #1a1a1a; line-height: 1.1; margin: 0 0 2rem; }
.chapter-content { display: flex; flex-direction: column; gap: 1.25rem; max-width: 640px; }
.chapter-content p { font-family: 'Open Sans', sans-serif; font-size: 1rem; color: #4a4a4a; line-height: 1.8; margin: 0; }
.approach-pillars { display: flex; flex-direction: column; border-radius: 4px; overflow: hidden; margin-top: 1rem; gap: 2px; }
.pillar { padding: 1.25rem 1.5rem; display: flex; flex-direction: column; gap: 0.375rem; background: #f0ece4; }
.pillar-label { font-family: 'Open Sans', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #e9732a; }
.pillar p { font-family: 'Open Sans', sans-serif; font-size: 0.9375rem; color: #696969; margin: 0; line-height: 1.6; }
.execution-deliverables { display: flex; flex-direction: column; gap: 1.75rem; margin-top: 1rem; }
.deliverable-row { display: grid; grid-template-columns: 24px 1fr; gap: 1.25rem; align-items: start; }
.deliverable-icon { font-family: 'Playfair Display', serif; font-size: 1.25rem; color: #e9732a; line-height: 1.4; margin-top: 2px; }
.deliverable-detail { display: flex; flex-direction: column; gap: 0.25rem; }
.deliverable-name { font-family: 'Open Sans', sans-serif; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #e9732a; }
.deliverable-heading { font-family: 'Playfair Display', serif; font-size: 1.125rem; font-weight: 700; color: #1a1a1a; line-height: 1.3; }
.deliverable-detail p { font-family: 'Open Sans', sans-serif; font-size: 0.9375rem; color: #696969; margin: 0.25rem 0 0; line-height: 1.6; }
.result-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid rgba(26, 26, 26, 0.08); }
.stat-card { display: flex; flex-direction: column; gap: 0.5rem; }
.stat-figure { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 700; color: #1a1a1a; letter-spacing: -0.02em; line-height: 1; }
.stat-desc { font-family: 'Open Sans', sans-serif; font-size: 0.875rem; color: #696969; line-height: 1.5; }
.story-quote { margin: 2.5rem 0 0; padding: 2rem 2.5rem; background: #1a1a1a; border-radius: 6px; }
