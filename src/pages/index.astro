---
import MainLayout from '../layouts/MainLayout.astro';

// ── Real project data (same source of truth as work.astro) ──────────────────
const projects = [
  {
    id: 1,
    client: "DAC's Transport Services",
    category: "Branding",
    year: "2024",
    description: "Logo design, brand identity, social media content, email campaigns, and a full website for a Cape Town-based transport company.",
    images: ["/images/2.webp", "/images/3.webp", "/images/4.webp", "/images/5.webp"],
    gradient: "linear-gradient(135deg, #1a1f5e 0%, #6b70b8 100%)",
    accentColor: "#6b70b8",
    tags: ["Logo Design", "Social Media", "Web Design"],
  },
  {
    id: 2,
    client: "Tendr Buddi",
    category: "Branding",
    year: "2024",
    description: "Full brand identity system — wordmark, figure mark, combination mark, business cards, and poster design for a tender-matching platform.",
    images: ["/images/10.webp","/images/11.webp","/images/12.webp","/images/13.webp","/images/14.webp","/images/15.webp","/images/16.webp","/images/17.webp","/images/18.webp","/images/19.webp","/images/20.webp","/images/21.webp","/images/22.webp","/images/23.webp","/images/24.webp","/images/25.webp","/images/26.webp","/images/27.webp","/images/28.webp","/images/29.webp"],
    gradient: "linear-gradient(135deg, #111111 0%, #3a2c00 100%)",
    accentColor: "#f5c400",
    tags: ["Brand Identity", "Print Design", "Guidelines"],
  },
  {
    id: 3,
    client: "WebNexo",
    category: "Web Design",
    year: "2024",
    description: "Logo, brand identity, colour system, typography guide, and full brand rollout across digital and physical touchpoints.",
    images: ["/images/34.webp","/images/35.webp","/images/36.webp","/images/37.webp","/images/38.webp","/images/39.webp","/images/40.webp"],
    gradient: "linear-gradient(135deg, #212121 0%, #005f6b 100%)",
    accentColor: "#00a5b5",
    tags: ["Web Design", "Brand Identity", "UI/UX"],
  },
  {
    id: 4,
    client: "Chemcrete",
    category: "Branding",
    year: "2024",
    description: "Gave a 35-year-old Cape Town concrete specialist a brand and digital presence that matched their industry standing.",
    images: ["/images/Chemcretelogo2.webp"],
    gradient: "linear-gradient(135deg, #1A1A2E 0%, #2F4858 100%)",
    accentColor: "#C8A951",
    tags: ["Web Design", "Branding", "Digital Marketing"],
    caseStudyUrl: "/work/chemcrete",
  },
  {
    id: 5,
    client: "Unexpected Opportunities",
    category: "NGO Digital Presence",
    year: "2025",
    description: "Developed a compassionate digital platform for a Cape Town NGO supporting families affected by aviation disasters, creating space for healing and advocacy.",
    images: ["/UnexpectedOpportunities/UPlogo.webp"],
    gradient: "linear-gradient(135deg, #1B4B6B 0%, #2C5F7E 100%)",
    accentColor: "#7FB3D5",
    tags: ["Web Design", "NGO Branding", "Digital Strategy"],
    caseStudyUrl: "/work/unexpected-opportunities",
  },
];

// ── Only show projects that have a case study ────────────────────────────────
const featuredWork = projects.filter((project) => project.caseStudyUrl);

const outcomes = [
  {
    number: '01',
    title: 'Be seen clearly',
    description:
      'We shape your message, visual identity, and digital presence so people understand what you do faster.',
    href: '/services'
  },
  {
    number: '02',
    title: 'Turn attention into action',
    description:
      'We create campaigns, landing pages, and content journeys that guide people toward enquiries, bookings, and sales.',
    href: '/work'
  },
  {
    number: '03',
    title: 'Build a digital presence that works',
    description:
      'We design websites and digital systems that look professional, load well, and support business growth.',
    href: '/services'
  },
  {
    number: '04',
    title: 'Create content people remember',
    description:
      'We help brands show up with visuals, copy, photography, video, and social content that feels intentional.',
    href: '/insights'
  }
];

const services = [
  {
    title: 'Brand & Strategy',
    description:
      'Positioning, messaging, campaign direction, and creative planning that gives your business a clear voice.',
    tags: ['Brand clarity', 'Messaging', 'Campaign direction'],
    href: '/services'
  },
  {
    title: 'Websites & Digital Systems',
    description:
      'Websites, landing pages, digital workflows, and technical support built around performance and usability.',
    tags: ['Web design', 'Development', 'Digital systems'],
    href: '/services'
  },
  {
    title: 'Marketing & Content',
    description:
      'Social media, creative content, copywriting, visuals, and campaigns that help your brand stay visible.',
    tags: ['Social media', 'Content', 'Creative direction'],
    href: '/services'
  }
];

const process = [
  {
    step: '01',
    title: 'Discover',
    description:
      'We understand your business, audience, current challenges, and where your digital presence needs to improve.'
  },
  {
    step: '02',
    title: 'Plan',
    description:
      'We map the strategy, structure, messaging, content direction, and technical requirements before we create.'
  },
  {
    step: '03',
    title: 'Create',
    description:
      'We design, build, write, edit, and refine the work with purpose, not guesswork.'
  },
  {
    step: '04',
    title: 'Launch & Improve',
    description:
      'We help you ship the work, review performance, and keep improving your brand presence over time.'
  }
];

const reasons = [
  'Small business focused',
  'Strategy before visuals',
  'Creative and technical team',
  'Clear communication',
  'Built for long-term growth',
  'Practical execution'
];
---

<MainLayout
  title="Plane View Collective | Marketing, Websites & Digital Strategy in Cape Town"
  description="Plane View Collective helps small businesses look clear, credible, and ready to grow through strategy, websites, content, marketing, and digital systems."
>
  <Fragment slot="head">
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "MarketingAgency",
        "name": "Plane View Collective",
        "url": "https://www.planeview.co.za",
        "logo": "https://www.planeview.co.za/logo/Pvc.png",
        "image": "https://www.planeview.co.za/logo/Pvc.png",
        "description": "Cape Town-based marketing, design, website, content, and digital strategy agency helping small businesses get noticed, understood, and remembered.",
        "telephone": "+27-83-966-9392",
        "email": "info@planeview.co.za",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Cape Town",
          "addressRegion": "Western Cape",
          "addressCountry": "ZA"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -33.9249,
          "longitude": 18.4241
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "08:00",
            "closes": "17:00"
          }
        ],
        "areaServed": {
          "@type": "City",
          "name": "Cape Town"
        },
        "sameAs": [
          "https://www.instagram.com/plane_view_collective?igsh=MWtrODJ6M2lsMGptOA%3D%3D&utm_source=qr",
          "https://www.linkedin.com/company/planeviewco/",
          "https://www.facebook.com/share/1AQg4ankHx/?mibextid=wwXIfr",
          "https://youtube.com/@planeviewcollective?si=nH-wXaomeGrJp3ZU"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Plane View Collective Services",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Brand Strategy"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Website Design and Development"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Digital Marketing and Content Creation"
              }
            }
          ]
        }
      }
    </script>
  </Fragment>

  <main>
    <!-- HERO -->
    <section class="home-hero section">
      <div class="container">
        <div class="home-hero-grid">
          <div class="home-hero-copy" data-reveal>
            <p class="eyebrow">Marketing • Websites • Content • Digital Systems</p>

            <h1>Helping small businesses look clear, credible, and ready to grow.</h1>

            <p class="hero-lead">
              Plane View Collective blends strategy, design, websites, content, and digital systems to help brands get noticed, understood, and remembered.
            </p>

            <div class="hero-actions">
              <a href="/contact" class="btn btn-primary btn-lg">
                Start a Project <span class="arrow">→</span>
              </a>
              <a href="/work" class="btn btn-secondary btn-lg">
                View Our Work
              </a>
            </div>
          </div>

          <div class="home-hero-panel" data-reveal>
            <div class="panel-header">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <div class="panel-body">
              <p class="panel-kicker">Plane View Method</p>
              <h2>Clarity before creativity.</h2>
              <p>
                We do not start with random designs. We start with what your audience needs to understand, feel, and do next.
              </p>

              <div class="panel-list">
                <div>
                  <strong>01</strong>
                  <span>Clear message</span>
                </div>
                <div>
                  <strong>02</strong>
                  <span>Strong visuals</span>
                </div>
                <div>
                  <strong>03</strong>
                  <span>Digital execution</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="trust-strip" aria-label="Plane View Collective capabilities">
      <div class="container">
        <div class="trust-strip-inner">
          <span>Strategy</span>
          <span>Websites</span>
          <span>Social Media</span>
          <span>Content</span>
          <span>IT Systems</span>
          <span>Cape Town Based</span>
        </div>
      </div>
    </section>

    <!-- OUTCOMES -->
    <section class="section outcomes-section">
      <div class="container">
        <div class="section-header" data-reveal>
          <p class="eyebrow">What we help you achieve</p>
          <h2>More than a nice-looking brand. A clearer way to grow.</h2>
          <p>
            Your business does not only need posts, logos, or a website. It needs a digital presence that makes sense to people and moves them closer to action.
          </p>
        </div>

        <div class="outcome-grid">
          {outcomes.map((item) => (
            <a href={item.href} class="outcome-card" data-reveal>
              <span class="card-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="card-link">Explore <span class="arrow">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="section section-surface">
      <div class="container">
        <div class="split-header" data-reveal>
          <div>
            <p class="eyebrow">Our services</p>
            <h2>Strategy, creative, and technical execution under one roof.</h2>
          </div>
          <p>
            We support growing businesses with the tools they need to look professional, communicate clearly, and show up consistently.
          </p>
        </div>

        <div class="service-grid">
          {services.map((service) => (
           <a href={service.href} class="service-card spotlight-card" data-reveal>
              <h3>{service.title}</h3>
              <p>{service.description}</p>

              <div class="tag-list">
                {service.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURED WORK -->
    <section class="section">
      <div class="container">
        <div class="section-header" data-reveal>
          <p class="eyebrow">Featured Work</p>
          <h2>Projects we are proud of.</h2>
        </div>

        <div class="featured-grid">
          {featuredWork.map((project) => (
            <a href={project.caseStudyUrl} class="featured-card spotlight-card" data-reveal>
              <div class="featured-visual">
                <img
                  src={project.images?.[0] || "/logo/Pvc.png"}
                  alt={`${project.client} logo`}
                  loading="lazy"
                />
              </div>

              <div class="featured-content">
                <p class="project-category">{project.category}</p>
                <h3>{project.client}</h3>
                <p>{project.description}</p>
                <span class="card-link">
                  Read case study <span class="arrow">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="section high-contrast process-section">
      <div class="container">
        <div class="section-header" data-reveal>
          <p class="eyebrow">How we work</p>
          <h2>Simple process. Clear direction. Strong execution.</h2>
          <p>
            We keep the process practical so you know what is happening, why it matters, and what comes next.
          </p>
        </div>

        <div class="process-grid">
          {process.map((item) => (
            <div class="process-step  spotlight-card">
              <span>{item.step}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WHY US -->
    <section class="section why-section">
      <div class="container">
        <div class="why-grid">
          <div class="why-copy" data-reveal>
            <p class="eyebrow">Why Plane View?</p>
            <h2>Built for small businesses that need both creativity and structure.</h2>
            <p>
              We understand that growing businesses need more than isolated services. They need practical support across brand, marketing, design, websites, and digital systems.
            </p>
            <a href="/about" class="btn btn-secondary">Learn about us</a>
          </div>

          <div class="reason-list" data-reveal>
            {reasons.map((reason) => (
              <div class="reason-item spotlight-card">
                <span>✓</span>
                <p>{reason}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- INSIGHTS / RESOURCES -->
    <section class="section section-surface">
      <div class="container">
        <div class="split-header " data-reveal>
          <div>
            <p class="eyebrow">Explore more</p>
            <h2>See how we think, work, and price our services.</h2>
          </div>
          <p>
            Learn more about the collective, view our work, or explore our pricing before starting a project.
          </p>
        </div>

        <div class="resource-grid">
          <a href="/about" class="resource-card  spotlight-card" data-reveal>
            <h3>About Us</h3>
            <p>Learn how we think, collaborate, and approach digital growth.</p>
            <span class="card-link">Read more <span class="arrow">→</span></span>
          </a>

          <a href="/pricing" class="resource-card  spotlight-card" data-reveal>
            <h3>Pricing</h3>
            <p>Explore simple pricing structures for websites, strategy, and marketing support.</p>
            <span class="card-link">View pricing <span class="arrow">→</span></span>
          </a>

          <a href="/insights" class="resource-card  spotlight-card" data-reveal>
            <h3>Insights</h3>
            <p>Read ideas, campaigns, and content lessons from the Plane View perspective.</p>
            <span class="card-link">Explore insights <span class="arrow">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="section final-cta-section">
      <div class="container">
        <div class="final-cta" data-reveal>
          <p class="eyebrow">Ready when you are</p>
          <h2>Let's build a clearer digital presence for your business.</h2>
          <p>
            Tell us what you are working on and we will help you map the next step.
          </p>

          <div class="cta-actions">
            <a href="/contact" class="btn btn-primary btn-lg">
              Start a Project <span class="arrow">→</span>
            </a>
            <a href="/pricing" class="btn btn-outline btn-lg">
              View Pricing
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  /* =============================================
     SHARED HOME PAGE STYLES
     ============================================= */

  .section-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto var(--spacing-2xl);
  }

  .section-header p {
    margin-left: auto;
    margin-right: auto;
    color: var(--text-secondary);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--spacing-sm);
    color: var(--color-steel-blue);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    max-width: 100%;
  }

  .eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--color-steel-blue);
    border-radius: var(--radius-full);
  }

  .split-header {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.7fr);
    gap: var(--spacing-2xl);
    align-items: end;
    margin-bottom: var(--spacing-2xl);
  }

  .split-header h2 {
    margin-bottom: 0;
  }

  .split-header > p {
    color: var(--text-secondary);
    margin: 0;
    max-width: 100%;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    color: var(--color-steel-blue);
    font-weight: 600;
  }

  /* =============================================
     HERO
     ============================================= */

  .home-hero {
    position: relative;
    overflow: hidden;
    padding-top: calc(var(--spacing-3xl) + 1rem);
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 10% auto auto -10%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(47, 111, 237, 0.22), transparent 65%);
    pointer-events: none;
  }

  .home-hero::after {
    content: '';
    position: absolute;
    inset: auto -12% 5% auto;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(255, 106, 0, 0.16), transparent 68%);
    pointer-events: none;
  }

  .home-hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.75fr);
    gap: var(--spacing-3xl);
    align-items: center;
  }

  .home-hero-copy h1 {
    max-width: 900px;
    margin-bottom: var(--spacing-lg);
  }

  .hero-lead {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 720px;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacing-md);
    flex-wrap: wrap;
    margin-top: var(--spacing-xl);
  }

  .home-hero-panel {
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    background:
      linear-gradient(145deg, rgba(47, 111, 237, 0.13), transparent 45%),
      var(--bg-card);
    box-shadow: var(--shadow-lift);
  }

  .panel-header {
    display: flex;
    gap: 8px;
    padding: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-hover);
  }

  .panel-header span {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
    background: var(--border-strong);
  }

  .panel-body {
    padding: var(--spacing-xl);
  }

  .panel-kicker {
    color: var(--color-signal-orange);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-sm);
  }

  .panel-body h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .panel-body p {
    color: var(--text-secondary);
  }

  .panel-list {
    display: grid;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-xl);
  }

  .panel-list div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--surface-hover);
  }

  .panel-list strong {
    color: var(--color-steel-blue);
  }

  .panel-list span {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* =============================================
     TRUST STRIP
     ============================================= */

  .trust-strip {
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
  }

  .trust-strip-inner {
    display: flex;
    justify-content: center;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
    padding: var(--spacing-md) 0;
  }

  .trust-strip-inner span {
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* =============================================
     OUTCOMES
     ============================================= */

  .outcome-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .outcome-card,
  .service-card,
  .featured-card,
  .resource-card {
    color: inherit;
    text-decoration: none;
  }

  .outcome-card {
    min-height: 310px;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-lg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .outcome-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-medium);
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-card);
  }

  .card-number {
    color: var(--color-signal-orange);
    font-weight: 800;
    margin-bottom: var(--spacing-xl);
  }

  .outcome-card h3 {
    font-size: 1.35rem;
  }

  .outcome-card p {
    color: var(--text-secondary);
    max-width: 100%;
  }

  /* =============================================
     SERVICES
     ============================================= */

  .section-surface {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .service-card {
    display: flex;
    flex-direction: column;
    min-height: 320px;
    padding: var(--spacing-xl);
    border: 1px solid var(--border-subtle);
    border-radius: 24px;
    background: var(--bg-card);
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base),
